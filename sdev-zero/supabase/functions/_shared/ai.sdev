use "lang/stdlib/v2/text.sdev"

to module_info
  return {
    original_path: "supabase/functions/_shared/ai.ts",
    sdev_path: "supabase/functions/_shared/ai.sdev",
    subsystem: "edge-function",
    original_lines: 65,
    exports_count: 14
  }
end

to module_exports
  return ["env", "usingOwnProvider", "legacyKey", "aiKey", "aiUrl", "aiHeaders", "aiModel", "LEGACY_BASE", "base", "key", "headers", "tiered", "AI_NOT_CONFIGURED", "make_AiTier"]
end

to env with name
