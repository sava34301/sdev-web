    subsystem: "edge-function",
    original_lines: 20,
    exports_count: 2
  }
end

to module_exports
  return ["TEMPLATES", "make_TemplateEntry"]
end

to TEMPLATES
  return "TEMPLATES"
end

to make_TemplateEntry with payload
  return {
    status: 200,
    handler: "make_TemplateEntry",
