# =============================================================================
# SDEV Self-Hosted Web Toolkit: HTML5 & SVG Document Builder (lang/web/html.sdev)
# Authored in 100% pure SDEV — compiled by the self-hosted SDEV compiler.
# =============================================================================

use "lang/stdlib/v2/text.sdev"
use "lang/web/icons.sdev"
use "lang/web/themes.sdev"
use "lang/web/transpiler.sdev"
use "lang/web/css.sdev"

# _web_doc slots:
# 0: active ("1" or "0")
# 1: title
# 2: lang
# 3: desc
# 4: favicon
# 5: theme
# 6: head
# 7: css
# 8: body
# 9: js
# 10: state_entries
set _web_doc to mklist(16)
set _web_doc[0] to "0"
set _web_doc[1] to "sdev App"
set _web_doc[2] to "en"
set _web_doc[3] to ""
set _web_doc[4] to "/favicon.png"
set _web_doc[5] to "sdev-dark"
set _web_doc[6] to ""
set _web_doc[7] to ""
set _web_doc[8] to ""
set _web_doc[9] to ""
set _web_doc[10] to ""

to web_escape_html with s
  set raw_s to concat(s, "")
  if find(raw_s, chr(1)) >= 0
    set out_mix to replace(raw_s, chr(1), "")
    set out_mix to replace(out_mix, chr(2), "")
    return concat(out_mix, "")
  end
  set out to replace(raw_s, "&", "&amp;")
  set out to replace(out, "<", "&lt;")
  set out to replace(out, ">", "&gt;")
  set out to replace(out, "\"", "&quot;")
  return concat(out, "")
end

to web_escape_attr with s
  set raw_s to concat(s, "")
  set out to replace(raw_s, "&", "&amp;")
  set out to replace(out, "\"", "&quot;")
  set out to replace(out, "<", "&lt;")
  set out to replace(out, ">", "&gt;")
  return concat(out, "")
end

to raw with html_str
  return chr(1) + html_str + chr(2)
end

to web_tome_get_str with t key fallback
  set ks to keys(t)
  set vs to values(t)
  set n to length(ks)
  set i to 0
  while i < n
    if str_eq(ks[i], key)
      return concat(vs[i], "")
    end
    set i to i + 1
  end
  return concat(fallback, "")
end

to web_attrs_from_tome with attrs_tome
  set ks to keys(attrs_tome)
  set vs to values(attrs_tome)
  set n to length(ks)
  set out to ""
  set i to 0
  while i < n
    set k to concat(ks[i], "")
    set v to concat(vs[i], "")
    if str_eq(k, "bind")
      set out to out + " data-bind-value=\"" + web_escape_attr(v) + "\""
    else
      if str_eq(k, "bind_text")
        set out to out + " data-bind-text=\"" + web_escape_attr(v) + "\""
      else
        if str_eq(k, "bind_html")
          set out to out + " data-bind-html=\"" + web_escape_attr(v) + "\""
        else
          if str_eq(k, "bind_show")
            set out to out + " data-bind-show=\"" + web_escape_attr(v) + "\""
          else
            if str_eq(v, "false") or length(v) is 0
              if text_starts_with(k, "aria-") or text_starts_with(k, "data-")
                set out to out + " " + k + "=\"" + web_escape_attr(v) + "\""
              end
            else
              if str_eq(v, "true") and (str_eq(k, "disabled") or str_eq(k, "checked") or str_eq(k, "required") or str_eq(k, "selected") or str_eq(k, "readonly") or str_eq(k, "multiple") or str_eq(k, "open") or str_eq(k, "controls") or str_eq(k, "autoplay") or str_eq(k, "loop") or str_eq(k, "muted"))
                set out to out + " " + k
              else
                set out to out + " " + k + "=\"" + web_escape_attr(v) + "\""
              end
            end
          end
        end
      end
    end
    set i to i + 1
  end
  return concat(out, "")
end

to web_el with tag_name content attrs_tome
  set a_str to web_attrs_from_tome(attrs_tome)
  set inner to web_escape_html(content)
  set html to "<" + tag_name + a_str + ">" + inner + "</" + tag_name + ">"
  return raw(html)
end

to web_el_raw with tag_name inner_html attrs_tome
  set a_str to web_attrs_from_tome(attrs_tome)
  set clean_inner to replace(replace(inner_html, chr(1), ""), chr(2), "")
  set html to "<" + tag_name + a_str + ">" + clean_inner + "</" + tag_name + ">"
  return raw(html)
end

to web_void_el with tag_name attrs_tome
  set a_str to web_attrs_from_tome(attrs_tome)
  return raw("<" + tag_name + a_str + ">")
end

to web_parse_tag_spec with spec
  set clean to trim(spec)
  set tname to "div"
  set id_val to ""
  set cls_val to ""
  set n to length(clean)
  set i to 0
  set mode to 0
  set cur to ""
  while i <= n
    set c to 0
    if i < n
      set c to ord(clean, i)
    end
    if i is n or c is 46 or c is 35
      if length(cur) > 0
        if mode is 0
          set tname to cur
        else
          if mode is 1
            if length(cls_val) > 0
              set cls_val to cls_val + " " + cur
            else
              set cls_val to cur
            end
          else
            set id_val to cur
          end
        end
      end
      set cur to ""
      if c is 46
        set mode to 1
      end
      if c is 35
        set mode to 2
      end
    else
      set cur to cur + chr(c)
    end
    set i to i + 1
  end
  if length(tname) is 0
    set tname to "div"
  end
  return [tname, id_val, cls_val]
end

to web_tag_emmet with spec content attrs_tome
  set parsed to web_parse_tag_spec(spec)
  set tname to concat(parsed[0], "")
  set id_val to concat(parsed[1], "")
  set cls_val to concat(parsed[2], "")
  set a_str to web_attrs_from_tome(attrs_tome)
  set extra_a to ""
  if length(id_val) > 0
    set extra_a to extra_a + " id=\"" + web_escape_attr(id_val) + "\""
  end
  if length(cls_val) > 0
    set extra_a to extra_a + " class=\"" + web_escape_attr(cls_val) + "\""
  end
  set inner to web_escape_html(content)
  return raw("<" + tname + extra_a + a_str + ">" + inner + "</" + tname + ">")
end

# ── Stateful Document Operations ─────────────────────────────────────────────

to page with title_str
  set _web_doc[0] to "1"
  set _web_doc[1] to concat(title_str, "")
  set _web_doc[2] to "en"
  set _web_doc[3] to ""
  set _web_doc[4] to "/favicon.png"
  set _web_doc[5] to "sdev-dark"
  set _web_doc[6] to ""
  set _web_doc[7] to ""
  set _web_doc[8] to ""
  set _web_doc[9] to ""
  set _web_doc[10] to ""
  return 0
end

to web_meta with desc_str favicon_href
  set _web_doc[3] to concat(desc_str, "")
  if length(favicon_href) > 0
    set _web_doc[4] to concat(favicon_href, "")
  end
  return 0
end

to theme with theme_name
  set _web_doc[5] to concat(theme_name, "")
  return 0
end

to web_emit with html_frag
  set clean to replace(replace(html_frag, chr(1), ""), chr(2), "")
  set cur to concat(_web_doc[8], "")
  set _web_doc[8] to cur + clean + "\n"
  return 0
end

to raw_html with html_str
  return web_emit(html_str)
end

to web_add_css with rule_str
  set cur to concat(_web_doc[7], "")
  if length(cur) > 0
    set _web_doc[7] to cur + "\n" + rule_str
  else
    set _web_doc[7] to concat(rule_str, "")
  end
  return 0
end

to web_add_js with js_str
  set cur to concat(_web_doc[9], "")
  if length(cur) > 0
    set _web_doc[9] to cur + "\n" + js_str
  else
    set _web_doc[9] to concat(js_str, "")
  end
  return 0
end

to style with selector style_tome
  return web_add_css(web_style_rule(selector, style_tome))
end

to style_nested with parent_sel child_sel style_tome
  return web_add_css(web_nested_rule(parent_sel, child_sel, style_tome))
end

to media_style with bp selector style_tome
  return web_add_css(web_media_rule(bp, web_style_rule(selector, style_tome)))
end

to keyframes with name from_tome to_tome
  return web_add_css(web_keyframes_rule(name, from_tome, to_tome))
end

to css_vars with vars_tome
  return web_add_css(web_css_vars_rule(vars_tome))
end

to css_var with name fallback
  return web_css_var(name, fallback)
end

to script_raw with js_code
  return web_add_js(js_code)
end

to script_sdev with sdev_code
  return web_add_js(sdev_to_js(sdev_code))
end

to client_fn with name params sdev_body
  return web_add_js(web_client_fn_js(name, params, sdev_body))
end

to on_ready with sdev_body
  return web_add_js(web_on_ready_js(sdev_body))
end

to web_state_init with key val_json
  set entry to "\"" + key + "\": " + val_json
  set cur to concat(_web_doc[10], "")
  if length(cur) > 0
    set _web_doc[10] to cur + ", " + entry
  else
    set _web_doc[10] to entry
  end
  return 0
end

# ── Open / Close Structural Tags ─────────────────────────────────────────────

to open_tag with tag_name attrs_tome
  set a_str to web_attrs_from_tome(attrs_tome)
  return web_emit("<" + tag_name + a_str + ">")
end

to close_tag with tag_name
  return web_emit("</" + tag_name + ">")
end

to open_main with attrs_tome
  return open_tag("main", attrs_tome)
end
to end_main
  return close_tag("main")
end

to open_header with attrs_tome
  return open_tag("header", attrs_tome)
end
to end_header
  return close_tag("header")
end

to open_footer with attrs_tome
