to label_el with text for_id attrs_tome
  set a_str to web_attrs_from_tome(attrs_tome)
  set fa to ""
  if length(for_id) > 0
    set fa to " for=\"" + web_escape_attr(for_id) + "\""
  end
  set f to raw("<label" + fa + a_str + ">" + web_escape_html(text) + "</label>")
  set _ to web_emit(f)
  return f
end

to option_el with text val selected_flag
  set sel to ""
  if selected_flag is 1
    set sel to " selected"
  end
  set f to raw("<option value=\"" + web_escape_attr(val) + "\"" + sel + ">" + web_escape_html(text) + "</option>")
  set _ to web_emit(f)
  return f
end

to li_html with text attrs_tome
  return web_el("li", text, attrs_tome)
end

to li_el with text attrs_tome
  set f to web_el("li", text, attrs_tome)
  set _ to web_emit(f)
  return f
end

to ul_list with items_list attrs_tome
  set n to length(items_list)
  set inner to ""
  set i to 0
  while i < n
    set item to concat(items_list[i], "")
    set item_clean to replace(replace(item, chr(1), ""), chr(2), "")
    if text_starts_with(trim(item_clean), "<li")
      set inner to inner + item_clean
    else
      set inner to inner + "<li>" + web_escape_html(item) + "</li>"
    end
    set i to i + 1
  end
  set f to web_el_raw("ul", inner, attrs_tome)
  set _ to web_emit(f)
  return f
end

to ol_list with items_list attrs_tome
  set n to length(items_list)
  set inner to ""
  set i to 0
  while i < n
    set item to concat(items_list[i], "")
    set item_clean to replace(replace(item, chr(1), ""), chr(2), "")
    if text_starts_with(trim(item_clean), "<li")
      set inner to inner + item_clean
    else
      set inner to inner + "<li>" + web_escape_html(item) + "</li>"
    end
    set i to i + 1
  end
  set f to web_el_raw("ol", inner, attrs_tome)
  set _ to web_emit(f)
  return f
end

to hr_el
  set f to raw("<hr>")
  set _ to web_emit(f)
  return f
end

to br_el
  return raw("<br>")
end

to inline_icon with name cls
  return raw(web_icon_svg(name, cls))
end

to icon with name cls
  set svg to web_icon_svg(name, cls)
  set _ to web_emit(svg)
  return raw(svg)
end

to render_html
  set theme_css to web_theme_css(concat(_web_doc[5], ""))
  set util_css to web_utilities_css()
  set custom_css to concat(_web_doc[7], "")
  set runtime_js to web_browser_runtime_js()
  set state_init_js to ""
  set st_entries to concat(_web_doc[10], "")
  if length(st_entries) > 0
    set state_init_js to "\nwindow.$sdev.initState({ " + st_entries + " });"
  end
  set custom_js to concat(_web_doc[9], "")
  set desc_meta to ""
  set d_str to concat(_web_doc[3], "")
  if length(d_str) > 0
    set desc_meta to "\n  <meta name=\"description\" content=\"" + web_escape_attr(d_str) + "\">"
  end
  set fav_link to ""
  set fav_str to concat(_web_doc[4], "")
  if length(fav_str) > 0
    set fav_link to "\n  <link rel=\"icon\" href=\"" + web_escape_attr(fav_str) + "\">"
  end
  set doc to "<!DOCTYPE html>\n<html lang=\"" + concat(_web_doc[2], "") + "\" class=\"dark\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>" + web_escape_html(concat(_web_doc[1], "")) + "</title>" + desc_meta + fav_link + concat(_web_doc[6], "") + "\n  <style>\n" + theme_css + "\n" + util_css + "\n" + custom_css + "\n  </style>\n</head>\n<body>\n" + concat(_web_doc[8], "") + "  <script>\n" + runtime_js + state_init_js + "\n" + custom_js + "\n  </script>\n</body>\n</html>"
  return concat(doc, "")
end

to save_html with path
  set html to render_html()
  set _ to write_file(path, html)
  return html
end

to endpage
  return render_html()
end
