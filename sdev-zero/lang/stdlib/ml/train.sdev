// ============================================================
// sdev ML Stdlib — Language-Model Training (Milestone 14 + M15)
// ============================================================
// End-to-end training for the decoder-only model in transformer.sdev:
// batching, next-token cross-entropy, Adam + gradient clipping,
// temperature / top-k sampling, text/JSON & binary ("SDEVML01")
// checkpoint save + load, and an evaluation loop. Written entirely
// in sdev.

link "transformer.sdev"
link "data.sdev"

// ---------- batching ----------
// Cut a flat token stream into (context, next-token) pairs of length `block`.
conjure lm_batches(ids, block) ::
    forge xs be gather()
    forge ys be gather()
    forge i be 0
    cycle i + block < measure(ids) ::
        forge ctx be gather()
        forge tgt be gather()
        forge k be 0
        cycle k < block ::
            pluck(ctx, ids[i + k])
            pluck(tgt, ids[i + k + 1])
            be k be k + 1
        ;;
        pluck(xs, ctx)
        pluck(ys, tgt)
        be i be i + 1
    ;;
    yield { xs: xs, ys: ys, block: block, count: measure(xs) }
;;

// ---------- one optimisation step ----------
conjure lm_step(model, opt, ctx, targets, lr) ::
    tape_reset()
    zero_grads(model.params)
    forge logits be model.forward(tensor(ctx, [measure(ctx)]))
    forge loss be d_softmax_ce(logits, targets)
    backward(loss)
    clip_grads(model.params, 1.0)
    adam_step(opt, model.params, lr)
    yield loss.data[0]
;;

// ---------- full training loop ----------
conjure lm_fit(model, ids, block, epochs, lr) ::
    forge batches be lm_batches(ids, block)
    forge opt be adam_new(model.params)
    forge history be gather()
    forge e be 0
    cycle e < epochs ::
        forge total be 0.0
        forge i be 0
        cycle i < batches.count ::
            be total be total + lm_step(model, opt, batches.xs[i], batches.ys[i], lr)
            be i be i + 1
        ;;
        pluck(history, total / batches.count)
        be e be e + 1
    ;;
    yield { history: history, final: history[measure(history) - 1], opt: opt }
;;

// ---------- evaluation ----------
conjure lm_loss(model, ids, block) ::
    forge batches be lm_batches(ids, block)
    forge total be 0.0
    forge i be 0
    cycle i < batches.count ::
        tape_reset()
        forge logits be model.forward(tensor(batches.xs[i], [block]))
        be total be total + d_softmax_ce(logits, batches.ys[i]).data[0]
        be i be i + 1
    ;;
    yield total / batches.count
;;

// Perplexity = e^(mean NLL). Lower is better.
conjure perplexity(model, ids, block) ::
    yield exp(lm_loss(model, ids, block))
;;

// ---------- sampling ----------
conjure last_logits(model, ids) ::
    forge logits be model.forward(tensor(ids, [measure(ids)]))
    forge vocab be logits.shape[1]
    forge rows be logits.shape[0]
    forge row be gather()
    forge c be 0
    cycle c < vocab ::
        pluck(row, logits.data[(rows - 1) * vocab + c])
        be c be c + 1
    ;;
    yield tensor(row, [vocab])
;;

// Temperature + top-k filtering, then multinomial draw.
conjure sample_topk(logits, temperature, k) ::
    forge n be measure(logits.data)
    forge scaled be gather()
    forge i be 0
    cycle i < n ::
        pluck(scaled, logits.data[i] / (temperature + 0.000001))
        be i be i + 1
    ;;
    // find the k-th largest value as the cutoff
    forge sorted be gather()
    be i be 0
    cycle i < n :: pluck(sorted, scaled[i]) be i be i + 1 ;;
    forge a be 0
    cycle a < n ::
        forge b be a + 1
        cycle b < n ::
            either sorted[b] > sorted[a] ::
                forge tmp be sorted[a]
                set sorted[a] to sorted[b]
                set sorted[b] to tmp
            ;;
            be b be b + 1
        ;;
        be a be a + 1
    ;;
    forge limit be k
    either limit > n :: be limit be n ;;
    forge cutoff be sorted[limit - 1]
    be i be 0
    cycle i < n ::
        either scaled[i] < cutoff :: set scaled[i] to -1000000.0 ;;
        be i be i + 1
    ;;
    yield sample_next(tensor(scaled, [n]))
;;

conjure lm_generate(model, prompt_ids, max_new, temperature, k) ::
    forge out be gather()
    forge i be 0
    cycle i < measure(prompt_ids) :: pluck(out, prompt_ids[i]) be i be i + 1 ;;
    forge s be 0
    cycle s < max_new ::
        forge tok be sample_topk(last_logits(model, out), temperature, k)
        pluck(out, 1.0 * tok)
        be s be s + 1
    ;;
    yield out
;;

conjure lm_complete(model, vocab, prompt, max_new, temperature, k) ::
    forge ids be encode(vocab, prompt)
    yield decode(vocab, lm_generate(model, ids, max_new, temperature, k))
;;

// ---------- checkpoints (text) ----------
// Flat text format: one parameter tensor per line, "shape|values".
conjure checkpoint_text(model) ::
    forge s be ""
    forge i be 0
    cycle i < measure(model.params) ::
        forge p be model.params[i]
        forge line be ""
        forge j be 0
        cycle j < measure(p.shape) ::
            either j > 0 :: be line be line + "," ;;
            be line be line + str(p.shape[j])
            be j be j + 1
        ;;
        be line be line + "|"
        be j be 0
        cycle j < measure(p.data) ::
            either j > 0 :: be line be line + "," ;;
            be line be line + str(p.data[j])
            be j be j + 1
        ;;
        be s be s + line + "\n"
        be i be i + 1
    ;;
    yield s
;;

conjure save_checkpoint(path, model) ::
    write_file(path, checkpoint_text(model))
    yield measure(model.params)
;;

// Loads weights back into an identically-shaped model.
conjure load_checkpoint(path, model) ::
    forge text be read_file(path)
    forge lines be split_text(text, "\n")
    forge i be 0
    cycle i < measure(model.params) ::
        either i < measure(lines) ::
            forge parts be split_text(lines[i], "|")
            either measure(parts) equals 2 ::
                forge nums be split_text(parts[1], ",")
                forge p be model.params[i]
                forge j be 0
                cycle j < measure(p.data) ::
                    either j < measure(nums) ::
                        set p.data[j] to morph(nums[j], "number")
                    ;;
                    be j be j + 1
                ;;
            ;;
        ;;
        be i be i + 1
    ;;
    yield measure(model.params)
;;

// ---------- binary checkpoints (M15: "SDEVML01") ----------
// Compact IEEE-754 binary64 hex-framed checkpoint format with magic
// header "SDEVML01", version, step, loss, and flat parameter tensors.

forge CKPT_MAGIC be "SDEVML01"
forge CKPT_VERSION be 1
forge CKPT_HEX_DIGITS be "0123456789abcdef"
forge CKPT_SCRATCH_BUF be void

conjure ckpt_buf() ::
    either CKPT_SCRATCH_BUF equals void ::
        be CKPT_SCRATCH_BUF be ffi_buf(8)
    ;;
    yield CKPT_SCRATCH_BUF
;;

conjure u32_to_hex8(n) ::
    forge out be ""
    forge i be 0
    cycle i < 8 ::
        forge nib be bitAnd(bitShiftRight(n, i * 4), 15)
        be out be out + chr(ord(CKPT_HEX_DIGITS, nib))
        be i be i + 1
    ;;
    yield out
;;

conjure hex_nibble(code) ::
    either code >= 48 ::
        either code <= 57 :: yield code - 48 ;;
    ;;
    either code >= 97 ::
        either code <= 102 :: yield code - 87 ;;
    ;;
    either code >= 65 ::
        either code <= 70 :: yield code - 55 ;;
    ;;
    yield 0
;;

conjure hex8_to_u32(s, offset) ::
    forge acc be 0
    forge i be 0
    cycle i < 8 ::
        forge nib be hex_nibble(ord(s, offset + i))
        be acc be bitOr(acc, bitShiftLeft(nib, i * 4))
        be i be i + 1
    ;;
    yield acc
;;

conjure f64_to_hex(x) ::
    forge b be ckpt_buf()
    ffi_write_f64(b, 0, 1.0 * x)
    forge lo be ffi_read_i32(b, 0)
    forge hi be ffi_read_i32(b, 1)
    yield u32_to_hex8(lo) + u32_to_hex8(hi)
;;

conjure hex_to_f64(s, offset) ::
    forge b be ckpt_buf()
    forge lo be hex8_to_u32(s, offset)
    forge hi be hex8_to_u32(s, offset + 8)
    ffi_write_i32(b, 0, lo)
    ffi_write_i32(b, 1, hi)
    yield ffi_read_f64(b, 0)
;;

conjure checkpoint_bin_encode(model, step be 0, loss be 0.0) ::
    forge s be CKPT_MAGIC + "\n"
    be s be s + str(CKPT_VERSION) + "|" + str(step) + "|" + f64_to_hex(loss) + "|" + str(measure(model.params)) + "\n"
    forge i be 0
    cycle i < measure(model.params) ::
        forge p be model.params[i]
        forge line be ""
        forge j be 0
        cycle j < measure(p.shape) ::
            either j > 0 :: be line be line + "," ;;
            be line be line + str(p.shape[j])
            be j be j + 1
        ;;
        be line be line + "|"
        be j be 0
        cycle j < measure(p.data) ::
            be line be line + f64_to_hex(p.data[j])
            be j be j + 1
        ;;
        be s be s + line + "\n"
        be i be i + 1
    ;;
    yield s
;;

conjure save_checkpoint_bin(path, model, step be 0, loss be 0.0) ::
    forge payload be checkpoint_bin_encode(model, step, loss)
    write_file(path, payload)
    yield {
        ok: yep,
        magic: CKPT_MAGIC,
        version: CKPT_VERSION,
        step: step,
        loss: loss,
        params: measure(model.params),
        bytes: measure(payload)
    }
;;

conjure load_checkpoint_bin(path, model) ::
    forge raw be read_file(path)
    forge rows be split_text(raw, "\n")
    either measure(rows) < 2 ::
        yield { ok: nope, err: "truncated binary checkpoint", magic: "", version: 0, step: 0, loss: 0.0, params: 0 }
    ;;
    either rows[0] differs CKPT_MAGIC ::
        yield { ok: nope, err: "invalid checkpoint magic", magic: rows[0], version: 0, step: 0, loss: 0.0, params: 0 }
    ;;
    forge meta be split_text(rows[1], "|")
    forge ver be morph(meta[0], "number")
    forge step be morph(meta[1], "number")
    forge loss be hex_to_f64(meta[2], 0)
    forge i be 0
    cycle i < measure(model.params) ::
        forge row_idx be 2 + i
        either row_idx < measure(rows) ::
            forge parts be split_text(rows[row_idx], "|")
            either measure(parts) equals 2 ::
                forge hex_blob be parts[1]
                forge p be model.params[i]
                forge j be 0
                cycle j < measure(p.data) ::
                    forge off be j * 16
                    either off + 16 <= measure(hex_blob) ::
                        set p.data[j] to hex_to_f64(hex_blob, off)
                    ;;
                    be j be j + 1
                ;;
            ;;
        ;;
        be i be i + 1
    ;;
    yield {
        ok: yep,
        magic: CKPT_MAGIC,
        version: ver,
        step: step,
        loss: loss,
        params: measure(model.params)
    }
;;

// Small split helper so checkpoints need no host support beyond file I/O.
conjure split_text(s, sep) ::
    forge out be gather()
    forge cur be ""
    forge sepc be ord(sep, 0)
    forge i be 0
    cycle i < measure(s) ::
        forge c be ord(s, i)
        either c equals sepc ::
            pluck(out, cur)
            be cur be ""
        ;; otherwise ::
            be cur be cur + chr(c)
        ;;
        be i be i + 1
    ;;
    pluck(out, cur)
    yield out
;;
