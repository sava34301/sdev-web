# SDEV Linux x86-64 Runtime Generator — authored in SDEV.
#
# Generates the System V AMD64 assembly routines for startup, string output,
# integer decimal printing, heap allocation, and Linux syscall wrappers
# (sys_write, sys_read, sys_open, sys_exit) in pure SDEV.

to x64_generate_runtime_asm
  set asm to "# SDEV System V AMD64 Runtime\n"
  set asm to asm + ".text\n"
  set asm to asm + ".globl _start\n"
  set asm to asm + "_start:\n"
  set asm to asm + "    movq (%rsp), %rdi\n"
  set asm to asm + "    leaq 8(%rsp), %rsi\n"
  set asm to asm + "    call sdev_main\n"
  set asm to asm + "    movq %rax, %rdi\n"
  set asm to asm + "    movq $60, %rax\n"
  set asm to asm + "    syscall\n\n"
  set asm to asm + "# sdev_say_int: prints 64-bit integer in %rdi followed by newline\n"
  set asm to asm + ".globl sdev_say_int\n"
  set asm to asm + "sdev_say_int:\n"
  set asm to asm + "    pushq %rbp\n"
  set asm to asm + "    movq %rsp, %rbp\n"
  set asm to asm + "    subq $32, %rsp\n"
  set asm to asm + "    movb $10, -1(%rbp)\n"
  set asm to asm + "    movq $1, %r8\n"
  set asm to asm + "    movq %rdi, %rax\n"
  set asm to asm + "    movq %rdi, %r9\n"
  set asm to asm + "    testq %rax, %rax\n"
  set asm to asm + "    jns .Lpos\n"
  set asm to asm + "    negq %rax\n"
  set asm to asm + ".Lpos:\n"
  set asm to asm + "    movq $10, %rcx\n"
  set asm to asm + ".Lloop:\n"
  set asm to asm + "    xorq %rdx, %rdx\n"
  set asm to asm + "    divq %rcx\n"
  set asm to asm + "    addb $48, %dl\n"
  set asm to asm + "    incq %r8\n"
  set asm to asm + "    movq %rbp, %rsi\n"
  set asm to asm + "    subq %r8, %rsi\n"
  set asm to asm + "    movb %dl, (%rsi)\n"
  set asm to asm + "    testq %rax, %rax\n"
  set asm to asm + "    jnz .Lloop\n"
  set asm to asm + "    testq %r9, %r9\n"
  set asm to asm + "    jns .Lprint\n"
  set asm to asm + "    incq %r8\n"
  set asm to asm + "    movq %rbp, %rsi\n"
  set asm to asm + "    subq %r8, %rsi\n"
  set asm to asm + "    movb $45, (%rsi)\n"
  set asm to asm + ".Lprint:\n"
  set asm to asm + "    movq $1, %rax\n"
  set asm to asm + "    movq $1, %rdi\n"
  set asm to asm + "    movq %r8, %rdx\n"
  set asm to asm + "    syscall\n"
  set asm to asm + "    leave\n"
  set asm to asm + "    ret\n\n"
  set asm to asm + "# sdev_say_str: prints length-prefixed string [i64 len][bytes] in %rdi + newline\n"
  set asm to asm + ".globl sdev_say_str\n"
  set asm to asm + "sdev_say_str:\n"
  set asm to asm + "    movq (%rdi), %rdx\n"
  set asm to asm + "    leaq 8(%rdi), %rsi\n"
  set asm to asm + "    movq $1, %rax\n"
  set asm to asm + "    movq $1, %rdi\n"
  set asm to asm + "    syscall\n"
  set asm to asm + "    movq $1, %rax\n"
  set asm to asm + "    movq $1, %rdi\n"
  set asm to asm + "    leaq .Lrt_nl(%rip), %rsi\n"
  set asm to asm + "    movq $1, %rdx\n"
  set asm to asm + "    syscall\n"
  set asm to asm + "    ret\n\n"
  set asm to asm + ".section .rodata\n"
  set asm to asm + ".Lrt_nl:\n"
  set asm to asm + "    .byte 10\n"
  return asm
end
