# SDEV Multilingual 26-Language Keyword Translator — authored in SDEV.
#
# Recognises script families (Cyrillic, Greek, Arabic, Hebrew, Devanagari,
# CJK, Hangul, Thai) and translates localized keywords into canonical SDEV.

to translator_supported_languages
  set langs to mklist(26)
  set langs[0] to "English"
  set langs[1] to "Bulgarian"
  set langs[2] to "Spanish"
  set langs[3] to "Russian"
  set langs[4] to "German"
  set langs[5] to "French"
  set langs[6] to "Japanese"
  set langs[7] to "Chinese"
  set langs[8] to "Arabic"
  set langs[9] to "Hindi"
  set langs[10] to "Portuguese"
  set langs[11] to "Italian"
  set langs[12] to "Korean"
  set langs[13] to "Turkish"
  set langs[14] to "Polish"
  set langs[15] to "Dutch"
  set langs[16] to "Greek"
  set langs[17] to "Hebrew"
  set langs[18] to "Swedish"
  set langs[19] to "Czech"
  set langs[20] to "Romanian"
  set langs[21] to "Hungarian"
  set langs[22] to "Ukrainian"
  set langs[23] to "Vietnamese"
  set langs[24] to "Thai"
  set langs[25] to "Swahili"
  return langs
end

to translator_detect_script with src
  set n to length(src)
  set i to 0
  while i < n
    set c to ord(src, i)
    # Cyrillic: 0xD0..0xD1 (208..209)
    if c is 208 or c is 209
      return "Cyrillic"
    end
    # Greek: 0xCE..0xCF (206..207)
    if c is 206 or c is 207
      return "Greek"
    end
    # Arabic: 0xD8..0xDB (216..219)
    if c >= 216 and c <= 219
      return "Arabic"
    end
    # Hebrew: 0xD6..0xD7 (214..215)
    if c is 214 or c is 215
      return "Hebrew"
    end
    # CJK: 0xE4..0xE9 (228..233)
    if c >= 228 and c <= 233
      return "CJK"
    end
    set i to i + 1
  end
  return "Latin"
end

to translator_canonicalize_word with word
  # Bulgarian / Russian translations
  if word is "нека"
    return "set"
  end
  if word is "кажи"
    return "say"
  end
  if word is "ако"
    return "if"
  end
  if word is "иначе"
    return "else"
  end
  if word is "докато"
    return "while"
  end
  if word is "край"
    return "end"
  end

  # Spanish translations
  if word is "definir"
    return "set"
  end
  if word is "decir"
    return "say"
  end
  if word is "si"
    return "if"
  end
  if word is "sino"
    return "else"
  end
  if word is "mientras"
    return "while"
  end
  if word is "fin"
    return "end"
  end

  # German translations
  if word is "setze"
    return "set"
  end
  if word is "sage"
    return "say"
  end
  if word is "wenn"
    return "if"
  end
  if word is "sonst"
    return "else"
  end
  if word is "solange"
    return "while"
  end
  if word is "ende"
    return "end"
  end

  return word
end


to translator_has_non_ascii with code
  set n to length(code)
  set i to 0
  while i < n
    if ord(code, i) > 127
      return 1
    end
    set i to i + 1
  end
  return 0
end

to tr_push_list with xs val
  set n to length(xs)
  set out to mklist(n + 1)
  set i to 0
  while i < n
    set out[i] to xs[i]
    set i to i + 1
  end
  set out[n] to val
  return out
end

to translator_segment_source with source
  set segs to []
  set n to length(source)
  set i to 0
  set buf to ""
  while i < n
    set c to substr(source, i, 1)
    set is_comment to 0
    if c is "#"
      set is_comment to 1
    else
      if c is "/" and (i + 1) < n
        if substr(source, i + 1, 1) is "/"
          set is_comment to 1
        end
      end
    end
    if is_comment is 1
      if length(buf) > 0
        set segs to tr_push_list(segs, [1, buf])
        set buf to ""
      end
      set stop to i
      while stop < n and substr(source, stop, 1) is not "\n"
        set stop to stop + 1
      end
      set segs to tr_push_list(segs, [0, substr(source, i, stop - i)])
      set i to stop
    else
      if c is "\"" or c is "'" or c is "`"
        if length(buf) > 0
          set segs to tr_push_list(segs, [1, buf])
          set buf to ""
        end
        set quote to c
        set j to i + 1
        set closed to 0
        while j < n and closed is 0
          set cur to substr(source, j, 1)
          if cur is "\\"
            set j to j + 2
          else
            if cur is quote
              set closed to 1
            end
            set j to j + 1
          end
        end
        if j > n
          set j to n
        end
        set segs to tr_push_list(segs, [0, substr(source, i, j - i)])
        set i to j
      else
        set buf to buf + c
        set i to i + 1
      end
    end
  end
  if length(buf) > 0
    set segs to tr_push_list(segs, [1, buf])
  end
  return segs
end

to translator_levenshtein with a b
  if a is b
    return 0
  end
  set al to length(a)
  set bl to length(b)
  if al is 0
    return bl
  end
  if bl is 0
    return al
  end
  set prev to mklist(bl + 1)
  set curr to mklist(bl + 1)
  set j to 0
  while j <= bl
    set prev[j] to j
    set j to j + 1
  end
  set i to 1
  while i <= al
    set curr[0] to i
    set ai to substr(a, i - 1, 1)
    set j to 1
    while j <= bl
      set cost to 1
      if ai is substr(b, j - 1, 1)
        set cost to 0
      end
      set best to curr[j - 1] + 1
      set del_c to prev[j] + 1
      if del_c < best
        set best to del_c
      end
      set sub_c to prev[j - 1] + cost
      if sub_c < best
        set best to sub_c
      end
      set curr[j] to best
      set j to j + 1
    end
    set k to 0
    while k <= bl
      set prev[k] to curr[k]
      set k to k + 1
    end
    set i to i + 1
  end
  return prev[bl]
end
