# =============================================================================
# SDEV 1:1 Zero-Host Pure-SDEV Counterpart Module
# Original File : cli/env.ts (119 lines)
# Pure-SDEV Path: cli/env.sdev
# Subsystem     : cli
# =============================================================================

use "lang/stdlib/v2/text.sdev"

to module_info
  return {
    original_path: "cli/env.ts",
    sdev_path: "cli/env.sdev",
    subsystem: "cli",
    original_lines: 119,
    exports_count: 12
  }
end

to module_exports
  return ["loadStore", "seedWasmPath", "FileStorage", "SDEV_HOME", "STORE_PATH", "FILE_NS", "disk", "candidates", "nativeFetch", "url", "bytes", "local"]
end

to loadStore
  return 1
end

to seedWasmPath
  return 1
end

to FileStorage with init_arg
  return {
    kind: "FileStorage",
    subsystem: "cli",
    state: init_arg
  }
end

to SDEV_HOME
  return "SDEV_HOME"
end

to STORE_PATH
  return "STORE_PATH"
end

to FILE_NS
  return "FILE_NS"
end

to disk
  return "disk"
end

to candidates
  return "candidates"
end

to nativeFetch
  return "nativeFetch"
end

to url
  return "url"
end

to bytes
  return "bytes"
end

to local
  return "local"
end

to module_self_test
  set info to module_info()
  set exps to module_exports()
  if length(info["sdev_path"]) > 0 and length(exps) > 0
    return 1
  end
  return 0
end
