# =============================================================================
# sdev — 100% Pure-SDEV Zero-Host Command-Line Interface
# (sdev-zero/cli/sdev.sdev)
#
# Zero TypeScript, zero JavaScript, zero WebAssembly.
# Invoked by `bin/sdev` (or compiled directly to a standalone native ELF binary
# `bin/sdev-cli`).
# =============================================================================

use "lang/runtime/vm.sdev"
use "lang/linter/linter.sdev"
use "lang/formatter/formatter.sdev"
use "lang/translator/translator.sdev"
use "lang/legacy/v1_frontend.sdev"
use "lang/native/pe_x64.sdev"
use "lang/dialect/dialect.sdev"
use "lang/registry/registry.sdev"

to hex_nib with c
  if c >= 97
    return c - 87
  end
  return c - 48
end

to hex_to_bytes with h
  set n to length(h) / 2
  set out to mklist(n)
  set i to 0
  while i < n
    set out[i] to hex_nib(ord(h, i * 2)) * 16 + hex_nib(ord(h, i * 2 + 1))
    set i to i + 1
  end
  return out
end

to pick_compile_key with argv
  set idx to 1
  set v1_flag to 0
  if length(argv) >= 2 and trim(argv[1]) is "--v1"
    set v1_flag to 1
    set idx to 2
  end
  if length(argv) <= idx
    return ""
  end
  set target to trim(argv[idx])
  if v1_flag is 0
    if find(read_file(target), "#!sdev v1") is 0
      set v1_flag to 1
    end
  end
  if v1_flag is 1
    return "sdev:compile:v1:" + target
  end
  return "sdev:compile:self:" + target
end

to pick_target_name with argv
  if length(argv) >= 2 and trim(argv[1]) is "--v1" and length(argv) >= 3
    return trim(argv[2])
  end
  if length(argv) >= 2
    return trim(argv[1])
  end
  return ""
end

to print_help
  say "sdev v4.0.0 — 100% Pure-SDEV Zero-Host Toolchain"
  say ""
  say "USAGE"
  say "  sdev <command> [options]"
  say ""
  say "EXECUTION & COMPILATION (Zero Node.js / Zero Wasm)"
  say "  run [--v1] <file.sdev> [args...]        Compile and run an SDEV v2 or v1 program"
  say "  eval [--v1] \"<code>\"                    Evaluate an inline SDEV v2/v1 snippet"
  say "  compile [--v1] <file.sdev> [-o out]     Compile to an SDEVC4 bytecode container"
  say "  run-bc <file.sdevc> [args...]           Execute an SDEVC4 bytecode container"
  say "  native [--v1] <file.sdev> [-o out]      Compile to a standalone native x86-64 ELF binary"
  say "  pe <out.exe> [msg] [exit_code]          Emit a standalone Windows x86-64 PE32+ (.exe)"
  say "  new <dir>                               Scaffold a new pure-SDEV project"
  say ""
  say "INSPECTION & CODE QUALITY (100% Pure SDEV)"
  say "  check [--v1] <file.sdev>                Validate syntax, arity, and symbols"
  say "  disasm [--v1] <file.sdev>               Compile and disassemble bytecode"
  say "  lint <file.sdev>                        Run static linter (SDEV001..SDEV015)"
  say "  fmt <file.sdev> [-w]                    Format SDEV source (-w writes in place)"
  say "  translate <file.sdev>                   Detect script & translate keywords (26 languages)"
  say "  dialect <slug> <file.sdev>              Canonicalize preset dialect (bg/es/py/mystic)"
  say "  v1 <file.sdev>                          Transpile SDEV v1 mystical syntax to canonical v2"
  say "  api [name]                              Inspect canonical API modules & functions"
  say "  explain <SDEV001..SDEV015>              Explain a diagnostic error code"
  say ""
  say "SELF-HOSTING & VERIFICATION"
  say "  test                                    Run all zero-host pure-SDEV test suites"
  say "  bootstrap [--v1]                        Verify Stage-1 == Stage-2 == Stage-3 fixed points (v2 & v1)"
  say "  web                                     Build the complete SDEV website in pure SDEV"
  say "  doctor                                  Audit zero-host toolchain & zero-foreign-file purity"
  say "  version | help"
  return 0
end

to has_foreign_ext with name
  set n to length(name)
  if n >= 3 and substr(name, n - 3, 3) is ".js"
    return 1
  end
  if n >= 4 and substr(name, n - 4, 4) is ".mjs"
    return 1
  end
  if n >= 3 and substr(name, n - 3, 3) is ".ts"
    return 1
  end
  if n >= 4 and substr(name, n - 4, 4) is ".tsx"
    return 1
  end
  if n >= 3 and substr(name, n - 3, 3) is ".py"
    return 1
  end
  if n >= 4 and substr(name, n - 4, 4) is ".wat"
    return 1
  end
  if n >= 5 and substr(name, n - 5, 5) is ".wasm"
    return 1
  end
  return 0
end

to audit_dir with dir
  set listing to read_file("sdev:ls:" + dir)
  if length(listing) is 0
    return 0
  end
  set items to split(listing, "\n")
  set bad to 0
  set i to 0
  while i < length(items)
    set item to items[i]
    if length(item) > 0
      if has_foreign_ext(item) is 1
        say "  ✗ Foreign file detected: " + dir + "/" + item
        set bad to bad + 1
      end
    end
    set i to i + 1
  end
  return bad
end

to cmd_doctor
  say "================================================================"
  say "  SDEV Zero-Host Toolchain & Purity Doctor"
  say "================================================================"
  set bad to 0
  set bad to bad + audit_dir(".")
  set bad to bad + audit_dir("bin")
  set bad to bad + audit_dir("cli")
  set bad to bad + audit_dir("scripts")
  set bad to bad + audit_dir("lang")
  set bad to bad + audit_dir("lang/compiler")
  set bad to bad + audit_dir("lang/native")
  set bad to bad + audit_dir("lang/runtime")
  set bad to bad + audit_dir("lang/stdlib")
  set bad to bad + audit_dir("lang/stdlib/v2")
  set bad to bad + audit_dir("lang/stdlib/ml")
  set bad to bad + audit_dir("lang/paradigms")
  set bad to bad + audit_dir("lang/agent")
  set bad to bad + audit_dir("lang/web")
  set bad to bad + audit_dir("src")
  set bad to bad + audit_dir("src/lang")
  set bad to bad + audit_dir("src/lang-bridge")
  set bad to bad + audit_dir("src/pages")
  set bad to bad + audit_dir("src/components")
  set bad to bad + audit_dir("src/hooks")
  set bad to bad + audit_dir("src/lib")
  set bad to bad + audit_dir("src/studio")
  set bad to bad + audit_dir("public")
  set bad to bad + audit_dir("extension")
  set bad to bad + audit_dir("drizzle")
  set bad to bad + audit_dir("tools")
  set bad to bad + audit_dir("AI")

  if bad is 0
    say "  ✓ Purity check: 0 foreign (.js / .mjs / .ts / .wasm) files found"
  else
    say "  ✗ Purity check failed: " + str(bad) + " foreign files found"
    write_file("sdev:exit:1", "")
    return 1
  end

  set rt to read_file("bin/runtime.s")
  if length(rt) > 1000
    say "  ✓ Native x86-64 syscall runtime (bin/runtime.s): ready (" + str(length(rt)) + " bytes)"
  else
    say "  ✗ Missing bin/runtime.s"
    write_file("sdev:exit:1", "")
    return 1
  end

  set drv to read_file("sdev:driver:baked")
  if length(drv) > 1000
    say "  ✓ Embedded self-hosted v2 compiler driver: ready"
  else
    say "  ✗ Missing embedded compiler driver"
    write_file("sdev:exit:1", "")
    return 1
  end

  set v1d to read_file("sdev:driver:v1")
  if length(v1d) > 1000 and find(v1d, "error ") is not 0
    say "  ✓ Self-hosted v1 compiler driver: ready"
  else
    say "  ✗ Self-hosted v1 compiler driver failed"
    write_file("sdev:exit:1", "")
    return 1
  end

  set langs to translator_supported_languages()
  say "  ✓ Multilingual translator: " + str(length(langs)) + " human languages ready"
  say "  ✓ Status: 100% ZERO-HOST & SELF-HOSTED"
  return 0
end

set raw_args to read_file("sdev:args")
set argv to split(raw_args, "\n")
set cmd to ""
if length(argv) > 0
  set cmd to trim(argv[0])
end

if length(cmd) is 0 or cmd is "help" or cmd is "--help" or cmd is "-h"
  set _ to print_help()
else
  if cmd is "version" or cmd is "--version" or cmd is "-v"
    say "sdev v4.0.0 (100% pure-SDEV zero-host toolchain)"
  else
    if cmd is "doctor"
      set _ to cmd_doctor()
    else
      if cmd is "check"
        set ckey to pick_compile_key(argv)
        if length(ckey) is 0
          write_file("sdev:err", "usage: sdev check [--v1] <file.sdev>\n")
          write_file("sdev:exit:2", "")
        else
          set target to pick_target_name(argv)
          set c to read_file(ckey)
          if find(c, "error ") is 0
            write_file("sdev:err", "sdev: " + target + ": " + substr(c, 6, length(c) - 6) + "\n")
            write_file("sdev:exit:1", "")
          else
            set sp to find(c, " ")
            say "✓ " + target + ": syntax & symbols OK (" + str(sp / 2) + " bytes bytecode)"
          end
        end
      else
        if cmd is "disasm"
          set ckey to pick_compile_key(argv)
          if length(ckey) is 0
            write_file("sdev:err", "usage: sdev disasm [--v1] <file.sdev>\n")
            write_file("sdev:exit:2", "")
          else
            set target to pick_target_name(argv)
            set c to read_file(ckey)
            if find(c, "error ") is 0
              write_file("sdev:err", "sdev: " + target + ": " + substr(c, 6, length(c) - 6) + "\n")
              write_file("sdev:exit:1", "")
            else
              set sp to find(c, " ")
              set bc to hex_to_bytes(substr(c, 0, sp))
              say join(vm_disassemble(bc), "\n")
            end
          end
        else
          if cmd is "lint"
            if length(argv) < 2
              write_file("sdev:err", "usage: sdev lint <file.sdev>\n")
              write_file("sdev:exit:2", "")
            else
              set target to trim(argv[1])
              set src to read_file(target)
              set lines to split(src, "\n")
              set issues to 0
              set i to 0
              while i < length(lines)
                set msg to sdev_lint_line(lines[i], i + 1)
                if length(msg) > 0
                  say target + ":" + str(i + 1) + ": " + msg
                  set issues to issues + 1
                end
                set i to i + 1
              end
              if issues is 0
                say "✓ " + target + ": 0 lint issues"
              else
                write_file("sdev:exit:1", "")
              end
            end
          else
            if cmd is "fmt"
              if length(argv) < 2
                write_file("sdev:err", "usage: sdev fmt <file.sdev> [-w]\n")
                write_file("sdev:exit:2", "")
              else
                set target to trim(argv[1])
                set formatted to sdev_format(read_file(target), 2)
                if length(argv) >= 3 and trim(argv[2]) is "-w"
                  set _ to write_file(target, formatted + "\n")
                  say "formatted " + target
                else
                  say formatted
                end
              end
            else
              if cmd is "translate"
                if length(argv) < 2
                  write_file("sdev:err", "usage: sdev translate <file.sdev>\n")
                  write_file("sdev:exit:2", "")
                else
                  set target to trim(argv[1])
                  set src to read_file(target)
                  set script_fam to translator_detect_script(src)
                  say "# Detected script family: " + script_fam
                  set words to split(src, " ")
                  set out_w to mklist(length(words))
                  set i to 0
                  while i < length(words)
                    set out_w[i] to translator_canonicalize_word(words[i])
                    set i to i + 1
                  end
                  say join(out_w, " ")
                end
              else
                if cmd is "v1"
                  if length(argv) < 2
                    write_file("sdev:err", "usage: sdev v1 <file.sdev>\n")
                    write_file("sdev:exit:2", "")
                  else
                    set target to trim(argv[1])
                    say v1_to_v2_source(read_file(target))
                  end
                else
                  if cmd is "pe"
                    if length(argv) < 2
                      write_file("sdev:err", "usage: sdev pe <out.exe> [message] [exit_code]\n")
                      write_file("sdev:exit:2", "")
                    else
                      set out_exe to trim(argv[1])
                      set crlf to chr(13) + "\n"
                      set msg to "Hello from SDEV 100% Pure-SDEV Windows PE32+ Native Executable!" + crlf
                      set code to 0
                      if length(argv) >= 3
                        set arg2 to trim(argv[2])
                        if length(argv) >= 4
                          set msg to arg2 + crlf
                          set code to int(trim(argv[3]))
                        else
                          if ord(arg2, 0) >= 48 and ord(arg2, 0) <= 57
                            set code to int(arg2)
                          else
                            set msg to arg2 + crlf
                          end
                        end
                      end
                      set nbytes to pe_write_exe(out_exe, msg, code)
                      say "✓ Wrote Windows x86-64 PE32+ Console Executable (" + str(nbytes) + " bytes, exit code " + str(code) + ") -> " + out_exe
                    end
                  else
                    if cmd is "eval"
                      if length(argv) < 2
                        write_file("sdev:err", "usage: sdev eval [--v1] \"<code>\"\n")
                        write_file("sdev:exit:2", "")
                      else
                        set ev_flag to ""
                        set snippet to argv[1]
                        if trim(argv[1]) is "--v1" and length(argv) >= 3
                          set ev_flag to "--v1 "
                          set snippet to argv[2]
                        end
                        set tmp_f to ".tmp_eval.sdev"
                        set _ to write_file(tmp_f, snippet + "\n")
                        set res to read_file("sdev:exec:./bin/sdev " + ev_flag + tmp_f + " && rm -f " + tmp_f)
                        set nl to find(res, "\n")
                        set st to substr(res, 0, nl)
                        set out to trim(substr(res, nl + 1, length(res) - nl - 1))
                        if length(out) > 0
                          say out
                        end
                        if st is not "0"
                          write_file("sdev:exit:1", "")
                        end
                      end
                    else
                      if cmd is "dialect"
                        if length(argv) < 3
                          write_file("sdev:err", "usage: sdev dialect <bg|es|py|mystic> <file.sdev>\n")
                          write_file("sdev:exit:2", "")
                        else
                          set slug to trim(argv[1])
                          set target to trim(argv[2])
                          set d to dialect_preset(slug)
                          say "# Dialect: " + d[0] + " (" + dialect_encode_address(d) + ")"
                          say dialect_canonicalize(read_file(target), d)
                        end
                      else
                        if cmd is "api"
                          if length(argv) < 2 or length(trim(argv[1])) is 0
                            set mods to registry_modules()
                            say "Canonical SDEV API Modules (" + str(length(mods)) + "): " + join(mods, ", ")
                          else
                            set q to trim(argv[1])
                            set m to registry_find_module(q)
                            if length(m) > 0
                              say q + " -> module '" + m + "'"
                            else
                              say q + " -> not found in canonical API registry"
                            end
                          end
                        else
                          if cmd is "explain"
                            if length(argv) < 2
                              write_file("sdev:err", "usage: sdev explain <SDEV001..SDEV015>\n")
                              write_file("sdev:exit:2", "")
                            else
                              say registry_explain_diagnostic(argv[1])
                            end
                          else
                            if cmd is "new"
                              if length(argv) < 2
                                write_file("sdev:err", "usage: sdev new <project_dir>\n")
                                write_file("sdev:exit:2", "")
                              else
                                set pdir to trim(argv[1])
                                set _ to read_file("sdev:exec:mkdir -p " + pdir)
                                set _ to write_file(pdir + "/sdev.json", "{\n  \"name\": \"" + pdir + "\",\n  \"entry\": \"main.sdev\",\n  \"runtime\": \"v2\"\n}\n")
                                set _ to write_file(pdir + "/main.sdev", "# " + pdir + " — pure SDEV project\nsay \"Hello from " + pdir + "!\"\n")
                                say "✓ Created pure-SDEV project in " + pdir + "/ (sdev.json, main.sdev)"
                              end
                            else
                              if cmd is "web"
                      set res to read_file("sdev:exec:./bin/sdev lang/web/sdev-website.sdev")
                      set nl to find(res, "\n")
                      say substr(res, nl + 1, length(res) - nl - 1)
                    else
                      if cmd is "test"
                        set res to read_file("sdev:exec:./bin/sdev scripts/test-all.sdev")
                        set nl to find(res, "\n")
                        set st to substr(res, 0, nl)
                        say substr(res, nl + 1, length(res) - nl - 1)
                        if st is not "0"
                          write_file("sdev:exit:1", "")
                        end
                      else
                        if cmd is "bootstrap"
                          set v1_only to length(argv) >= 2 and trim(argv[1]) is "--v1"
                          set boot_ok to 1
                          if v1_only is 0
                            say "▶ [v2] Stage 1: Compiling lang/compiler/driver.sdev with embedded self-hosted driver..."
                            set s1 to read_file("sdev:compile:self:lang/compiler/driver.sdev")
                            say "▶ [v2] Stage 2: Compiling lang/compiler/driver.sdev with freshly built Stage-2 driver..."
                            set s2 to read_file("sdev:compile:stage2:lang/compiler/driver.sdev")
                            set baked to read_file("sdev:driver:baked")
                            if s1 is baked and s2 is s1
                              say "✓ [v2] Fixed-Point Verified: Stage 1 == Stage 2 == Stage 3 (byte-identical)"
                            else
                              write_file("sdev:err", "✗ [v2] Fixed-Point mismatch!\n")
                              set boot_ok to 0
                            end
                          end
                          say "▶ [v1] Stage 1: Compiling pure-v1 lang/compiler/v1_self.sdev with v1_driver..."
                          set v1_s1 to read_file("sdev:driver:v1-self")
                          say "▶ [v1] Stage 2: Compiling pure-v1 lang/compiler/v1_self.sdev with Stage 1..."
                          set v1_s2 to read_file("sdev:driver:v1-self-stage2")
                          say "▶ [v1] Stage 3: Compiling pure-v1 lang/compiler/v1_self.sdev with Stage 2..."
                          set v1_s3 to read_file("sdev:compile:v1-self-stage2:lang/compiler/v1_self.sdev")
                          if length(v1_s1) > 1000 and find(v1_s1, "error ") is not 0 and v1_s1 is v1_s2 and v1_s2 is v1_s3
                            say "✓ [v1] Pure-v1 Fixed-Point Verified: Stage 1 == Stage 2 == Stage 3 (byte-identical)"
                          else
                            write_file("sdev:err", "✗ [v1] Fixed-Point mismatch!\n")
                            set boot_ok to 0
                          end
                          if boot_ok is 0
                            write_file("sdev:exit:1", "")
                          end
                        else
                          write_file("sdev:err", "sdev: unknown command '" + cmd + "'. Run 'sdev help'.\n")
                          write_file("sdev:exit:2", "")
                        end
                      end
                    end
                  end
                end
              end
            end
          end
        end
      end
    end
  end
end
end
end
end
end
end
