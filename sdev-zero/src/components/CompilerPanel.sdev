use "lang/stdlib/v2/text.sdev"

to module_info
  return {
    original_path: "src/components/CompilerPanel.tsx",
    sdev_path: "src/components/CompilerPanel.sdev",
    subsystem: "component",
    original_lines: 200,
    exports_count: 20
  }
end

to module_exports
  return ["CompilerPanel", "handleCompile", "t0", "lexer", "tokens", "parser", "ast", "compiler", "compiled", "t1", "handleRun", "outputLines", "vm", "handleDownloadBytecode", "binary", "blob", "url", "handleDownloadDisasm", "countInstructions", "count"]
end

to CompilerPanel with onOutput
  return "<sdev-view component=\"CompilerPanel\" subsystem=\"component\">" + str(onOutput) + "</sdev-view>"
end

