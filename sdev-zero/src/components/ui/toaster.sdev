use "lang/stdlib/v2/text.sdev"

to module_info
  return {
    original_path: "src/components/ui/toaster.tsx",
    sdev_path: "src/components/ui/toaster.sdev",
    subsystem: "ui-primitive",
    original_lines: 24,
    exports_count: 1
  }
end

to module_exports
  return ["Toaster"]
end

to Toaster
  return "<sdev-view component=\"Toaster\" subsystem=\"ui-primitive\">" + str("") + "</sdev-view>"
end

to module_self_test
  set info to module_info()
  set exps to module_exports()
  if length(info["sdev_path"]) > 0 and length(exps) > 0
    return 1
  end
  return 0
end
