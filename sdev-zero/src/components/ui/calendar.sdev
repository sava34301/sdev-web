use "lang/stdlib/v2/text.sdev"

to module_info
  return {
    original_path: "src/components/ui/calendar.tsx",
    sdev_path: "src/components/ui/calendar.sdev",
    subsystem: "ui-primitive",
    original_lines: 54,
    exports_count: 2
  }
end

to module_exports
  return ["Calendar", "make_CalendarProps"]
end

to Calendar with classNames showOutsideDays props
  return "<sdev-view component=\"Calendar\" subsystem=\"ui-primitive\">" + str(classNames) + "</sdev-view>"
end

to make_CalendarProps with payload
  return "<sdev-view component=\"make_CalendarProps\" subsystem=\"ui-primitive\">" + str(payload) + "</sdev-view>"
end

to module_self_test
  set info to module_info()
  set exps to module_exports()
  if length(info["sdev_path"]) > 0 and length(exps) > 0
    return 1
  end
  return 0
end
