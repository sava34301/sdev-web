use "lang/stdlib/v2/text.sdev"

to module_info
  return {
    original_path: "src/components/ui/aspect-ratio.tsx",
    sdev_path: "src/components/ui/aspect-ratio.sdev",
    subsystem: "ui-primitive",
    original_lines: 5,
    exports_count: 1
  }
end

to module_exports
  return ["AspectRatio"]
end

to AspectRatio
  return "<sdev-view component=\"AspectRatio\" subsystem=\"ui-primitive\">" + str("") + "</sdev-view>"
end

to module_self_test
  set info to module_info()
  set exps to module_exports()
  if length(info["sdev_path"]) > 0 and length(exps) > 0
    return 1
  end
  return 0
end
