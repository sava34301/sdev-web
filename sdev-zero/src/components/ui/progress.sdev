    original_path: "src/components/ui/progress.tsx",
    sdev_path: "src/components/ui/progress.sdev",
    subsystem: "ui-primitive",
    original_lines: 23,
    exports_count: 1
  }
end

to module_exports
  return ["Progress"]
end

to Progress
  return "<sdev-view component=\"Progress\" subsystem=\"ui-primitive\">" + str("") + "</sdev-view>"
end

to module_self_test
  set info to module_info()
  set exps to module_exports()
