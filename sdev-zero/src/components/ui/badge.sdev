use "lang/stdlib/v2/text.sdev"

to module_info
  return {
    original_path: "src/components/ui/badge.tsx",
    sdev_path: "src/components/ui/badge.sdev",
    subsystem: "ui-primitive",
    original_lines: 29,
    exports_count: 3
  }
end

to module_exports
  return ["Badge", "badgeVariants", "make_BadgeProps"]
end

to Badge with variant props
  return "<sdev-view component=\"Badge\" subsystem=\"ui-primitive\">" + str(variant) + "</sdev-view>"
end

to badgeVariants
  return "<sdev-view component=\"badgeVariants\" subsystem=\"ui-primitive\">" + str("") + "</sdev-view>"
end

to make_BadgeProps with payload
  return "<sdev-view component=\"make_BadgeProps\" subsystem=\"ui-primitive\">" + str(payload) + "</sdev-view>"
end

to module_self_test
  set info to module_info()
  set exps to module_exports()
  if length(info["sdev_path"]) > 0 and length(exps) > 0
    return 1
  end
  return 0
end
