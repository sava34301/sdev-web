use "lang/stdlib/v2/text.sdev"

to module_info
  return {
    original_path: "src/components/ui/textarea.tsx",
    sdev_path: "src/components/ui/textarea.sdev",
    subsystem: "ui-primitive",
    original_lines: 21,
    exports_count: 2
  }
end

to module_exports
  return ["Textarea", "make_TextareaProps"]
end

to Textarea
  return "<sdev-view component=\"Textarea\" subsystem=\"ui-primitive\">" + str("") + "</sdev-view>"
end

to make_TextareaProps with payload
  return "<sdev-view component=\"make_TextareaProps\" subsystem=\"ui-primitive\">" + str(payload) + "</sdev-view>"
end

to module_self_test
  set info to module_info()
  set exps to module_exports()
  if length(info["sdev_path"]) > 0 and length(exps) > 0
    return 1
  end
  return 0
end
