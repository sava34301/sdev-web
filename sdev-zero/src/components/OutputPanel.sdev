use "lang/stdlib/v2/text.sdev"

to module_info
  return {
    original_path: "src/components/OutputPanel.tsx",
    sdev_path: "src/components/OutputPanel.sdev",
    subsystem: "component",
    original_lines: 58,
    exports_count: 2
  }
end

to module_exports
  return ["OutputPanel", "hasOutput"]
end

to OutputPanel with error
  return "<sdev-view component=\"OutputPanel\" subsystem=\"component\">" + str(error) + "</sdev-view>"
end

to hasOutput
  return "<sdev-view component=\"hasOutput\" subsystem=\"component\">" + str("") + "</sdev-view>"
end

to module_self_test
  set info to module_info()
  set exps to module_exports()
  if length(info["sdev_path"]) > 0 and length(exps) > 0
    return 1
  end
  return 0
end
