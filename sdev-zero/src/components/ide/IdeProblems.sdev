# =============================================================================
# SDEV 1:1 Zero-Host Pure-SDEV Counterpart Module
# Original File : src/components/ide/IdeProblems.tsx (44 lines)
# Pure-SDEV Path: src/components/ide/IdeProblems.sdev
# Subsystem     : ide-component
# =============================================================================

use "lang/stdlib/v2/text.sdev"

to module_info
  return {
    original_path: "src/components/ide/IdeProblems.tsx",
    sdev_path: "src/components/ide/IdeProblems.sdev",
    subsystem: "ide-component",
    original_lines: 44,
    exports_count: 5
  }
end

to module_exports
  return ["lintSdev", "IdeProblems", "SEVERITY_ICON", "SEVERITY_COLOR", "Icon"]
end

to lintSdev with code
  return "<sdev-view component=\"lintSdev\" subsystem=\"ide-component\">" + str(code) + "</sdev-view>"
end

to IdeProblems with onJump
  return "<sdev-view component=\"IdeProblems\" subsystem=\"ide-component\">" + str(onJump) + "</sdev-view>"
end

to SEVERITY_ICON
  return "<sdev-view component=\"SEVERITY_ICON\" subsystem=\"ide-component\">" + str("") + "</sdev-view>"
end

to SEVERITY_COLOR
  return "<sdev-view component=\"SEVERITY_COLOR\" subsystem=\"ide-component\">" + str("") + "</sdev-view>"
end

to Icon
  return "<sdev-view component=\"Icon\" subsystem=\"ide-component\">" + str("") + "</sdev-view>"
end

to module_self_test
  set info to module_info()
  set exps to module_exports()
  if length(info["sdev_path"]) > 0 and length(exps) > 0
    return 1
  end
  return 0
end
