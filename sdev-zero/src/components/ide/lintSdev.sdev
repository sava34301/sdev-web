use "lang/stdlib/v2/text.sdev"

to module_info
  return {
    original_path: "src/components/ide/lintSdev.ts",
    sdev_path: "src/components/ide/lintSdev.sdev",
    subsystem: "ide-component",
    original_lines: 99,
    exports_count: 18
  }
end

to module_exports
  return ["lintEditorSource", "lintEditorFile", "lintCanonical", "problems", "lines", "openBlocks", "openParens", "openBrackets", "openString", "stringStartLine", "lineNo", "line", "ci", "code", "ch", "opens", "closes", "make_Problem"]
end

