# =============================================================================
# SDEV 1:1 Zero-Host Pure-SDEV Counterpart Module
# Original File : src/components/ide/IdeBreadcrumbs.tsx (36 lines)
# Pure-SDEV Path: src/components/ide/IdeBreadcrumbs.sdev
# Subsystem     : ide-component
# =============================================================================

use "lang/stdlib/v2/text.sdev"

to module_info
  return {
    original_path: "src/components/ide/IdeBreadcrumbs.tsx",
    sdev_path: "src/components/ide/IdeBreadcrumbs.sdev",
    subsystem: "ide-component",
    original_lines: 36,
    exports_count: 3
  }
end

to module_exports
  return ["IdeBreadcrumbs", "path", "cursor"]
end

to IdeBreadcrumbs with folders
  return "<sdev-view component=\"IdeBreadcrumbs\" subsystem=\"ide-component\">" + str(folders) + "</sdev-view>"
end

to path
  return "<sdev-view component=\"path\" subsystem=\"ide-component\">" + str("") + "</sdev-view>"
end

to cursor
  return "<sdev-view component=\"cursor\" subsystem=\"ide-component\">" + str("") + "</sdev-view>"
end

to module_self_test
  set info to module_info()
  set exps to module_exports()
  if length(info["sdev_path"]) > 0 and length(exps) > 0
    return 1
  end
  return 0
end
