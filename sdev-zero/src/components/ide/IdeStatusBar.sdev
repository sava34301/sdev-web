# =============================================================================
# SDEV 1:1 Zero-Host Pure-SDEV Counterpart Module
# Original File : src/components/ide/IdeStatusBar.tsx (64 lines)
# Pure-SDEV Path: src/components/ide/IdeStatusBar.sdev
# Subsystem     : ide-component
