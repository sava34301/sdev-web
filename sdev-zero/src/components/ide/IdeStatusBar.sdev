use "lang/stdlib/v2/text.sdev"

to module_info
  return {
    original_path: "src/components/ide/IdeStatusBar.tsx",
    sdev_path: "src/components/ide/IdeStatusBar.sdev",
    subsystem: "ide-component",
    original_lines: 64,
    exports_count: 1
  }
end

to module_exports
  return ["IdeStatusBar"]
end

to IdeStatusBar with runMode activeFile lines chars cursor
  return "<sdev-view component=\"IdeStatusBar\" subsystem=\"ide-component\">" + str(runMode) + "</sdev-view>"
end

to module_self_test
  set info to module_info()
  set exps to module_exports()
  if length(info["sdev_path"]) > 0 and length(exps) > 0
    return 1
  end
  return 0
end
