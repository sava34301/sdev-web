use "lang/stdlib/v2/text.sdev"

to module_info
  return {
    original_path: "src/integrations/supabase/client.ts",
    sdev_path: "src/integrations/supabase/client.sdev",
    subsystem: "config-tooling",
    original_lines: 15,
    exports_count: 3
  }
end

to module_exports
  return ["SUPABASE_URL", "SUPABASE_PUBLISHABLE_KEY", "supabase"]
end

to SUPABASE_URL
  return "SUPABASE_URL"
end

to SUPABASE_PUBLISHABLE_KEY
  return "SUPABASE_PUBLISHABLE_KEY"
end

to supabase
  return "supabase"
end

to module_self_test
  set info to module_info()
  set exps to module_exports()
  if length(info["sdev_path"]) > 0 and length(exps) > 0
