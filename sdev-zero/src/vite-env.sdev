# =============================================================================
# SDEV 1:1 Zero-Host Pure-SDEV Counterpart Module
# Original File : src/vite-env.d.ts (1 lines)
# Pure-SDEV Path: src/vite-env.sdev
# Subsystem     : config-tooling
# =============================================================================

use "lang/stdlib/v2/text.sdev"

to module_info
  return {
    original_path: "src/vite-env.d.ts",
    sdev_path: "src/vite-env.sdev",
    subsystem: "config-tooling",
    original_lines: 1,
    exports_count: 1
  }
end

to module_exports
  return ["run_module"]
end

to run_module with input_val
  return input_val
end

to module_self_test
  set info to module_info()
  set exps to module_exports()
  if length(info["sdev_path"]) > 0 and length(exps) > 0
    return 1
  end
  return 0
end
