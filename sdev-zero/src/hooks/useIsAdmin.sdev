use "lang/stdlib/v2/text.sdev"

to module_info
  return {
    original_path: "src/hooks/useIsAdmin.ts",
    sdev_path: "src/hooks/useIsAdmin.sdev",
    subsystem: "hook",
    original_lines: 27,
    exports_count: 2
  }
end

to module_exports
  return ["useIsAdmin", "cancelled"]
end

to useIsAdmin
