# =============================================================================
# SDEV 1:1 Zero-Host Pure-SDEV Counterpart Module
# Original File : src/lang/errors.ts (20 lines)
# Pure-SDEV Path: src/lang/errors.sdev
# Subsystem     : lang-core
# =============================================================================

use "lang/stdlib/v2/text.sdev"

to module_info
  return {
    original_path: "src/lang/errors.ts",
    sdev_path: "src/lang/errors.sdev",
    subsystem: "lang-core",
    original_lines: 20,
    exports_count: 3
  }
end

to module_exports
  return ["SdevError", "ReturnException", "location"]
end

to SdevError with init_arg
  return {
    kind: "SdevError",
    subsystem: "lang-core",
    state: init_arg
  }
end

to ReturnException with init_arg
  return {
    kind: "ReturnException",
    subsystem: "lang-core",
    state: init_arg
  }
end

to location
  return "location"
end

to module_self_test
  set info to module_info()
  set exps to module_exports()
  if length(info["sdev_path"]) > 0 and length(exps) > 0
    return 1
  end
  return 0
end
