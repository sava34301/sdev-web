use "lang/stdlib/v2/text.sdev"

to module_info
  return {
    original_path: "src/lang/hardware/board-db.test.ts",
    sdev_path: "src/lang/hardware/board-db.test.sdev",
    subsystem: "hardware",
    original_lines: 150,
    exports_count: 8
  }
end

to module_exports
  return ["describe", "test", "expect", "passed", "failed", "requiredIds", "board", "nodeProcess"]
end

to describe with name fn
  return name
end

to test with name fn
  return name
end

to expect with actual
  return actual
end

to passed
  return "passed"
end

to failed
  return "failed"
end

to requiredIds
  return "requiredIds"
end

to board
  return "board"
end

to nodeProcess
  return "nodeProcess"
end

to module_self_test
  set info to module_info()
  set exps to module_exports()
  if length(info["sdev_path"]) > 0 and length(exps) > 0
    return 1
  end
  return 0
end
