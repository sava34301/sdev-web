# =============================================================================
# SDEV 1:1 Zero-Host Pure-SDEV Counterpart Module
# Original File : src/lang/agent/brain-prompt.ts (13 lines)
# Pure-SDEV Path: src/lang/agent/brain-prompt.sdev
# Subsystem     : agent
# =============================================================================

use "lang/stdlib/v2/text.sdev"

to module_info
  return {
    original_path: "src/lang/agent/brain-prompt.ts",
    sdev_path: "src/lang/agent/brain-prompt.sdev",
    subsystem: "agent",
    original_lines: 13,
    exports_count: 2
  }
end

to module_exports
  return ["brainInstructions", "brainInput"]
end

to brainInstructions with format
  return format
end

to brainInput with req
  return req
end

to module_self_test
  set info to module_info()
  set exps to module_exports()
  if length(info["sdev_path"]) > 0 and length(exps) > 0
    return 1
  end
  return 0
end
