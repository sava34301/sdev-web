# =============================================================================
# SDEV 1:1 Zero-Host Pure-SDEV Counterpart Module
# Original File : src/lang/builtins.ts (40 lines)
# Pure-SDEV Path: src/lang/builtins.sdev
# Subsystem     : lang-core
# =============================================================================

use "lang/stdlib/v2/text.sdev"

to module_info
  return {
    original_path: "src/lang/builtins.ts",
    sdev_path: "src/lang/builtins.sdev",
    subsystem: "lang-core",
    original_lines: 40,
    exports_count: 2
  }
end

to module_exports
  return ["createBuiltins", "builtins"]
end

to createBuiltins with output
  return output
end

to builtins
  return "builtins"
end

to module_self_test
  set info to module_info()
  set exps to module_exports()
  if length(info["sdev_path"]) > 0 and length(exps) > 0
    return 1
  end
  return 0
end
