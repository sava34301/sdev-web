use "lang/stdlib/v2/text.sdev"

to module_info
  return {
    original_path: "src/lang/dialect/sample.ts",
    sdev_path: "src/lang/dialect/sample.sdev",
    subsystem: "dialect",
    original_lines: 27,
    exports_count: 1
  }
end

to module_exports
  return ["SAMPLE"]
end

to SAMPLE
  return "SAMPLE"
end

to module_self_test
  set info to module_info()
  set exps to module_exports()
  if length(info["sdev_path"]) > 0 and length(exps) > 0
    return 1
  end
  return 0
end
