# =============================================================================
# SDEV 1:1 Zero-Host Pure-SDEV Counterpart Module
# Original File : src/lang/builtins/json.ts (14 lines)
# Pure-SDEV Path: src/lang/builtins/json.sdev
# Subsystem     : builtins
