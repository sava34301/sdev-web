use "lang/stdlib/v2/text.sdev"

to module_info
  return {
    original_path: "src/pages/Launch.tsx",
    sdev_path: "src/pages/Launch.sdev",
    subsystem: "page",
    original_lines: 161,
    exports_count: 12
  }
end

to module_exports
  return ["diff", "Launch", "ms", "navigate", "launched", "id", "launchLine", "calendarUrl", "icsUrl", "handleRedeem", "res", "alreadyInvited"]
end

to diff with target
  return "<sdev-view component=\"diff\" subsystem=\"page\">" + str(target) + "</sdev-view>"
end

to Launch
  return "<sdev-view component=\"Launch\" subsystem=\"page\">" + str("") + "</sdev-view>"
end

to ms
  return "<sdev-view component=\"ms\" subsystem=\"page\">" + str("") + "</sdev-view>"
end

