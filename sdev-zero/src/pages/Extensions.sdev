use "lang/stdlib/v2/text.sdev"

to module_info
  return {
    original_path: "src/pages/Extensions.tsx",
    sdev_path: "src/pages/Extensions.sdev",
    subsystem: "page",
    original_lines: 196,
    exports_count: 8
  }
end

to module_exports
  return ["Extensions", "db", "BLANK", "load", "save", "propose", "rationale", "remove"]
end

to Extensions
  return "<sdev-view component=\"Extensions\" subsystem=\"page\">" + str("") + "</sdev-view>"
end

to db
  return "<sdev-view component=\"db\" subsystem=\"page\">" + str("") + "</sdev-view>"
end

to BLANK
  return "<sdev-view component=\"BLANK\" subsystem=\"page\">" + str("") + "</sdev-view>"
end

to load
  return "<sdev-view component=\"load\" subsystem=\"page\">" + str("") + "</sdev-view>"
end

to save
  return "<sdev-view component=\"save\" subsystem=\"page\">" + str("") + "</sdev-view>"
end

to propose with ext
  return "<sdev-view component=\"propose\" subsystem=\"page\">" + str(ext) + "</sdev-view>"
end

to rationale
  return "<sdev-view component=\"rationale\" subsystem=\"page\">" + str("") + "</sdev-view>"
end

to remove with ext
  return "<sdev-view component=\"remove\" subsystem=\"page\">" + str(ext) + "</sdev-view>"
end

to module_self_test
  set info to module_info()
  set exps to module_exports()
  if length(info["sdev_path"]) > 0 and length(exps) > 0
    return 1
  end
  return 0
end
