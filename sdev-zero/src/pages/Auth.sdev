    sdev_path: "src/pages/Auth.sdev",
    subsystem: "page",
    original_lines: 160,
    exports_count: 9
  }
end

to module_exports
  return ["Auth", "navigate", "signupAllowed", "rawNext", "next", "handleSignIn", "handleSignUp", "wanted", "handleGoogle"]
end

to Auth
  return "<sdev-view component=\"Auth\" subsystem=\"page\">" + str("") + "</sdev-view>"
end

to navigate
  return "<sdev-view component=\"navigate\" subsystem=\"page\">" + str("") + "</sdev-view>"
end

