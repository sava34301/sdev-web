to shownExtensions
  return "<sdev-view component=\"shownExtensions\" subsystem=\"page\">" + str("") + "</sdev-view>"
end

to shownPrograms
  return "<sdev-view component=\"shownPrograms\" subsystem=\"page\">" + str("") + "</sdev-view>"
end

to installDialect with row
  return "<sdev-view component=\"installDialect\" subsystem=\"page\">" + str(row) + "</sdev-view>"
end

to next
  return "<sdev-view component=\"next\" subsystem=\"page\">" + str("") + "</sdev-view>"
end

to module_self_test
  set info to module_info()
  set exps to module_exports()
  if length(info["sdev_path"]) > 0 and length(exps) > 0
    return 1
  end
  return 0
end
