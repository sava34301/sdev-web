use "lang/stdlib/v2/text.sdev"

to module_info
  return {
    original_path: "src/pages/Privacy.tsx",
    sdev_path: "src/pages/Privacy.sdev",
    subsystem: "page",
    original_lines: 170,
    exports_count: 1
  }
end

to module_exports
  return ["Privacy"]
end

to Privacy
  return "<sdev-view component=\"Privacy\" subsystem=\"page\">" + str("") + "</sdev-view>"
end

to module_self_test
  set info to module_info()
  set exps to module_exports()
  if length(info["sdev_path"]) > 0 and length(exps) > 0
    return 1
  end
  return 0
end
