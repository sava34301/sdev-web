use "lang/stdlib/v2/text.sdev"

to module_info
  return {
    original_path: "src/pages/SelfHostingGuide.tsx",
    sdev_path: "src/pages/SelfHostingGuide.sdev",
    subsystem: "page",
    original_lines: 409,
    exports_count: 14
  }
end

to module_exports
  return ["Code", "H2", "SelfHostingGuide", "PATH", "TITLE", "DESCRIPTION", "SECTIONS", "FACT_SOURCE", "FAQ", "navigate", "els", "obs", "vis", "openInIde"]
end

to Code
  return "<sdev-view component=\"Code\" subsystem=\"page\">" + str("") + "</sdev-view>"
end

to H2 with children
  return "<sdev-view component=\"H2\" subsystem=\"page\">" + str(children) + "</sdev-view>"
end

to SelfHostingGuide
  return "<sdev-view component=\"SelfHostingGuide\" subsystem=\"page\">" + str("") + "</sdev-view>"
end

