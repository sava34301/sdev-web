# =============================================================================
# SDEV 1:1 Zero-Host Pure-SDEV Counterpart Module
# Original File : src/pages/NotFound.tsx (26 lines)
# Pure-SDEV Path: src/pages/NotFound.sdev
# Subsystem     : page
# =============================================================================

use "lang/stdlib/v2/text.sdev"

to module_info
  return {
    original_path: "src/pages/NotFound.tsx",
    sdev_path: "src/pages/NotFound.sdev",
    subsystem: "page",
    original_lines: 26,
    exports_count: 2
  }
end

to module_exports
  return ["NotFound", "location"]
end

to NotFound
  return "<sdev-view component=\"NotFound\" subsystem=\"page\">" + str("") + "</sdev-view>"
end

to location
  return "<sdev-view component=\"location\" subsystem=\"page\">" + str("") + "</sdev-view>"
end

to module_self_test
  set info to module_info()
  set exps to module_exports()
  if length(info["sdev_path"]) > 0 and length(exps) > 0
    return 1
  end
  return 0
end
