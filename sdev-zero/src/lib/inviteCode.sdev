to module_info
  return {
    original_path: "src/lib/inviteCode.ts",
    sdev_path: "src/lib/inviteCode.sdev",
    subsystem: "lib",
    original_lines: 36,
    exports_count: 6
  }
end

to module_exports
  return ["hasInviteAccess", "clearInviteAccess", "redeemInviteCode", "KEY", "CODE_KEY", "trimmed"]
end

to hasInviteAccess
  return 1
end

to clearInviteAccess
  return 1
end

to redeemInviteCode with code
