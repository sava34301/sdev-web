use "lang/stdlib/v2/text.sdev"

to module_info
  return {
    original_path: "src/lib/mcp/index.ts",
    sdev_path: "src/lib/mcp/index.sdev",
    subsystem: "mcp",
    original_lines: 18,
    exports_count: 1
  }
end

to module_exports
  return ["projectRef"]
end

to projectRef
  return "projectRef"
end

to module_self_test
  set info to module_info()
  set exps to module_exports()
  if length(info["sdev_path"]) > 0 and length(exps) > 0
    return 1
  end
  return 0
end
