# =============================================================================
# SDEV 1:1 Zero-Host Pure-SDEV Counterpart Module
# Original File : src/lib/app-router.ts (6 lines)
# Pure-SDEV Path: src/lib/app-router.sdev
# Subsystem     : lib
# =============================================================================

use "lang/stdlib/v2/text.sdev"

to module_info
  return {
    original_path: "src/lib/app-router.ts",
    sdev_path: "src/lib/app-router.sdev",
    subsystem: "lib",
    original_lines: 6,
    exports_count: 1
  }
end

to module_exports
  return ["appRouterForProtocol"]
end

to appRouterForProtocol with protocol
  return protocol
end

to module_self_test
  set info to module_info()
  set exps to module_exports()
  if length(info["sdev_path"]) > 0 and length(exps) > 0
    return 1
  end
  return 0
end
