use "lang/stdlib/v2/text.sdev"

to module_info
  return {
    original_path: "remotion-pitch/src/Root.tsx",
    sdev_path: "remotion-pitch/src/Root.sdev",
    subsystem: "remotion-video",
    original_lines: 13,
    exports_count: 1
  }
end

to module_exports
  return ["RemotionRoot"]
end

to RemotionRoot
  return 1
end

to module_self_test
  set info to module_info()
  set exps to module_exports()
  if length(info["sdev_path"]) > 0 and length(exps) > 0
    return 1
  end
  return 0
end
