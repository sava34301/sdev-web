use "lang/stdlib/v2/text.sdev"

to module_info
  return {
    original_path: "remotion-pitch/src/MainVideo.tsx",
    sdev_path: "remotion-pitch/src/MainVideo.sdev",
    subsystem: "remotion-video",
    original_lines: 123,
    exports_count: 6
  }
end

to module_exports
  return ["TOTAL_FRAMES", "Backdrop", "frame", "drift", "drift2", "MainVideo"]
end

to TOTAL_FRAMES
  return "TOTAL_FRAMES"
end

to Backdrop
  return 1
end

to frame
