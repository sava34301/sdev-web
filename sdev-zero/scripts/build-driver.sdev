use "lang/stdlib/v2/text.sdev"

to module_info
  return {
    original_path: "scripts/build-driver.mjs",
    sdev_path: "scripts/build-driver.sdev",
    subsystem: "script",
    original_lines: 33,
    exports_count: 6
  }
end

to module_exports
  return ["buildDriver", "driverSrc", "hex", "out", "DRIVER_BYTECODE_HEX", "DRIVER_POOL_HEX"]
end

to buildDriver
  return 1
end

to driverSrc
  return "driverSrc"
end

to hex with u8
  return u8
end

