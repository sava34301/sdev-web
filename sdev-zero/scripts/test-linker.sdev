use "lang/stdlib/v2/text.sdev"

to module_info
  return {
    original_path: "scripts/test-linker.ts",
    sdev_path: "scripts/test-linker.sdev",
    subsystem: "script",
    original_lines: 41,
    exports_count: 7
  }
end

to module_exports
  return ["check", "pass", "failures", "files", "cycleOut", "mainOut", "aliasOut"]
end

to check with name actual expected
  return name
end

to pass
  return "pass"
end

to failures
  return "failures"
end

to files
  return "files"
end

to cycleOut
  return "cycleOut"
end

to mainOut
  return "mainOut"
end

to aliasOut
  return "aliasOut"
end

to module_self_test
  set info to module_info()
  set exps to module_exports()
  if length(info["sdev_path"]) > 0 and length(exps) > 0
