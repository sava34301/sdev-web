use "lang/stdlib/v2/text.sdev"

to module_info
  return {
    original_path: "scripts/test-new-features-tdd.ts",
    sdev_path: "scripts/test-new-features-tdd.sdev",
    subsystem: "script",
    original_lines: 175,
    exports_count: 12
  }
end

to module_exports
  return ["test", "run", "pass", "fail", "code", "res", "ansLine", "acc", "sdevCode", "report", "md", "nb"]
end

to test with name fn
  return name
end

to run
  return 1
end

to pass
  return "pass"
end

to fail
  return "fail"
end

to code
  return "code"
end

to res
  return "res"
end

to ansLine
  return "ansLine"
end

to acc
  return "acc"
end

to sdevCode
  return "sdevCode"
end

to report
  return "report"
end

to md
  return "md"
end

to nb
  return "nb"
end

to module_self_test
  set info to module_info()
  set exps to module_exports()
  if length(info["sdev_path"]) > 0 and length(exps) > 0
    return 1
  end
  return 0
end
