# =============================================================================
# SDEV 1:1 Zero-Host Pure-SDEV Counterpart Module
# Original File : scripts/test-bg.ts (14 lines)
# Pure-SDEV Path: scripts/test-bg.sdev
# Subsystem     : script
# =============================================================================

use "lang/stdlib/v2/text.sdev"

to module_info
  return {
    original_path: "scripts/test-bg.ts",
    sdev_path: "scripts/test-bg.sdev",
    subsystem: "script",
    original_lines: 14,
    exports_count: 1
  }
end

to module_exports
  return ["src"]
end

to src
  return "src"
end

to module_self_test
  set info to module_info()
  set exps to module_exports()
  if length(info["sdev_path"]) > 0 and length(exps) > 0
    return 1
  end
  return 0
end
