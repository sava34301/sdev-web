end

to reshapeFunc
  return "reshapeFunc"
end

to matsumFunc
  return "matsumFunc"
end

to matmeanFunc
  return "matmeanFunc"
end

to module_self_test
  set info to module_info()
  set exps to module_exports()
  if length(info["sdev_path"]) > 0 and length(exps) > 0
    return 1
  end
  return 0
end
