use "lang/stdlib/v2/text.sdev"

to module_info
  return {
    original_path: "scripts/test-matrix.ts",
    sdev_path: "scripts/test-matrix.sdev",
    subsystem: "script",
    original_lines: 170,
    exports_count: 19
  }
end

to module_exports
  return ["check", "expectThrow", "assertDeepEqual", "builtins", "passed", "failed", "matrixFunc", "identityFunc", "transposeFunc", "dotFunc", "matmulFunc", "mataddFunc", "matsubFunc", "matscaleFunc", "shapeFunc", "flattenFunc", "reshapeFunc", "matsumFunc", "matmeanFunc"]
end

to check with name fn
  return name
end

to expectThrow with name errorSubstr fn
