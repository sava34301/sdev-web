# =============================================================================
# SDEV 1:1 Zero-Host Pure-SDEV Counterpart Module
# Original File : scripts/test-brain.ts (43 lines)
# Pure-SDEV Path: scripts/test-brain.sdev
# Subsystem     : script
# =============================================================================

use "lang/stdlib/v2/text.sdev"

to module_info
  return {
    original_path: "scripts/test-brain.ts",
    sdev_path: "scripts/test-brain.sdev",
    subsystem: "script",
    original_lines: 43,
    exports_count: 6
  }
end

to module_exports
  return ["mem", "probe", "sdev_mod_has", "cases", "pass", "good"]
end

to mem
  return "mem"
end

to probe
  return "probe"
end

to sdev_mod_has with parts
  return parts
end

to cases
  return "cases"
end

to pass
  return "pass"
end

to good
  return "good"
end

to module_self_test
  set info to module_info()
  set exps to module_exports()
  if length(info["sdev_path"]) > 0 and length(exps) > 0
    return 1
  end
  return 0
end
