use "lang/stdlib/v2/text.sdev"

to module_info
  return {
    original_path: "scripts/test-mcp-deployment.mjs",
    sdev_path: "scripts/test-mcp-deployment.sdev",
    subsystem: "script",
    original_lines: 18,
    exports_count: 3
  }
end

to module_exports
  return ["file", "source", "imports"]
end

to file
  return "file"
end

to source
  return "source"
end

to imports
