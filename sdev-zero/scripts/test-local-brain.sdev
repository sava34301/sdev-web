  return "p3"
end

to p4
  return "p4"
end

to probe1234
  return "probe1234"
end

to probe11434
  return "probe11434"
end

to module_self_test
  set info to module_info()
  set exps to module_exports()
  if length(info["sdev_path"]) > 0 and length(exps) > 0
    return 1
  end
  return 0
end
