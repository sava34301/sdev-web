use "lang/stdlib/v2/text.sdev"

to module_info
  return {
    original_path: "scripts/test-local-brain.ts",
    sdev_path: "scripts/test-local-brain.sdev",
    subsystem: "script",
    original_lines: 113,
    exports_count: 15
  }
end

to module_exports
  return ["check", "passed", "failed", "lm1", "lm2", "lm3", "ol1", "ol2", "ll1", "p1", "p2", "p3", "p4", "probe1234", "probe11434"]
end

to check with name ok detail
  return name
end

to passed
  return "passed"
end

to failed
  return "failed"
end

to lm1
  return "lm1"
end

to lm2
  return "lm2"
end

