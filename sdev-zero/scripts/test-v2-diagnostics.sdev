use "lang/stdlib/v2/text.sdev"

to module_info
  return {
    original_path: "scripts/test-v2-diagnostics.mjs",
    sdev_path: "scripts/test-v2-diagnostics.sdev",
    subsystem: "script",
    original_lines: 74,
    exports_count: 5
  }
end

to module_exports
  return ["runSrc", "check", "selfCompileErr", "dir", "pass"]
end

to runSrc with name src
  return name
end

to check with name ok info
  return name
end

to selfCompileErr with src
  return src
end

to dir
  return "dir"
end

to pass
  return "pass"
end

to module_self_test
  set info to module_info()
  set exps to module_exports()
  if length(info["sdev_path"]) > 0 and length(exps) > 0
    return 1
  end
  return 0
end
