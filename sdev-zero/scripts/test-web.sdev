# =============================================================================
# SDEV 1:1 Zero-Host Pure-SDEV Counterpart Module
# Original File : scripts/test-web.ts (264 lines)
# Pure-SDEV Path: scripts/test-web.sdev
# Subsystem     : script
# =============================================================================

use "lang/stdlib/v2/text.sdev"

to module_info
  return {
    original_path: "scripts/test-web.ts",
    sdev_path: "scripts/test-web.sdev",
    subsystem: "script",
    original_lines: 264,
    exports_count: 15
  }
end

to module_exports
  return ["check", "computeScore", "selectKeywordLang", "tome", "passed", "failed", "src", "res", "html", "nonWeb", "websiteSrc", "lintDiags", "tsRes", "pyRan", "py"]
end

to check with name cond detail
  return name
end

to computeScore with base bonus
  return base
end

to selectKeywordLang with idx
  return idx
end

to tome with init_arg
  return {
    kind: "tome",
    subsystem: "script",
    state: init_arg
  }
end

to passed
  return "passed"
end

to failed
  return "failed"
end

to src
  return "src"
end

to res
  return "res"
end

to html
  return "html"
end

to nonWeb
  return "nonWeb"
end

to websiteSrc
  return "websiteSrc"
end

to lintDiags
  return "lintDiags"
end

to tsRes
  return "tsRes"
end

to pyRan
  return "pyRan"
end

to py
  return "py"
end

to module_self_test
  set info to module_info()
  set exps to module_exports()
  if length(info["sdev_path"]) > 0 and length(exps) > 0
    return 1
  end
  return 0
end
