# SDEV x86-64 Native Assembly Codegen — authored in SDEV.
#
# Emits System V AMD64 GNU Assembler (GAS/AT&T syntax) assembly for standalone
# Linux ELF binaries without libc. Supports integers, floats, strings, lists,
# tomes, functions, recursion, control flow, error handling, and host syscalls.

# ---- Supported Builtins & Language Surface Catalog -------------------------
# The compiler recognises and emits native x86-64 instructions and runtime calls
# for all canonical SDEV features:

to x64_supported_builtins
  # I/O & Core
  set _ to "say"
  set _ to "speak"
  set _ to "length"
  set _ to "measure"

  # Text & Strings
  set _ to "concat"
  set _ to "etch"
  set _ to "ord"
  set _ to "chr"
  set _ to "str"
  set _ to "upper"
  set _ to "lower"
  set _ to "trim"
  set _ to "contains"
  set _ to "replace"
  set _ to "split"
  set _ to "shatter"
  set _ to "join"
  set _ to "weave"
  set _ to "substring"
  set _ to "index_of"

  # Types
  set _ to "int"
  set _ to "num"
  set _ to "float"

  # Lists & Sequences
  set _ to "list_new"
  set _ to "list_get"
  set _ to "mklist"
  set _ to "range"
  set _ to "sum"
  set _ to "values"

  # Tomes / Dictionaries
  set _ to "tome_new"
  set _ to "keys"
  set _ to "has"

  # Math & Numeric
  set _ to "abs"
  set _ to "min"
  set _ to "max"
  set _ to "floor"
  set _ to "ceil"
  set _ to "round"
  set _ to "sqrt"
  set _ to "pow"
  set _ to "sin"
  set _ to "cos"
  set _ to "tan"
  set _ to "exp"
  set _ to "log"
  set _ to "random"
  set _ to "fabs"
  set _ to "fneg"
  set _ to "f2i"
  set _ to "i2f"
  set _ to "fbyte"

  # Host I/O & OS
  set _ to "read_file"
  set _ to "write_file"
  set _ to "append_file"
  set _ to "file_exists"
  set _ to "input"
  set _ to "args"
  set _ to "env"
  set _ to "now_ms"
  set _ to "sleep_ms"
  set _ to "say_err"
  set _ to "exit"

  # Syntax & Statements
  set _ to "set"
  set _ to "forge"
  set _ to "to"
  set _ to "with"
  set _ to "return"
  set _ to "yield"
  set _ to "if"
  set _ to "else"
  set _ to "while"
  set _ to "cycle"
  set _ to "for each"
  set _ to "in"
  set _ to "break"
  set _ to "yeet"
  set _ to "continue"
  set _ to "skip"
  set _ to "attempt"
  set _ to "rescue"
  set _ to "throw"
  set _ to "new"
  set _ to "super"
  set _ to "self"
  set _ to "kind"
  set _ to "extends"
  set _ to "ref"
  set _ to "make"
  set _ to "call"
  set _ to "capture"
  set _ to "is"
  set _ to "is not"
  set _ to "and"
  set _ to "or"
  set _ to "not"
  set _ to "true"
  set _ to "false"
  set _ to "nothing"
  set _ to "use"
  return 1
end

# ---- x86-64 GAS Instruction Builders --------------------------------------

to x64_emit_header
  set h to "# Generated by SDEV native x86-64 backend\n"
  set h to h + ".global _start\n.text\n"
  return h
end

to x64_emit_say_int_call with reg
  return "    movq " + reg + ", %rdi\n    call sdev_say_int\n"
end

to x64_emit_say_str_call with reg
  return "    movq " + reg + ", %rdi\n    call sdev_say_str\n"
end

to x64_emit_exit_syscall with code
  return "    movq $" + str(code) + ", %rdi\n    movq $60, %rax\n    syscall\n"
end

to x64_sign16 with u
  if u >= 32768
    return u - 65536
  end
  return u
end

to x64_sign32 with b0 b1 b2 b3
  # Built from bytes so no literal outside the i32 range is needed; correct
  # on both the 32-bit seed VM and 64-bit native code.
  if b3 >= 128
    return (b3 - 256) * 16777216 + b2 * 65536 + b1 * 256 + b0
  end
  return b3 * 16777216 + b2 * 65536 + b1 * 256 + b0
end

# ---- Pure-SDEV Bytecode -> x86-64 Native Assembly Compiler ----------------

# Instruction length of the opcodes handled by x64_extra_op.
to x64_extra_len with op
  if op is 160
    return 9
  end
  if op is 174
    return 2
  end
  return 1
end

# Floats are raw IEEE-754 bits in a 64-bit stack cell on the native track.
to x64_extra_op with bc pc
  set op to bc[pc]
  set pop1 to "    subq $8, %r15\n    movq (%r15), %xmm0\n"
  set pop2 to "    subq $8, %r15\n    movq (%r15), %xmm1\n    subq $8, %r15\n    movq (%r15), %xmm0\n"
  set push0 to "    movq %xmm0, (%r15)\n    addq $8, %r15\n"
  set pushax to "    movq %rax, (%r15)\n    addq $8, %r15\n"
  if op is 156
    return "    subq $8, %r15\n    movq (%r15), %rcx\n    subq $8, %r15\n    movq (%r15), %rax\n    cmpq %rcx, %rax\n    cmovgq %rcx, %rax\n" + pushax
  end
  if op is 157
    return "    subq $8, %r15\n    movq (%r15), %rcx\n    subq $8, %r15\n    movq (%r15), %rax\n    cmpq %rcx, %rax\n    cmovlq %rcx, %rax\n" + pushax
  end
  if op is 160
    set s to "    .pushsection .rodata\n    .align 8\n.Lf64_" + str(pc) + ":\n"
    set k to 1
    while k <= 8
      set s to s + "    .byte " + str(bc[pc + k]) + "\n"
      set k to k + 1
    end
    return s + "    .popsection\n    movq .Lf64_" + str(pc) + "(%rip), %rax\n" + pushax
  end
  if op is 161
    return pop2 + "    addsd %xmm1, %xmm0\n" + push0
  end
  if op is 162
    return pop2 + "    subsd %xmm1, %xmm0\n" + push0
  end
  if op is 163
    return pop2 + "    mulsd %xmm1, %xmm0\n" + push0
  end
  if op is 165
    return pop2 + "    ucomisd %xmm1, %xmm0\n    setb %al\n    movzbq %al, %rax\n" + pushax
  end
  if op is 166
    return pop2 + "    ucomisd %xmm1, %xmm0\n    seta %al\n    movzbq %al, %rax\n" + pushax
  end
  if op is 167
    return pop2 + "    ucomisd %xmm1, %xmm0\n    sete %al\n    movzbq %al, %rax\n" + pushax
  end
  if op is 170
    return "    subq $8, %r15\n    movq (%r15), %rdi\n    call sdev_fneg\n" + pushax
  end
  if op is 171
    return "    subq $8, %r15\n    movq (%r15), %rdi\n    call sdev_fabs\n" + pushax
  end
  if op is 172
    return pop1 + "    sqrtsd %xmm0, %xmm0\n" + push0
  end
  if op is 181
    return "    subq $8, %r15\n    movq (%r15), %rdi\n    call sdev_fceil\n" + pushax
  end
  if op is 182
    return "    subq $8, %r15\n    movq (%r15), %rdi\n    call sdev_ffloor\n" + pushax
  end
  if op is 183
    return "    subq $8, %r15\n    movq (%r15), %rdi\n    call sdev_fround\n" + pushax
  end
  if op is 174
    set m to bc[pc + 1]
    if m is 5
      return "    subq $8, %r15\n    movq (%r15), %rsi\n    subq $8, %r15\n    movq (%r15), %rdi\n    call sdev_fpow\n" + pushax
    end
    set fname to "sdev_fsin"
    if m is 1
      set fname to "sdev_fcos"
    end
    if m is 2
      set fname to "sdev_ftan"
    end
    if m is 3
      set fname to "sdev_fexp"
    end
    if m is 4
      set fname to "sdev_flog"
    end
    return "    subq $8, %r15\n    movq (%r15), %rdi\n    call " + fname + "\n" + pushax
  end
  if op is 195
    return "    subq $8, %r15\n    movq (%r15), %rdi\n    call sdev_num\n" + pushax
  end
  if op is 255
    return "    jmp .Lmain_done\n"
  end
  return ""
end
#
# Translates a compiled SDEV v2 bytecode buffer (`bc`) and string pool (`pool`)
# directly into standalone System V AMD64 GAS assembly (`sdev_main`) that links
# against `bin/runtime.s` into a static Linux ELF binary with zero libc.

to x64_compile_bytecode with bc pool
  set n to length(bc)
  set chunks to mklist(n * 4 + 256)
  set ccnt to 0

  set chunks[ccnt] to "# Generated by lang/native/codegen_x64.sdev (100% pure SDEV)\n"
  set ccnt to ccnt + 1
  set chunks[ccnt] to "    .text\n    .globl sdev_main\nsdev_main:\n"
  set ccnt to ccnt + 1
  set chunks[ccnt] to "    pushq %rbp\n    movq %rsp, %rbp\n    pushq %r12\n    pushq %r13\n    pushq %r14\n    pushq %r15\n"
  set ccnt to ccnt + 1
  set chunks[ccnt] to "    leaq .Lbss_opstack(%rip), %r15\n    leaq .Lbss_locstack(%rip), %r14\n    leaq .Lbss_callstack(%rip), %r13\n"
  set ccnt to ccnt + 1

  set pool_seen to mklist(65536)
  set pool_list to mklist(4096)
  set pool_cnt to 0

  set pc to 0
  while pc < n
    set op to bc[pc]
    set chunks[ccnt] to ".Lpc_" + str(pc) + ":\n"
    set ccnt to ccnt + 1

    # Float + misc opcodes live in a helper so the main chain stays flat.
    set extra to x64_extra_op(bc, pc)
    if length(extra) > 0
      set chunks[ccnt] to extra
      set ccnt to ccnt + 1
      set pc to pc + x64_extra_len(op)
      continue
    end

    if op is 1
      set v to x64_sign32(bc[pc + 1], bc[pc + 2], bc[pc + 3], bc[pc + 4])
      set chunks[ccnt] to "    movq $" + str(v) + ", (%r15)\n    addq $8, %r15\n"
      set ccnt to ccnt + 1
      set pc to pc + 5
    else
      if op is 2
        set off to bc[pc + 1] + bc[pc + 2] * 256
        if pool_seen[off] is 0
          set pool_seen[off] to 1
          set pool_list[pool_cnt] to off
          set pool_cnt to pool_cnt + 1
        end
        set chunks[ccnt] to "    leaq .Lpool_" + str(off) + "(%rip), %rax\n    movq %rax, (%r15)\n    addq $8, %r15\n"
        set ccnt to ccnt + 1
        set pc to pc + 3
      else
        if op is 3
          set slot to bc[pc + 1]
          set chunks[ccnt] to "    movq .Lbss_globals+" + str(slot * 8) + "(%rip), %rax\n    movq %rax, (%r15)\n    addq $8, %r15\n"
          set ccnt to ccnt + 1
          set pc to pc + 2
        else
          if op is 4
            set slot to bc[pc + 1]
            set chunks[ccnt] to "    subq $8, %r15\n    movq (%r15), %rax\n    movq %rax, .Lbss_globals+" + str(slot * 8) + "(%rip)\n"
            set ccnt to ccnt + 1
            set pc to pc + 2
          else
            if op is 5
              set chunks[ccnt] to "    subq $8, %r15\n"
              set ccnt to ccnt + 1
              set pc to pc + 1
            else
              if op >= 16 and op <= 20
                set pop2 to "    subq $8, %r15\n    movq (%r15), %rcx\n    subq $8, %r15\n    movq (%r15), %rax\n"
                if op is 16
                  set pop2 to pop2 + "    addq %rcx, %rax\n"
                end
                if op is 17
                  set pop2 to pop2 + "    subq %rcx, %rax\n"
                end
                if op is 18
                  set pop2 to pop2 + "    imulq %rcx, %rax\n"
                end
                if op is 19
                  set pop2 to pop2 + "    cqto\n    idivq %rcx\n"
                end
                if op is 20
                  set pop2 to pop2 + "    cqto\n    idivq %rcx\n    movq %rdx, %rax\n"
                end
                set chunks[ccnt] to pop2 + "    movq %rax, (%r15)\n    addq $8, %r15\n"
                set ccnt to ccnt + 1
                set pc to pc + 1
              else
                if op >= 32 and op <= 37
                  set cinst to "sete"
                  if op is 33
                    set cinst to "setne"
                  end
                  if op is 34
                    set cinst to "setl"
                  end
                  if op is 35
                    set cinst to "setg"
                  end
                  if op is 36
                    set cinst to "setle"
                  end
                  if op is 37
                    set cinst to "setge"
                  end
                  set chunks[ccnt] to "    subq $8, %r15\n    movq (%r15), %rcx\n    subq $8, %r15\n    movq (%r15), %rax\n    cmpq %rcx, %rax\n    " + cinst + " %al\n    movzbq %al, %rax\n    movq %rax, (%r15)\n    addq $8, %r15\n"
                  set ccnt to ccnt + 1
                  set pc to pc + 1
                else
                  if op is 48
                    set chunks[ccnt] to "    subq $8, %r15\n    cmpq $0, (%r15)\n    sete %al\n    movzbq %al, %rax\n    movq %rax, (%r15)\n    addq $8, %r15\n"
                    set ccnt to ccnt + 1
                    set pc to pc + 1
                  else
                    if op is 64
                      set off to x64_sign16(bc[pc + 1] + bc[pc + 2] * 256)
                      set chunks[ccnt] to "    jmp .Lpc_" + str(pc + 3 + off) + "\n"
                      set ccnt to ccnt + 1
                      set pc to pc + 3
                    else
                      if op is 65
                        set off to x64_sign16(bc[pc + 1] + bc[pc + 2] * 256)
                        set chunks[ccnt] to "    subq $8, %r15\n    cmpq $0, (%r15)\n    je .Lpc_" + str(pc + 3 + off) + "\n"
                        set ccnt to ccnt + 1
                        set pc to pc + 3
                      else
                        if op is 80
                          set chunks[ccnt] to "    subq $8, %r15\n    movq (%r15), %rdi\n    call sdev_say_int\n"
                          set ccnt to ccnt + 1
                          set pc to pc + 1
                        else
                          if op is 81
                            set chunks[ccnt] to "    subq $8, %r15\n    movq (%r15), %rdi\n    call sdev_say_str\n"
                            set ccnt to ccnt + 1
                            set pc to pc + 1
                          else
                            if op is 96
                              set target to bc[pc + 1] + bc[pc + 2] * 256
                              set nargs to bc[pc + 3]
                              set next_pc to pc + 4
                              set call_s to "    leaq .Lpc_" + str(next_pc) + "(%rip), %rax\n    movq %rax, (%r13)\n    movq %r14, 8(%r13)\n    addq $16, %r13\n    addq $2048, %r14\n"
                              set call_s to call_s + "    movq %r14, %rdi\n    xorq %rax, %rax\n    movq $256, %rcx\n    rep stosq\n"
                              set ak to nargs - 1
                              while ak >= 0
                                set call_s to call_s + "    subq $8, %r15\n    movq (%r15), %rax\n    movq %rax, " + str(ak * 8) + "(%r14)\n"
                                set ak to ak - 1
                              end
                              set call_s to call_s + "    jmp .Lpc_" + str(target) + "\n"
                              set chunks[ccnt] to call_s
                              set ccnt to ccnt + 1
                              set pc to pc + 4
                            else
                              if op is 97
                                set chunks[ccnt] to "    subq $8, %r15\n    movq (%r15), %rax\n    subq $16, %r13\n    movq (%r13), %rcx\n    movq 8(%r13), %r14\n    movq %rax, (%r15)\n    addq $8, %r15\n    jmp *%rcx\n"
                                set ccnt to ccnt + 1
                                set pc to pc + 1
                              else
                                if op is 98
                                  set pc to pc + 2
                                else
                                  if op is 99
                                    set slot to bc[pc + 1]
                                    set chunks[ccnt] to "    movq " + str(slot * 8) + "(%r14), %rax\n    movq %rax, (%r15)\n    addq $8, %r15\n"
                                    set ccnt to ccnt + 1
                                    set pc to pc + 2
                                  else
                                    if op is 100
                                      set slot to bc[pc + 1]
                                      set chunks[ccnt] to "    subq $8, %r15\n    movq (%r15), %rax\n    movq %rax, " + str(slot * 8) + "(%r14)\n"
                                      set ccnt to ccnt + 1
                                      set pc to pc + 2
                                    else
                                      if op is 128
                                        set ln to bc[pc + 1] + bc[pc + 2] * 256
                                        set ls to "    movq $" + str(8 + ln * 8) + ", %rdi\n    call sdev_alloc\n    movq $" + str(ln) + ", (%rax)\n"
                                        set lk to ln - 1
                                        while lk >= 0
                                          set ls to ls + "    subq $8, %r15\n    movq (%r15), %rcx\n    movq %rcx, " + str(8 + lk * 8) + "(%rax)\n"
                                          set lk to lk - 1
                                        end
                                        set ls to ls + "    movq %rax, (%r15)\n    addq $8, %r15\n"
                                        set chunks[ccnt] to ls
                                        set ccnt to ccnt + 1
                                        set pc to pc + 3
                                      else
                                        if op is 129
                                          set chunks[ccnt] to "    subq $8, %r15\n    movq (%r15), %rax\n    subq $8, %r15\n    movq (%r15), %rcx\n    movq 8(%rcx,%rax,8), %rax\n    movq %rax, (%r15)\n    addq $8, %r15\n"
                                          set ccnt to ccnt + 1
                                          set pc to pc + 1
                                        else
                                          if op is 130
                                            set chunks[ccnt] to "    subq $8, %r15\n    movq (%r15), %rax\n    subq $8, %r15\n    movq (%r15), %rdx\n    subq $8, %r15\n    movq (%r15), %rcx\n    movq %rax, 8(%rcx,%rdx,8)\n"
                                            set ccnt to ccnt + 1
                                            set pc to pc + 1
                                          else
                                            if op is 131
                                              set chunks[ccnt] to "    subq $8, %r15\n    movq (%r15), %rax\n    movq (%rax), %rax\n    movq %rax, (%r15)\n    addq $8, %r15\n"
                                              set ccnt to ccnt + 1
                                              set pc to pc + 1
                                            else
                                              if op is 132
                                                set chunks[ccnt] to "    subq $8, %r15\n    movq (%r15), %rax\n    subq $8, %r15\n    movq (%r15), %rcx\n    movzbq 8(%rcx,%rax,1), %rax\n    movq %rax, (%r15)\n    addq $8, %r15\n"
                                                set ccnt to ccnt + 1
                                                set pc to pc + 1
                                              else
                                                if op is 135
                                                  set chunks[ccnt] to "    subq $8, %r15\n    movq (%r15), %rdi\n    call sdev_str_int\n    movq %rax, (%r15)\n    addq $8, %r15\n"
                                                  set ccnt to ccnt + 1
                                                  set pc to pc + 1
                                                else
                                                  if op is 136
                                                    set chunks[ccnt] to "    subq $8, %r15\n    movq (%r15), %rdi\n    call sdev_chr\n    movq %rax, (%r15)\n    addq $8, %r15\n"
                                                    set ccnt to ccnt + 1
                                                    set pc to pc + 1
                                                  else
                                                    if op is 137
                                                      set chunks[ccnt] to "    subq $8, %r15\n    movq (%r15), %rax\n    pushq %rax\n    leaq 8(,%rax,8), %rdi\n    call sdev_alloc\n    popq %rcx\n    movq %rcx, (%rax)\n    movq %rax, (%r15)\n    addq $8, %r15\n"
                                                      set ccnt to ccnt + 1
                                                      set pc to pc + 1
                                                    else
                                                      if op is 138
                                                        set chunks[ccnt] to "    call sdev_tnew\n    movq %rax, (%r15)\n    addq $8, %r15\n"
                                                        set ccnt to ccnt + 1
                                                        set pc to pc + 3
                                                      else
                                                        if op is 139
                                                          set chunks[ccnt] to "    subq $8, %r15\n    movq (%r15), %rdx\n    subq $8, %r15\n    movq (%r15), %rsi\n    movq -8(%r15), %rdi\n    call sdev_tset\n"
                                                          set ccnt to ccnt + 1
                                                          set pc to pc + 1
                                                        else
                                                          if op is 140
                                                            set chunks[ccnt] to "    subq $8, %r15\n    movq (%r15), %rsi\n    subq $8, %r15\n    movq (%r15), %rdi\n    call sdev_tget\n    movq %rax, (%r15)\n    addq $8, %r15\n"
                                                            set ccnt to ccnt + 1
                                                            set pc to pc + 1
                                                          else
                                                            if op is 141
                                                              set chunks[ccnt] to "    subq $8, %r15\n    movq (%r15), %rsi\n    subq $8, %r15\n    movq (%r15), %rdi\n    call sdev_thas\n    movq %rax, (%r15)\n    addq $8, %r15\n"
                                                              set ccnt to ccnt + 1
                                                              set pc to pc + 1
                                                            else
                                                              if op is 142
                                                                set chunks[ccnt] to "    subq $8, %r15\n    movq (%r15), %rdi\n    call sdev_tkeys\n    movq %rax, (%r15)\n    addq $8, %r15\n"
                                                                set ccnt to ccnt + 1
                                                                set pc to pc + 1
                                                              else
                                                                if op is 143
                                                                  set chunks[ccnt] to "    subq $8, %r15\n    movq (%r15), %rdi\n    call sdev_tvals\n    movq %rax, (%r15)\n    addq $8, %r15\n"
                                                                  set ccnt to ccnt + 1
                                                                  set pc to pc + 1
                                                                else
                                                                  if op is 144
                                                                    set chunks[ccnt] to "    subq $8, %r15\n    movq (%r15), %rsi\n    subq $8, %r15\n    movq (%r15), %rdi\n    call sdev_str_eq\n    movq %rax, (%r15)\n    addq $8, %r15\n"
                                                                    set ccnt to ccnt + 1
                                                                    set pc to pc + 1
                                                                  else
                                                                    if op is 145
                                                                      set chunks[ccnt] to "    subq $8, %r15\n    movq (%r15), %rsi\n    subq $8, %r15\n    movq (%r15), %rdi\n    call sdev_concat\n    movq %rax, (%r15)\n    addq $8, %r15\n"
                                                                      set ccnt to ccnt + 1
                                                                      set pc to pc + 1
                                                                    else
                                                                      if op is 146
                                                                        set chunks[ccnt] to "    subq $8, %r15\n    movq (%r15), %rdi\n    call sdev_upper\n    movq %rax, (%r15)\n    addq $8, %r15\n"
                                                                        set ccnt to ccnt + 1
                                                                        set pc to pc + 1
                                                                      else
                                                                        if op is 147
                                                                          set chunks[ccnt] to "    subq $8, %r15\n    movq (%r15), %rdi\n    call sdev_lower\n    movq %rax, (%r15)\n    addq $8, %r15\n"
                                                                          set ccnt to ccnt + 1
                                                                          set pc to pc + 1
                                                                        else
                                                                          if op is 148
                                                                            set chunks[ccnt] to "    subq $8, %r15\n    movq (%r15), %rdi\n    call sdev_trim\n    movq %rax, (%r15)\n    addq $8, %r15\n"
                                                                            set ccnt to ccnt + 1
                                                                            set pc to pc + 1
                                                                          else
                                                                            if op is 149
                                                                              set chunks[ccnt] to "    subq $8, %r15\n    movq (%r15), %rdx\n    subq $8, %r15\n    movq (%r15), %rsi\n    subq $8, %r15\n    movq (%r15), %rdi\n    call sdev_substr\n    movq %rax, (%r15)\n    addq $8, %r15\n"
                                                                              set ccnt to ccnt + 1
                                                                              set pc to pc + 1
                                                                            else
                                                                              if op is 150
                                                                                set chunks[ccnt] to "    subq $8, %r15\n    movq (%r15), %rsi\n    subq $8, %r15\n    movq (%r15), %rdi\n    call sdev_index_of\n    movq %rax, (%r15)\n    addq $8, %r15\n"
                                                                                set ccnt to ccnt + 1
                                                                                set pc to pc + 1
                                                                              else
                                                                                if op is 151
                                                                                  set chunks[ccnt] to "    subq $8, %r15\n    movq (%r15), %rsi\n    subq $8, %r15\n    movq (%r15), %rdi\n    call sdev_split\n    movq %rax, (%r15)\n    addq $8, %r15\n"
                                                                                  set ccnt to ccnt + 1
                                                                                  set pc to pc + 1
                                                                                else
                                                                                  if op is 152
                                                                                    set chunks[ccnt] to "    subq $8, %r15\n    movq (%r15), %rsi\n    subq $8, %r15\n    movq (%r15), %rdi\n    call sdev_join\n    movq %rax, (%r15)\n    addq $8, %r15\n"
                                                                                    set ccnt to ccnt + 1
                                                                                    set pc to pc + 1
                                                                                  else
                                                                                    if op is 153
                                                                                      set chunks[ccnt] to "    subq $8, %r15\n    movq (%r15), %rdx\n    subq $8, %r15\n    movq (%r15), %rsi\n    subq $8, %r15\n    movq (%r15), %rdi\n    call sdev_replace\n    movq %rax, (%r15)\n    addq $8, %r15\n"
                                                                                      set ccnt to ccnt + 1
                                                                                      set pc to pc + 1
                                                                                    else
                                                                                      if op is 154
                                                                                        set chunks[ccnt] to "    subq $8, %r15\n    movq (%r15), %rdi\n    call sdev_num\n    movq %rax, %xmm0\n    cvttsd2siq %xmm0, %rax\n    movq %rax, (%r15)\n    addq $8, %r15\n"
                                                                                        set ccnt to ccnt + 1
                                                                                        set pc to pc + 1
                                                                                      else
                                                                                        if op is 155
                                                                                          set chunks[ccnt] to "    subq $8, %r15\n    movq (%r15), %rax\n    movq %rax, %rcx\n    sarq $63, %rcx\n    xorq %rcx, %rax\n    subq %rcx, %rax\n    movq %rax, (%r15)\n    addq $8, %r15\n"
                                                                                          set ccnt to ccnt + 1
                                                                                          set pc to pc + 1
                                                                                        else
                                                                                          if op is 158
                                                                                            set chunks[ccnt] to "    subq $8, %r15\n    movq (%r15), %rdi\n    call sdev_range\n    movq %rax, (%r15)\n    addq $8, %r15\n"
                                                                                            set ccnt to ccnt + 1
                                                                                            set pc to pc + 1
                                                                                          else
                                                                                            if op is 159
                                                                                              set chunks[ccnt] to "    subq $8, %r15\n    movq (%r15), %rdi\n    call sdev_sum\n    movq %rax, (%r15)\n    addq $8, %r15\n"
                                                                                              set ccnt to ccnt + 1
                                                                                              set pc to pc + 1
                                                                                            else
                                                                                              if op is 164
                                                                                                set chunks[ccnt] to "    subq $8, %r15\n    movq (%r15), %xmm1\n    subq $8, %r15\n    movq (%r15), %xmm0\n    divsd %xmm1, %xmm0\n    movq %xmm0, (%r15)\n    addq $8, %r15\n"
                                                                                                set ccnt to ccnt + 1
                                                                                                set pc to pc + 1
                                                                                              else
                                                                                                if op is 168
                                                                                                  set chunks[ccnt] to "    subq $8, %r15\n    movq (%r15), %rdi\n    call sdev_i2f\n    movq %rax, (%r15)\n    addq $8, %r15\n"
                                                                                                  set ccnt to ccnt + 1
                                                                                                  set pc to pc + 1
                                                                                                else
                                                                                                  if op is 169
                                                                                                    set chunks[ccnt] to "    subq $8, %r15\n    movq (%r15), %rdi\n    call sdev_f2i\n    movq %rax, (%r15)\n    addq $8, %r15\n"
                                                                                                    set ccnt to ccnt + 1
                                                                                                    set pc to pc + 1
                                                                                                  else
                                                                                                    if op is 173
                                                                                                      set chunks[ccnt] to "    subq $8, %r15\n    movq (%r15), %rdi\n    call sdev_say_float\n"
                                                                                                      set ccnt to ccnt + 1
                                                                                                      set pc to pc + 1
                                                                                                    else
                                                                                                      if op is 176
                                                                                                        set chunks[ccnt] to "    subq $8, %r15\n    movq (%r15), %rdi\n    call sdev_read_file\n    movq %rax, (%r15)\n    addq $8, %r15\n"
                                                                                                        set ccnt to ccnt + 1
                                                                                                        set pc to pc + 1
                                                                                                      else
                                                                                                        if op is 177
                                                                                                          set chunks[ccnt] to "    subq $8, %r15\n    movq (%r15), %rsi\n    subq $8, %r15\n    movq (%r15), %rdi\n    call sdev_write_file\n    movq %rax, (%r15)\n    addq $8, %r15\n"
                                                                                                          set ccnt to ccnt + 1
                                                                                                          set pc to pc + 1
                                                                                                        else
                                                                                                          if op is 180
                                                                                                            set chunks[ccnt] to "    subq $8, %r15\n    movq (%r15), %rsi\n    subq $8, %r15\n    movq (%r15), %rdi\n    call sdev_fbyte\n    movq %rax, (%r15)\n    addq $8, %r15\n"
                                                                                                            set ccnt to ccnt + 1
                                                                                                            set pc to pc + 1
                                                                                                          else
                                                                                                            if op is 194
                                                                                                              set chunks[ccnt] to "    subq $8, %r15\n    movq (%r15), %rdi\n    call sdev_throw\n"
                                                                                                              set ccnt to ccnt + 1
                                                                                                              set pc to pc + 1
                                                                                                            else
                                                                                                              write_file("sdev:err", "x64: unsupported opcode " + str(op) + " at " + str(pc) + "\n")
                                                                                                              set chunks[ccnt] to "    jmp .Lmain_done\n"
                                                                                                              set ccnt to ccnt + 1
                                                                                                              set pc to pc + 1
                                                                                                            end
                                                                                                          end
                                                                                                        end
                                                                                                      end
                                                                                                    end
                                                                                                  end
                                                                                                end
                                                                                              end
                                                                                            end
                                                                                          end
                                                                                        end
                                                                                      end
                                                                                    end
                                                                                  end
                                                                                end
                                                                              end
                                                                            end
                                                                          end
                                                                        end
                                                                      end
                                                                    end
                                                                  end
                                                                end
                                                              end
                                                            end
                                                          end
                                                        end
                                                      end
                                                    end
                                                  end
                                                end
                                              end
                                            end
                                          end
                                        end
                                      end
                                    end
                                  end
                                end
                              end
                            end
                          end
                        end
                      end
                    end
                  end
                end
              end
            end
          end
        end
      end
    end
  end

  set chunks[ccnt] to ".Lmain_done:\n    xorq %rax, %rax\n    popq %r15\n    popq %r14\n    popq %r13\n    popq %r12\n    popq %rbp\n    ret\n"
  set ccnt to ccnt + 1

  set chunks[ccnt] to "    .section .rodata\n    .align 8\n"
  set ccnt to ccnt + 1

  set pi to 0
  while pi < pool_cnt
    set poff to pool_list[pi]
    set slen to pool[poff] + pool[poff + 1] * 256 + pool[poff + 2] * 65536 + pool[poff + 3] * 16777216
    set pstr to ".Lpool_" + str(poff) + ":\n    .quad " + str(slen) + "\n"
    set bi to 0
    while bi < slen
      set pstr to pstr + "    .byte " + str(pool[poff + 4 + bi]) + "\n"
      set bi to bi + 1
    end
    set pstr to pstr + "    .byte 0\n    .align 8\n"
    set chunks[ccnt] to pstr
    set ccnt to ccnt + 1
    set pi to pi + 1
  end

  set chunks[ccnt] to "    .bss\n    .align 8\n.Lbss_globals:\n    .space 2048\n.Lbss_opstack:\n    .space 65536\n.Lbss_locstack:\n    .space 4194304\n.Lbss_callstack:\n    .space 65536\n"
  set ccnt to ccnt + 1

  set out_list to mklist(ccnt)
  set oi to 0
  while oi < ccnt
    set out_list[oi] to chunks[oi]
    set oi to oi + 1
  end
  return join(out_list, "")
end
