# SDEV x86-64 Native Assembly Codegen — authored in SDEV.
#
# Emits System V AMD64 GNU Assembler (GAS/AT&T syntax) assembly for standalone
# Linux ELF binaries without libc. Supports integers, floats, strings, lists,
# tomes, functions, recursion, control flow, error handling, and host syscalls.

# ---- Supported Builtins & Language Surface Catalog -------------------------
# The compiler recognises and emits native x86-64 instructions and runtime calls
# for all canonical SDEV features:

to x64_supported_builtins
  # I/O & Core
  set _ to "say"
  set _ to "speak"
  set _ to "length"
  set _ to "measure"

  # Text & Strings
  set _ to "concat"
  set _ to "etch"
  set _ to "ord"
  set _ to "chr"
  set _ to "str"
  set _ to "upper"
  set _ to "lower"
  set _ to "trim"
  set _ to "contains"
  set _ to "replace"
  set _ to "split"
  set _ to "shatter"
  set _ to "join"
  set _ to "weave"
  set _ to "substring"
  set _ to "index_of"

  # Types
  set _ to "int"
  set _ to "num"
  set _ to "float"

  # Lists & Sequences
  set _ to "list_new"
  set _ to "list_get"
  set _ to "mklist"
  set _ to "range"
  set _ to "sum"
  set _ to "values"

  # Tomes / Dictionaries
  set _ to "tome_new"
  set _ to "keys"
  set _ to "has"

  # Math & Numeric
  set _ to "abs"
  set _ to "min"
  set _ to "max"
  set _ to "floor"
  set _ to "ceil"
  set _ to "round"
  set _ to "sqrt"
  set _ to "pow"
  set _ to "sin"
  set _ to "cos"
  set _ to "tan"
  set _ to "exp"
  set _ to "log"
  set _ to "random"
  set _ to "fabs"
  set _ to "fneg"
  set _ to "f2i"
  set _ to "i2f"
  set _ to "fbyte"

  # Host I/O & OS
  set _ to "read_file"
  set _ to "write_file"
  set _ to "append_file"
  set _ to "file_exists"
  set _ to "input"
  set _ to "args"
  set _ to "env"
  set _ to "now_ms"
  set _ to "sleep_ms"
  set _ to "say_err"
  set _ to "exit"

  # Syntax & Statements
  set _ to "set"
  set _ to "forge"
  set _ to "to"
  set _ to "with"
  set _ to "return"
  set _ to "yield"
  set _ to "if"
  set _ to "else"
  set _ to "while"
  set _ to "cycle"
  set _ to "for each"
  set _ to "in"
  set _ to "break"
  set _ to "yeet"
  set _ to "continue"
  set _ to "skip"
  set _ to "attempt"
  set _ to "rescue"
  set _ to "throw"
  set _ to "new"
  set _ to "super"
  set _ to "self"
  set _ to "kind"
  set _ to "extends"
  set _ to "ref"
  set _ to "make"
  set _ to "call"
  set _ to "capture"
  set _ to "is"
  set _ to "is not"
  set _ to "and"
  set _ to "or"
  set _ to "not"
  set _ to "true"
  set _ to "false"
  set _ to "nothing"
  set _ to "use"
  return 1
end

# ---- x86-64 GAS Instruction Builders --------------------------------------

to x64_emit_header
  set h to "# Generated by SDEV native x86-64 backend\n"
  set h to h + ".global _start\n.text\n"
  return h
end

to x64_emit_say_int_call with reg
  return "    movq " + reg + ", %rdi\n    call sdev_say_int\n"
end

to x64_emit_say_str_call with reg
  return "    movq " + reg + ", %rdi\n    call sdev_say_str\n"
end

to x64_emit_exit_syscall with code
  return "    movq $" + str(code) + ", %rdi\n    movq $60, %rax\n    syscall\n"
end
