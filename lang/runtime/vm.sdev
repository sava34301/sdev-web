# SDEV Bytecode Virtual Machine — authored in SDEV.
#
# A complete stack-based bytecode Virtual Machine and disassembler written in
# 100% pure SDEV. Implements the SDEV seed VM instruction set with operand stack,
# call frames, globals, and string pool lookup.

use "lang/bootstrap/seed_vm.sdev"

# ---- VM State Creation ----------------------------------------------------

to vm_create with bytecode pool
  set vm to {
    bc: bytecode,
    pool: pool,
    pc: 0,
    sp: 0,
    fp: 0,
    stack: mklist(1024),
    globals: mklist(256),
    locals: mklist(256),
    output: mklist(256),
    out_count: 0,
    halted: 0,
    error: ""
  }
  return vm
end

to vm_push with vm val
  set sp to vm["sp"]
  set stk to vm["stack"]
  set stk[sp] to val
  set vm["sp"] to sp + 1
  return 0
end

to vm_pop with vm
  set sp to vm["sp"] - 1
  set vm["sp"] to sp
  set stk to vm["stack"]
  return stk[sp]
end

# ---- Disassembler ---------------------------------------------------------

to vm_disassemble with bc
  set n to length(bc)
  set i to 0
  set lines to mklist(n)
  set count to 0
  while i < n
    set op to bc[i]
    if op is 1
      set v to bc[i + 1] + bc[i + 2] * 256 + bc[i + 3] * 65536 + bc[i + 4] * 16777216
      set lines[count] to str(i) + ": PUSH_I32 " + str(v)
      set i to i + 5
    else
      if op is 2
        set off to bc[i + 1] + bc[i + 2] * 256
        set lines[count] to str(i) + ": PUSH_STR @" + str(off)
        set i to i + 3
      else
        if op is 16
          set lines[count] to str(i) + ": ADD"
          set i to i + 1
        else
          if op is 17
            set lines[count] to str(i) + ": SUB"
            set i to i + 1
          else
            if op is 18
              set lines[count] to str(i) + ": MUL"
              set i to i + 1
            else
              if op is 80
                set lines[count] to str(i) + ": SAY_I32"
                set i to i + 1
              else
                if op is 81
                  set lines[count] to str(i) + ": SAY_STR"
                  set i to i + 1
                else
                  if op is 255
                    set lines[count] to str(i) + ": HALT"
                    set i to i + 1
                  else
                    set lines[count] to str(i) + ": OP_" + str(op)
                    set i to i + 1
                  end
                end
              end
            end
          end
        end
      end
    end
    set count to count + 1
  end
  set res to mklist(count)
  set j to 0
  while j < count
    set res[j] to lines[j]
    set j to j + 1
  end
  return res
end

# ---- Single Step Execution ------------------------------------------------

to vm_step with vm
  if vm["halted"] is 1
    return 0
  end
  set pc to vm["pc"]
  set bc to vm["bc"]
  if pc >= length(bc)
    set vm["halted"] to 1
    return 0
  end

  set op to bc[pc]

  # PUSH_I32
  if op is 1
    set v to bc[pc + 1] + bc[pc + 2] * 256 + bc[pc + 3] * 65536 + bc[pc + 4] * 16777216
    set _ to vm_push(vm, v)
    set vm["pc"] to pc + 5
    return 1
  end

  # POP
  if op is 5
    set _ to vm_pop(vm)
    set vm["pc"] to pc + 1
    return 1
  end

  # ADD
  if op is 16
    set b to vm_pop(vm)
    set a to vm_pop(vm)
    set _ to vm_push(vm, a + b)
    set vm["pc"] to pc + 1
    return 1
  end

  # SUB
  if op is 17
    set b to vm_pop(vm)
    set a to vm_pop(vm)
    set _ to vm_push(vm, a - b)
    set vm["pc"] to pc + 1
    return 1
  end

  # MUL
  if op is 18
    set b to vm_pop(vm)
    set a to vm_pop(vm)
    set _ to vm_push(vm, a * b)
    set vm["pc"] to pc + 1
    return 1
  end

  # SAY_I32
  if op is 80
    set val to vm_pop(vm)
    set cnt to vm["out_count"]
    set out to vm["output"]
    set out[cnt] to str(val)
    set vm["out_count"] to cnt + 1
    set vm["pc"] to pc + 1
    return 1
  end

  # HALT
  if op is 255
    set vm["halted"] to 1
    set vm["pc"] to pc + 1
    return 0
  end

  set vm["error"] to "unknown opcode: " + str(op)
  set vm["halted"] to 1
  return 0
end

# ---- Run Until Termination ------------------------------------------------

to vm_run with vm max_steps
  set steps to 0
  while vm["halted"] is 0
    if steps >= max_steps
      set vm["error"] to "step limit exceeded"
      return vm["output"]
    end
    set ok to vm_step(vm)
    set steps to steps + 1
  end
  return vm["output"]
end
