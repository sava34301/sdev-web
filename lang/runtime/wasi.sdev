# =============================================================================
# SDEV Runtime: WASI Component Model Binary Emitter (lang/runtime/wasi.sdev)
# Authored in 100% pure SDEV — compiled by the self-hosted SDEV compiler.
# =============================================================================

to wasi_emit_component_header
  # WebAssembly Component Model binary magic: \0asm (0x00, 0x61, 0x73, 0x6D) + version 0x0d 0x00 0x01 0x00
  set bytes to mklist(8)
  set bytes[0] to 0
  set bytes[1] to 97
  set bytes[2] to 115
  set bytes[3] to 109
  set bytes[4] to 13
  set bytes[5] to 0
  set bytes[6] to 1
  set bytes[7] to 0
  return bytes
end

to wasi_wit_interface with pkg_name iface_name fn_sig
  set out to "package " + concat(pkg_name, "") + ";\n\ninterface " + concat(iface_name, "") + " {\n  " + concat(fn_sig, "") + ";\n}\n\nworld sdev-component {\n  export " + concat(iface_name, "") + ";\n}"
  return concat(out, "")
end


to wasi_to_kebab with ident
  set n to length(ident)
  set out to ""
  set prev_ld to 0
  set i to 0
  while i < n
    set ch to substr(ident, i, 1)
    set c to ord(ident, i)
    if c is 95
      set out to out + "-"
      set prev_ld to 0
    else
      if c >= 65 and c <= 90
        if prev_ld is 1
          set out to out + "-"
        end
        set out to out + chr(c + 32)
        set prev_ld to 0
      else
        set out to out + ch
        if (c >= 97 and c <= 122) or (c >= 48 and c <= 57)
          set prev_ld to 1
        else
          set prev_ld to 0
        end
      end
    end
    set i to i + 1
  end
  return out
end

to wasi_push_list with xs val
  set n to length(xs)
  set out to mklist(n + 1)
  set i to 0
  while i < n
    set out[i] to xs[i]
    set i to i + 1
  end
  set out[n] to val
  return out
end

to wasi_encode_uleb128 with val
  set bytes to []
  set v to val
  set done to 0
  while done is 0
    set byte to v % 128
    set v to (v - byte) / 128
    if v > 0
      set byte to byte + 128
    else
      set done to 1
    end
    set bytes to wasi_push_list(bytes, byte)
  end
  return bytes
end

to wasi_generate_wit with module_name fn_specs
  set clean to wasi_to_kebab(module_name)
  if length(clean) is 0
    set clean to "sdev-module"
  end
  set lines to ["// Generated by SDEV WASI 0.2 Component Compiler", "package sdev:" + clean + "@0.2.0;", "", "interface runtime-exports {"]
  set n to length(fn_specs)
  if n is 0
    set lines to wasi_push_list(lines, "  /// Default entry point")
    set lines to wasi_push_list(lines, "  run: func() -> f64;")
  else
    set i to 0
    while i < n
      set fn to fn_specs[i]
      set fname to wasi_to_kebab(fn[0])
      set params to fn[1]
      set rtype to fn[2]
      set pstrs to []
      set np to length(params)
      set j to 0
      while j < np
        set pr to params[j]
        set pstrs to wasi_push_list(pstrs, wasi_to_kebab(pr[0]) + ": " + pr[1])
        set j to j + 1
      end
      set lines to wasi_push_list(lines, "  " + fname + ": func(" + join(pstrs, ", ") + ") -> " + rtype + ";")
      set i to i + 1
    end
  end
  set lines to wasi_push_list(lines, "}")
  set lines to wasi_push_list(lines, "")
  set lines to wasi_push_list(lines, "world " + clean + " {")
  set lines to wasi_push_list(lines, "  export runtime-exports;")
  set lines to wasi_push_list(lines, "}")
  return join(lines, "\n")
end

to wasi_binding_ts with world_name sample_fn sample_args ts_sigs
  set out to "// Node.js / TypeScript Host Binding (WASI 0.2 / WebAssembly)\n"
  set out to out + "import { readFile } from 'node:fs/promises';\n\n"
  set out to out + "export async function loadSdevComponent(wasmPath = './" + world_name + ".wasm') {\n"
  set out to out + "  const bytes = await readFile(wasmPath);\n"
  set out to out + "  const { instance } = await WebAssembly.instantiate(bytes, {});\n"
  set out to out + "  return instance.exports as {\n"
  set out to out + ts_sigs + "\n"
  set out to out + "  };\n}\n\n"
  set out to out + "// Usage:\n// const mod = await loadSdevComponent();\n// console.log(mod." + sample_fn + "(" + sample_args + "));\n"
  return out
end

to wasi_binding_py with world_name sample_fn sample_args
  set arg_tail to ""
  if length(sample_args) > 0
    set arg_tail to ", " + sample_args
  end
  set out to "# Python Host Binding (wasmtime-py / WASI 0.2 Component)\n"
  set out to out + "from wasmtime import Store, Module, Instance\n\n"
  set out to out + "def load_sdev_component(wasm_path: str = \"./" + world_name + ".wasm\"):\n"
  set out to out + "    store = Store()\n"
  set out to out + "    module = Module.from_file(store.engine, wasm_path)\n"
  set out to out + "    instance = Instance(store, module, [])\n"
  set out to out + "    return store, instance.exports(store)\n\n"
  set out to out + "if __name__ == \"__main__\":\n"
  set out to out + "    store, exports = load_sdev_component()\n"
  set out to out + "    result = exports[\"" + sample_fn + "\"](store" + arg_tail + ")\n"
  set out to out + "    print(\"" + sample_fn + " result:\", result)\n"
  return out
end

to wasi_binding_rust with sample_fn sample_args rust_param_types
  set arg_vals to ""
  if length(sample_args) > 0
    set arg_vals to sample_args + ".0"
  end
  set out to "// Rust Host Binding (wasmtime::component::bindgen! WASI 0.2)\n"
  set out to out + "use wasmtime::{Engine, Instance, Module, Store};\n\n"
  set out to out + "pub fn run_sdev_component(wasm_bytes: &[u8]) -> anyhow::Result<f64> {\n"
  set out to out + "    let engine = Engine::default();\n"
  set out to out + "    let module = Module::new(&engine, wasm_bytes)?;\n"
  set out to out + "    let mut store = Store::new(&engine, ());\n"
  set out to out + "    let instance = Instance::new(&mut store, &module, &[])?;\n"
  set out to out + "    let func = instance.get_typed_func::<(" + rust_param_types + "), f64>(&mut store, \"" + sample_fn + "\")?;\n"
  set out to out + "    Ok(func.call(&mut store, (" + arg_vals + "))?)\n}\n"
  return out
end

to wasi_binding_go with world_name sample_fn sample_args
  set arg_tail to ""
  if length(sample_args) > 0
    set arg_tail to ", " + sample_args
  end
  set out to "// Go Host Binding (wazero zero-dependency WebAssembly runtime)\npackage main\n\nimport (\n\t\"context\"\n\t\"fmt\"\n\t\"os\"\n\t\"github.com/tetratelabs/wazero\"\n)\n\nfunc main() {\n\tctx := context.Background()\n\tr := wazero.NewRuntime(ctx)\n\tdefer r.Close(ctx)\n\twasmBytes, _ := os.ReadFile(\"./" + world_name + ".wasm\")\n\tmod, _ := r.Instantiate(ctx, wasmBytes)\n\tfn := mod.ExportedFunction(\"" + sample_fn + "\")\n\tres, _ := fn.Call(ctx" + arg_tail + ")\n\tfmt.Println(\"" + sample_fn + ":\", res)\n}\n"
  return out
end
