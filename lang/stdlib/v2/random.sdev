# SDEV Standard Library: Random & Pseudo-RNG (v2) — authored in SDEV.

to rng_make with seed
  set s to seed
  if s <= 0
    set s to 12345
  end
  return { state: s }
end

# Linear Congruential Generator (LCG) step: (state * 1103515245 + 12345) % 2147483648
to rng_next with rng
  set s to (rng["state"] * 1103515245 + 12345) % 2147483647
  if s < 0
    set s to 0 - s
  end
  set rng["state"] to s
  return s
end

to rng_int_range with rng min_val max_val
  if min_val >= max_val
    return min_val
  end
  set r to rng_next(rng)
  set span to max_val - min_val + 1
  return min_val + (r % span)
end

to rng_choice with rng xs
  set n to length(xs)
  if n is 0
    return 0
  end
  set idx to rng_int_range(rng, 0, n - 1)
  return xs[idx]
end
