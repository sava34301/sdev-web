# =============================================================================
# SDEV Standard Library: Byte Buffers, Hex, Base64 & Hashing
# (lang/stdlib/v2/buffer.sdev)
# Authored in 100% pure SDEV — compiled by the self-hosted SDEV compiler.
# =============================================================================

use "lang/stdlib/v2/text.sdev"
use "lang/stdlib/v2/bits.sdev"

to buf_from_str with s
  set n to length(s)
  set b to mklist(n)
  set i to 0
  while i < n
    set b[i] to ord(s, i)
    set i to i + 1
  end
  return b
end

to buf_to_str with b
  set n to length(b)
  set out to ""
  set i to 0
  while i < n
    set out to out + chr(b[i])
    set i to i + 1
  end
  return concat(out, "")
end

to buf_len with b
  return length(b)
end

to buf_get with b idx
  return b[idx]
end

to buf_set with b idx val
  set b[idx] to val % 256
  return b
end

to buf_slice with b start_idx end_idx
  set count to end_idx - start_idx
  if count < 0
    set count to 0
  end
  set out to mklist(count)
  set i to 0
  while i < count
    set out[i] to b[start_idx + i]
    set i to i + 1
  end
  return out
end

to buf_concat with a b
  set na to length(a)
  set nb to length(b)
  set out to mklist(na + nb)
  set i to 0
  while i < na
    set out[i] to a[i]
    set i to i + 1
  end
  set j to 0
  while j < nb
    set out[na + j] to b[j]
    set j to j + 1
  end
  return out
end

to buf_equals with a b
  set na to length(a)
  if na is not length(b)
    return 0
  end
  set i to 0
  while i < na
    if a[i] is not b[i]
      return 0
    end
    set i to i + 1
  end
  return 1
end

to buf_to_hex with b
  set n to length(b)
  set out to ""
  set i to 0
  while i < n
    set hx to bits_to_hex(b[i])
    if length(hx) is 1
      set hx to "0" + hx
    end
    set out to out + hx
    set i to i + 1
  end
  return concat(out, "")
end

to buf_from_hex with hex_str
  set clean to trim(hex_str)
  set n to length(clean) / 2
  set out to mklist(n)
  set i to 0
  while i < n
    set pair to substr(clean, i * 2, 2)
    set out[i] to bits_from_hex(pair)
    set i to i + 1
  end
  return out
end

to base64_encode with s
  set alpha to "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
  set n to length(s)
  set out to ""
  set i to 0
  while i < n
    set b0 to ord(s, i)
    set rem to n - i
    set b1 to 0
    set b2 to 0
    if rem > 1
      set b1 to ord(s, i + 1)
    end
    if rem > 2
      set b2 to ord(s, i + 2)
    end
    set triplet to b0 * 65536 + b1 * 256 + b2
    set c0 to (triplet / 262144) % 64
    set c1 to (triplet / 4096) % 64
    set c2 to (triplet / 64) % 64
    set c3 to triplet % 64
    set out to out + substr(alpha, c0, 1) + substr(alpha, c1, 1)
    if rem > 1
      set out to out + substr(alpha, c2, 1)
    else
      set out to out + "="
    end
    if rem > 2
      set out to out + substr(alpha, c3, 1)
    else
      set out to out + "="
    end
    set i to i + 3
  end
  return concat(out, "")
end

to base64_decode with b64_str
  set alpha to "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
  set n to length(b64_str)
  set out to ""
  set i to 0
  while i + 3 < n
    set ch0 to substr(b64_str, i, 1)
    set ch1 to substr(b64_str, i + 1, 1)
    set ch2 to substr(b64_str, i + 2, 1)
    set ch3 to substr(b64_str, i + 3, 1)
    set v0 to find(alpha, ch0)
    set v1 to find(alpha, ch1)
    set v2 to 0
    if str_eq(ch2, "=") is 0
      set v2 to find(alpha, ch2)
    end
    set v3 to 0
    if str_eq(ch3, "=") is 0
      set v3 to find(alpha, ch3)
    end
    set triplet to v0 * 262144 + v1 * 4096 + v2 * 64 + v3
    set b0 to (triplet / 65536) % 256
    set b1 to (triplet / 256) % 256
    set b2 to triplet % 256
    set out to out + chr(b0)
    if str_eq(ch2, "=") is 0
      set out to out + chr(b1)
    end
    if str_eq(ch3, "=") is 0
      set out to out + chr(b2)
    end
    set i to i + 4
  end
  return concat(out, "")
end

to hash_djb2 with s
  set h to 5381
  set n to length(s)
  set i to 0
  while i < n
    set h to ((h * 33) + ord(s, i)) % 33554393
    set i to i + 1
  end
  return h
end

to hash_fnv1a_hex with s
  set h to hash_djb2(s)
  return concat(bits_to_hex(h), "")
end

# ── Arena Memory Operations (Pure SDEV) ───────────────────────────────────────

to buf_byte with val
  set b to val % 256
  if b < 0
    set b to b + 256
  end
  return b
end

to mem_arena_new with cap
  set a to mklist(3)
  set bytes to mklist(cap)
  set i to 0
  while i < cap
    set bytes[i] to 0
    set i to i + 1
  end
  set a[0] to bytes
  set a[1] to cap
  set a[2] to 0
  return a
end

to mem_arena_alloc with a n
  set cur to a[2]
  set next_off to cur + n
  if next_off > a[1]
    return 0 - 1
  end
  set a[2] to next_off
  return cur
end

to mem_arena_reset with a
  set a[2] to 0
  return 0
end

to mem_arena_poke_u8 with bytes ptr val
  set bytes[ptr] to buf_byte(val)
  return 0
end

to mem_arena_peek_u8 with bytes ptr
  return buf_byte(bytes[ptr])
end

to mem_arena_poke_i16 with bytes ptr val
  set u to val
  if u < 0
    set u to u + 65536
  end
  set b0 to u % 256
  set b1 to ((u - b0) / 256) % 256
  set bytes[ptr] to b0
  set bytes[ptr + 1] to b1
  return 0
end

to mem_arena_peek_i16 with bytes ptr
  set b0 to buf_byte(bytes[ptr])
  set b1 to buf_byte(bytes[ptr + 1])
  set v to b0 + b1 * 256
  if v >= 32768
    set v to v - 65536
  end
  return v
end

to mem_arena_poke_i32 with bytes ptr val
  set u to val
  if u < 0
    set u to u + 4294967296
  end
  set b0 to u % 256
  set r1 to (u - b0) / 256
  set b1 to r1 % 256
  set r2 to (r1 - b1) / 256
  set b2 to r2 % 256
  set r3 to (r2 - b2) / 256
  set b3 to r3 % 256
  set bytes[ptr] to b0
  set bytes[ptr + 1] to b1
  set bytes[ptr + 2] to b2
  set bytes[ptr + 3] to b3
  return 0
end

to mem_arena_peek_i32 with bytes ptr
  set b0 to buf_byte(bytes[ptr])
  set b1 to buf_byte(bytes[ptr + 1])
  set b2 to buf_byte(bytes[ptr + 2])
  set b3 to buf_byte(bytes[ptr + 3])
  set v to b0 + b1 * 256 + b2 * 65536 + b3 * 16777216
  if b3 >= 128
    set v to v - 4294967296
  end
  return v
end

to mem_arena_fill with bytes ptr n val
  set b to buf_byte(val)
  set i to 0
  while i < n
    set bytes[ptr + i] to b
    set i to i + 1
  end
  return 0
end

to mem_arena_copy with bytes dst src n
  set tmp to mklist(n)
  set i to 0
  while i < n
    set tmp[i] to bytes[src + i]
    set i to i + 1
  end
  set j to 0
  while j < n
    set bytes[dst + j] to tmp[j]
    set j to j + 1
  end
  return 0
end
