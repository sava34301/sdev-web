# SDEV Paradigms: Hardware & Embedded Transpiler — authored in SDEV.
#
# Transpiles SDEV embedded code (board blocks, pin definitions, hardware loops)
# directly into canonical Arduino C++ (.ino) code in 100% pure SDEV.

use "lang/stdlib/v2/text.sdev"

to hw_transpile_board with board_id sdev_code
  set out to "// Generated by SDEV Embedded Transpiler for " + board_id + "\n"
  set out to out + "#include <Arduino.h>\n\n"

  set lines to split(sdev_code, "\n")
  set n to length(lines)

  set in_setup to 0
  set in_loop to 0

  set out to out + "void setup() {\n"
  set out to out + "  Serial.begin(9600);\n"

  set i to 0
  while i < n
    set line to text_trim(lines[i])

    # pin <n> be output -> pinMode(n, OUTPUT);
    if text_starts_with(line, "pin ") and text_ends_with(line, " be output")
      set p to substr(line, 4, length(line) - 14)
      set out to out + "  pinMode(" + p + ", OUTPUT);\n"
    end

    # pin <n> be input -> pinMode(n, INPUT);
    if text_starts_with(line, "pin ") and text_ends_with(line, " be input")
      set p to substr(line, 4, length(line) - 13)
      set out to out + "  pinMode(" + p + ", INPUT);\n"
    end

    set i to i + 1
  end

  set out to out + "}\n\nvoid loop() {\n"

  set j to 0
  while j < n
    set line to text_trim(lines[j])

    # pin <n> be high -> digitalWrite(n, HIGH);
    if text_starts_with(line, "pin ") and text_ends_with(line, " be high")
      set p to substr(line, 4, length(line) - 12)
      set out to out + "  digitalWrite(" + p + ", HIGH);\n"
    end

    # pin <n> be low -> digitalWrite(n, LOW);
    if text_starts_with(line, "pin ") and text_ends_with(line, " be low")
      set p to substr(line, 4, length(line) - 11)
      set out to out + "  digitalWrite(" + p + ", LOW);\n"
    end

    # wait <n> ms -> delay(n);
    if text_starts_with(line, "wait ") and text_ends_with(line, " ms")
      set d to substr(line, 5, length(line) - 8)
      set out to out + "  delay(" + d + ");\n"
    end

    # speak(...) -> Serial.println(...);
    if text_starts_with(line, "speak(") and text_ends_with(line, ")")
      set msg to substr(line, 6, length(line) - 7)
      set out to out + "  Serial.println(" + msg + ");\n"
    end

    set j to j + 1
  end

  set out to out + "}\n"
  return out
end


to hw_strip_spans with source spans_list
  set ns to length(spans_list)
  if ns is 0
    return source
  end
  set out to ""
  set last to 0
  set slen to length(source)
  set i to 0
  while i < ns
    set sp to spans_list[i]
    set s_idx to sp[0]
    set e_idx to sp[1]
    set out to out + substr(source, last, s_idx - last)
    set k to s_idx
    while k < e_idx and k < slen
      if substr(source, k, 1) is "\n"
        set out to out + "\n"
      end
      set k to k + 1
    end
    set last to e_idx
    set i to i + 1
  end
  return out + substr(source, last, slen - last)
end
