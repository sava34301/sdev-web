# =============================================================================
# SDEV Official Website — Authored in 100% Self-Hosted SDEV
# (lang/web/sdev-website.sdev)
#
# Compiles and runs directly on the Self-Hosted SDEV Compiler (Seed VM):
#   node bin/sdevhost.mjs lang/web/sdev-website.sdev
# And in the Browser IDE / CLI Web Builder:
#   node bin/sdev.mjs build-web lang/web/sdev-website.sdev -o index.html
# =============================================================================

use "lang/stdlib/v2/web.sdev"

set _ to page("sdev — A programming language that builds itself")
set _ to web_meta("Write in plain words or 26 human languages. Self-hosted compiler, browser WebAssembly, bare-metal x86-64, and microcontroller hardware.", "/favicon.png")
set _ to theme("sdev-dark")

# ── 1. Sticky Navigation Header & Reading Progress Bar ──────────────────────
set nav_links to [{ label: "Try it", href: "#try" }, { label: "Features", href: "#features" }, { label: "Docs", href: "/docs" }, { label: "Dialects", href: "/dialects" }, { label: "IDE", href: "/ide" }]
set nav_actions to a_html("Sign in", "/auth", { class: "btn btn-ghost btn-sm" }) + a_html(raw("Open IDE " + inline_icon("arrow-right", "w-4 h-4")), "/ide", { class: "btn btn-primary btn-sm" })
set _ to navbar("sdev", "v2.0", nav_links, nav_actions)

# ── 2. Main Website Body ────────────────────────────────────────────────────
set _ to open_main({ id: "top" })

# ── Split Hero with Interactive Multi-Mode Code Demo ────────────────────────
set hero_title to raw("Write in <span class=\"italic text-primary\">plain words.</span><br>Run it anywhere.")
set hero_btns to a_html(raw("Open the browser IDE " + inline_icon("arrow-right", "w-4 h-4")), "/ide", { class: "btn btn-primary btn-lg" }) + a_html("Try it on this page", "#try", { class: "btn btn-secondary btn-lg" }) + a_html("Read the docs", "/docs", { class: "btn btn-ghost btn-lg" })
set hero_right to hero_demo_html()
set _ to hero_section("Self-hosted · 26 human languages · Browser, native & hardware", hero_title, "sdev is a programming language that understands natural sentences, translates 26 languages, and compiles itself to WebAssembly and native machine code with zero dependencies.", hero_btns, hero_right)

# ── 4-Column Count-Up Stats Band ────────────────────────────────────────────
set _ to stat_band([{ v: "26", l: "Human languages", d: "write in your native tongue" }, { v: "8", l: "KB seed runtime", d: "runs in any browser tab" }, { v: "87", l: "Self-compile checks", d: "byte-identical every time" }, { v: "0", l: "Dependencies", d: "in native builds — no libc" }])

# ── Sticky 3D "How It Works" Stack + Pipeline Scene ─────────────────────────
set _ to compiler_scene_3d()

# ── Interactive In-Page sdev Playground ─────────────────────────────────────
set _ to sdev_playground()

# ── Why sdev (Bento Grid with Pointer Spotlight & Keyword Switcher) ─────────
set _ to open_section({ id: "features", class: "max-w-[1240px] mx-auto px-6 py-24 md:py-28" })
set _ to open_div({ class: "reveal max-w-2xl" })
set _ to div("Why sdev", { class: "eyebrow" })
set _ to h2("Simple on the surface. Serious underneath.", { class: "mt-3 text-4xl md:text-5xl leading-tight" })
set _ to p("Everything you need to learn, build and ship — and every layer stays open for you to inspect.", { class: "mt-4 text-lg text-muted-foreground" })
set _ to end_div()

set self_compile_pre to "<pre class=\"mt-6 rounded-lg border p-4 font-mono text-xs text-muted-foreground overflow-x-auto\" style=\"background-color: hsl(var(--background) / 0.7); line-height: 1.75;\"><span class=\"text-primary\">$</span> sdev build compiler.sdev -o stage1\n<span class=\"text-primary\">$</span> ./stage1 compiler.sdev -o stage2\n<span class=\"text-primary\">$</span> cmp stage1 stage2\n<span class=\"text-brand-green\">identical · 87 of 87 checks passed</span></pre>"
set card1 to feature_card_html("It builds itself, byte for byte", "The compiler is written in sdev. Compile it with itself and the output never changes — every update must pass that check.", "recycle", 4, self_compile_pre)

set kw_slides to "<div class=\"mt-8 h-16 relative overflow-hidden\"><div class=\"kw\" id=\"kw-0\" data-active=\"true\"><span class=\"font-mono text-3xl text-foreground\">forge</span><span class=\"ml-auto text-sm text-muted-foreground\">English</span></div><div class=\"kw\" id=\"kw-1\"><span class=\"font-mono text-3xl text-foreground\">създай</span><span class=\"ml-auto text-sm text-muted-foreground\">Bulgarian</span></div><div class=\"kw\" id=\"kw-2\"><span class=\"font-mono text-3xl text-foreground\">forja</span><span class=\"ml-auto text-sm text-muted-foreground\">Spanish</span></div><div class=\"kw\" id=\"kw-3\"><span class=\"font-mono text-3xl text-foreground\">作る</span><span class=\"ml-auto text-sm text-muted-foreground\">Japanese</span></div><div class=\"kw\" id=\"kw-4\"><span class=\"font-mono text-3xl text-foreground\">schmiede</span><span class=\"ml-auto text-sm text-muted-foreground\">German</span></div></div>"
set kw_btns to "<div class=\"mt-4 flex flex-wrap gap-1\"><button type=\"button\" class=\"btn btn-ghost btn-sm language-choice\" data-kw-btn=\"0\" aria-pressed=\"true\" onclick=\"selectKeywordLang(0)\">English</button><button type=\"button\" class=\"btn btn-ghost btn-sm language-choice\" data-kw-btn=\"1\" aria-pressed=\"false\" onclick=\"selectKeywordLang(1)\">Bulgarian</button><button type=\"button\" class=\"btn btn-ghost btn-sm language-choice\" data-kw-btn=\"2\" aria-pressed=\"false\" onclick=\"selectKeywordLang(2)\">Spanish</button><button type=\"button\" class=\"btn btn-ghost btn-sm language-choice\" data-kw-btn=\"3\" aria-pressed=\"false\" onclick=\"selectKeywordLang(3)\">Japanese</button><button type=\"button\" class=\"btn btn-ghost btn-sm language-choice\" data-kw-btn=\"4\" aria-pressed=\"false\" onclick=\"selectKeywordLang(4)\">German</button></div>"
set card2 to feature_card_html("Code in your own language", "Keywords work in 26 human languages, and you can publish your own dialect.", "globe-2", 2, kw_slides + kw_btns)

set card3 to feature_card_html("Understands what you mean", "Type 'calculate 23 - 21' or 'ask for their name' and it just runs.", "wand-2", 2, "")
set card4 to feature_card_html("Browser and native", "Instant WebAssembly in any browser, small static binaries on your machine.", "layers", 2, "")
set card5 to feature_card_html("Machine learning built in", "Tensors, training loops and transformers, with GPU fast paths.", "cpu", 2, "")

set _ to bento_grid(card1 + card2 + card3 + card4 + card5)
set _ to end_section()

# ── Zigzag Showcase Sections ────────────────────────────────────────────────
set _ to open_section({ class: "border-t py-24 md:py-28" })
set _ to open_div({ class: "max-w-[1240px] mx-auto px-6 space-y-24" })

# Row 1: Beginner-friendly
set _ to open_div({ class: "grid lg:grid-cols-2 gap-12 items-center" })
set _ to open_div({ class: "reveal reveal-left" })
set _ to span(inline_icon("graduation-cap", "w-6 h-6"), { class: "text-primary" })
set _ to h2("Friendly enough for a first program.", { class: "mt-5 text-3xl md:text-4xl leading-tight" })
set _ to p("New programmers write the way they think. A mini quiz with a score takes a few lines — no rules to memorise first.", { class: "mt-4 text-lg text-muted-foreground leading-relaxed" })
set chk_ic to inline_icon("check", "w-5 h-5 text-primary inline-block")
set _ to ul_list([raw(chk_ic + " Plain-language input and output"), raw(chk_ic + " Clear error messages that suggest a fix"), raw(chk_ic + " Runs in the browser — nothing to install")], { class: "mt-6 space-y-2.5 text-muted-foreground" })
set _ to end_div()
set _ to open_div({ class: "reveal reveal-right" })
set _ to code_card("quiz.sdev", "score is 0\nask \"What is 2 + 2?\" as answer\nwhen answer is 4\n  add 1 to score\nsay \"You got [score] out of 1\"")
set _ to end_div()
set _ to end_div()

# Row 2: Production-ready
set _ to open_div({ class: "grid lg:grid-cols-2 gap-12 items-center" })
set _ to open_div({ class: "reveal reveal-left lg:order-2" })
set _ to span(inline_icon("rocket", "w-6 h-6"), { class: "text-primary" })
set _ to h2("Powerful enough to ship.", { class: "mt-5 text-3xl md:text-4xl leading-tight" })
set _ to p("The same language compiles to native x86-64, flashes firmware to hardware, and drives a full machine-learning stack.", { class: "mt-4 text-lg text-muted-foreground leading-relaxed" })
set _ to ul_list([raw(chk_ic + " Command-line tool, VS Code extension and desktop app"), raw(chk_ic + " Packages shared with one command"), raw(chk_ic + " Readable assembly output you can inspect")], { class: "mt-6 space-y-2.5 text-muted-foreground" })
set _ to end_div()
set _ to open_div({ class: "reveal reveal-right lg:order-1" })
set _ to code_card("terminal", "$ sdev native app.sdev -o app\n  compiled → app (x86-64, static, 18 KB)\n$ ./app\n  Server ready on :8080\n$ sdev ext publish my-dialect\n  published @you/my-dialect")
set _ to end_div()
set _ to end_div()

set _ to end_div()
set _ to end_section()

# ── Get Started Paths ───────────────────────────────────────────────────────
set _ to open_section({ class: "max-w-[1240px] mx-auto px-6 py-24 md:py-28" })
set _ to open_div({ class: "reveal text-center max-w-2xl mx-auto" })
set _ to div("Get started", { class: "eyebrow" })
set _ to h2("Pick how you want to work.", { class: "mt-3 text-4xl md:text-5xl leading-tight" })
set _ to end_div()
set _ to open_div({ class: "mt-14 grid gap-4 md:grid-cols-3" })

set path1 to "<a href=\"/ide\" class=\"path reveal\"><span class=\"text-primary\">" + web_icon_svg("monitor-dot", "w-6 h-6") + "</span><h3 class=\"mt-5 text-xl\">Browser IDE</h3><p class=\"mt-2 text-muted-foreground\">Files, terminal, debugger and an assistant. Nothing to install.</p><span class=\"path-cta\">Open the IDE " + web_icon_svg("arrow-right", "w-4 h-4") + "</span></a>"
set path2 to "<button type=\"button\" class=\"path reveal\" onclick=\"window.$sdev.copy('npm i -g sdev-lang');\"><span class=\"text-primary\">" + web_icon_svg("terminal", "w-6 h-6") + "</span><h3 class=\"mt-5 text-xl\">Command line</h3><p class=\"mt-2 text-muted-foreground font-mono text-sm\">npm i -g sdev-lang</p><span class=\"path-cta\">Copy command " + web_icon_svg("copy", "w-4 h-4") + "</span></button>"
set path3 to "<a href=\"/docs\" class=\"path reveal\"><span class=\"text-primary\">" + web_icon_svg("book-open", "w-6 h-6") + "</span><h3 class=\"mt-5 text-xl\">Documentation</h3><p class=\"mt-2 text-muted-foreground\">The sdev Book, the full reference and how the compiler works.</p><span class=\"path-cta\">Read the docs " + web_icon_svg("arrow-right", "w-4 h-4") + "</span></a>"
set _ to raw_html(path1 + path2 + path3)

set _ to end_div()
set _ to end_section()

# ── Final Call To Action ────────────────────────────────────────────────────
set _ to open_section({ class: "final" })
set _ to div("", { class: "hero-grid", "aria-hidden": "true" })
set _ to open_div({ class: "relative max-w-[1240px] mx-auto px-6 py-28 text-center reveal" })
set _ to h2("Start building in your browser.", { class: "text-4xl md:text-6xl leading-tight" })
set _ to p("Free and open source. Your first program is one click away.", { class: "mt-5 text-lg text-muted-foreground max-w-xl mx-auto" })
set _ to open_div({ class: "mt-9 flex flex-wrap justify-center gap-3" })
set _ to a_link(raw("Open the IDE " + inline_icon("arrow-right", "w-4 h-4")), "/ide", { class: "btn btn-primary btn-lg" })
set _ to a_link(raw(inline_icon("download", "w-4 h-4") + " Install & docs"), "/docs", { class: "btn btn-outline btn-lg" })
set _ to end_div()
set _ to end_div()
set _ to end_section()

# ── Footer ──────────────────────────────────────────────────────────────────
set footer_links to [{ label: "Docs", href: "/docs" }, { label: "Language design guide", href: "/docs/self-hosting-design-guide" }, { label: "IDE", href: "/ide" }, { label: "Account", href: "/account" }, { label: "Privacy", href: "/privacy" }, { label: "Terms", href: "/terms" }]
set _ to footer_section("sdev", "— a language that builds itself", footer_links, "SDEV Programming Language © 2026 by Sava Milanov · Built in sdev · CC BY-SA 4.0")

set _ to end_main()

# ── 3. Client-Side Interactivity Written in sdev (Transpiled to JS) ─────────
set _ to client_fn("selectKeywordLang", "idx", "set i to 0\nwhile i < 5\nif i is idx\ndom_attr(\"#kw-\" + str(i), \"data-active\", \"true\")\ndom_attr(\"[data-kw-btn='\" + str(i) + \"']\", \"aria-pressed\", \"true\")\nelse\ndom_attr(\"#kw-\" + str(i), \"data-active\", nope)\ndom_attr(\"[data-kw-btn='\" + str(i) + \"']\", \"aria-pressed\", \"false\")\nend\nset i to i + 1\nend")

# Activate passive scroll listener, IntersectionObserver reveals & spotlight
set _ to scroll_driver()
set _ to scroll_reveal()
set _ to pointer_spotlight()

set built_html to endpage()
say "✓ Built the complete sdev website in sdev!"
