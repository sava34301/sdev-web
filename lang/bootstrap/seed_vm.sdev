# ---- WebAssembly Binary Header & LEB128 Encoding -------------------------

to wasm_magic_bytes
  set out to mklist(8)
  set out[0] to 0
  set out[1] to 97
  set out[2] to 115
  set out[3] to 109
  set out[4] to 1
  set out[5] to 0
  set out[6] to 0
  set out[7] to 0
  return out
end

# Encodes an unsigned integer into unsigned LEB128 byte sequence
to leb128_encode_u32 with val
  set bytes to mklist(5)
  set count to 0
  set v to val
  set going to 1
  while going
    set b to v % 128
    set v to v / 128
    if v is 0
      set bytes[count] to b
      set count to count + 1
      set going to 0
    else
      set bytes[count] to b + 128
      set count to count + 1
    end
  end
  set res to mklist(count)
  set i to 0
  while i < count
    set res[i] to bytes[i]
    set i to i + 1
  end
  return res
end
