# SDEV self-hosted codegen (Milestone 5d, first slice).
#
# Compiles a program of `say <arith-expr>` statements to real seed-VM
# bytecode, entirely in SDEV. Emits the byte stream to a global buffer
# `bc` whose cell 0 holds the current count and cells 1..count hold bytes.
#
# The scripts/test-self-codegen.mjs driver reads the buffer via `say`,
# reconstructs it as a Uint8Array, feeds it into a fresh seed WASM instance,
# and verifies the executed output matches the JS bootstrap compiler's.
#
# Grammar this slice covers:
#   program := stmt (NL stmt)*
#   stmt    := 'say' expr
#   expr    := add
#   add     := mul (('+'|'-') mul)*
#   mul     := atom (('*'|'/') atom)*
#   atom    := INT | '(' expr ')'
#
# The next slice adds `set`, `if`, `while`, `to`, `return`.

# ---- character-class helpers ---------------------------------------------

to is_digit with c
  if c < 48
    return 0
  end
  if c > 57
    return 0
  end
  return 1
end

to is_alpha with c
  if c is 95
    return 1
  end
  if c >= 65
    if c <= 90
      return 1
    end
  end
  if c >= 97
    if c <= 122
      return 1
    end
  end
  return 0
end

to is_alnum with c
  if is_digit(c)
    return 1
  end
  return is_alpha(c)
end

to slice with src i j
  set out to ""
  while i < j
    set out to out + chr(ord(src, i))
    set i to i + 1
  end
  return out
end

to str_eq with a b
  set la to length(a)
  if la is not length(b)
    return 0
  end
  set i to 0
  while i < la
    if ord(a, i) is not ord(b, i)
      return 0
    end
    set i to i + 1
  end
  return 1
end

# ---- byte emitter (writes into the global `bc` list, count at bc[0]) -----

to emit_byte with b
  set bc[bc[0] + 1] to b
  set bc[0] to bc[0] + 1
  return 0
end

to emit_i32 with v
  emit_byte(v % 256)
  set v to v / 256
  emit_byte(v % 256)
  set v to v / 256
  emit_byte(v % 256)
  set v to v / 256
  emit_byte(v % 256)
  return 0
end

# ---- symbol table (global variable slots) --------------------------------
#
# The bootstrap seed VM uses u8 slot indices for LOAD/STORE, so we cap the
# table at 256 entries. The count is stored in the list itself at cell 0,
# so every mutation is an index-assignment — this sidesteps the bootstrap
# rule that "plain set NAME inside a function creates a fresh local":
#
#   sym_names[0]              = number of interned names
#   sym_names[1..count]       = the interned identifier strings
#
# Slot i (as consumed by LOAD/STORE opcodes) lives at sym_names[i+1].

to intern_name with name
  set k to 1
  set stop to sym_names[0] + 1
  while k < stop
    if str_eq(sym_names[k], name)
      return k - 1
    end
    set k to k + 1
  end
  set sym_names[sym_names[0] + 1] to name
  set sym_names[0] to sym_names[0] + 1
  return sym_names[0] - 1
end

# ---- recursive-descent parser that emits stack-VM bytecode as it goes ----

to is_op_c with pos c
  if pos >= tk_count
    return 0
  end
  if tk_kind[pos] is 4
    if tk_num[pos] is c
      return 1
    end
  end
  return 0
end

to parse_atom with pos
  if tk_kind[pos] is 1
    emit_byte(1)
    emit_i32(tk_num[pos])
    return pos + 1
  end
  if tk_kind[pos] is 2
    set slot to intern_name(tk_txt[pos])
    emit_byte(3)
    emit_byte(slot)
    return pos + 1
  end
  if is_op_c(pos, 40)
    set pos to parse_add(pos + 1)
    if is_op_c(pos, 41)
      return pos + 1
    end
    return pos
  end
  return pos
end

to parse_mul with pos
  set pos to parse_atom(pos)
  set going to 1
  while going
    if is_op_c(pos, 42)
      set pos to parse_atom(pos + 1)
      emit_byte(18)
    else
      if is_op_c(pos, 47)
        set pos to parse_atom(pos + 1)
        emit_byte(19)
      else
        set going to 0
      end
    end
  end
  return pos
end

to parse_add with pos
  set pos to parse_mul(pos)
  set going to 1
  while going
    if is_op_c(pos, 43)
      set pos to parse_mul(pos + 1)
      emit_byte(16)
    else
      if is_op_c(pos, 45)
        set pos to parse_mul(pos + 1)
        emit_byte(17)
      else
        set going to 0
      end
    end
  end
  return pos
end
