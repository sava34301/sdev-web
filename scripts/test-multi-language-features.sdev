# Multi-Language Parity Suite — authored in SDEV.
#
#   node bin/sdevhost.mjs scripts/test-multi-language-features.sdev

use "lang/stdlib/testkit.sdev"
use "lang/stdlib/v2/sql.sdev"
use "lang/paradigms/functional.sdev"
use "lang/paradigms/systems.sdev"
use "lang/paradigms/feature.sdev"
use "lang/stdlib/v2/func.sdev"

to run_snippet with code
  set p to ".tmp_snippet_mlf.sdev"
  set _ to write_file(p, code)
  set res to shell(concat("node bin/sdev.mjs run --no-agent ", p))
  set nl to find(res, "\n")
  set code_str to substr(res, 0, nl)
  set out to substr(res, nl + 1, length(res) - (nl + 1))
  set r to mklist(2)
  set r[0] to code_str
  set r[1] to trim(out)
  return r
end

# 1. String Interpolation
set q to chr(34)
set s1 to concat("forge user be ", concat(q, concat("Alice", concat(q, concat("\nforge items be 42\nforge msg be f", concat(q, concat("Hello, {user}! You have {items} items.", concat(q, "\nspeak(msg)"))))))))
set r1 to run_snippet(s1)
set ok1 to 0
if r1[0] is "0"
  if r1[1] is "Hello, Alice! You have 42 items."
    set ok1 to 1
  end
end
set _ to check("v1 interpreter string interpolation with variables", ok1)

# 2. Immutable `fixed` bindings
set r2 to run_snippet("fixed MAX_USERS be 100\nspeak(MAX_USERS)")
set ok2 to 0
if r2[0] is "0"
  if r2[1] is "100"
    set ok2 to 1
  end
end
set _ to check("fixed constant declaration and reading", ok2)

set r3 to run_snippet("fixed PI be 3.14\nPI be 3.14159")
set ok3 to 0
if r3[0] is not "0"
  set ok3 to 1
end
set _ to check("Reassignment of fixed binding throws error", ok3)

# 3. Scalar `match` statement on v2
set r4 to run_snippet("forge status be 200\nmatch status ::\n  case 200 ::\n    speak(\"OK\")\n  ;;\n  case 404 ::\n    speak(\"Not Found\")\n  ;;\n  case _ ::\n    speak(\"Other\")\n  ;;\n;;")
set ok4 to 0
if r4[0] is "0"
  if r4[1] is "OK"
    set ok4 to 1
  end
end
set _ to check("match statement branches correctly", ok4)

# 4. SQL Relational Engine
set rows to [{ id: 1, name: "Alice", val: 50 }, { id: 2, name: "Bob", val: 30 }]
set _ to check("SQL count", sql_count(rows) is 2)
set _ to check("SQL sum", sql_sum(rows, "val") is 80)
set _ to check("SQL max", sql_max(rows, "val") is 50)
set _ to check("SQL min", sql_min(rows, "val") is 30)

# 5. Systems Arena Memory
set a to arena_create(256)
set p to arena_alloc(a, 16)
set _ to mem_poke_u8(a, p, 200)
set _ to check("Arena poke/peek u8", mem_peek_u8(a, p) is 200)
set _ to mem_poke_i16(a, p + 2, 32000)
set _ to check("Arena poke/peek i16", mem_peek_i16(a, p + 2) is 32000)
set _ to mem_poke_i32(a, p + 4, 1000000)
set _ to check("Arena poke/peek i32", mem_peek_i32(a, p + 4) is 1000000)

# 6. Functional ADTs (Option & Result)
set opt to Some(42)
set _ to check("Option is_some", is_some(opt) is 1)
set _ to check("Option unwrap", unwrap_or(opt, 0) is 42)
set res_ok to Ok("success")
set _ to check("Result is_ok", is_ok(res_ok) is 1)
set _ to check("Result unwrap", result_unwrap_or(res_ok, "err") is "success")

# 7. Feature-Oriented Programming (FOP) Pure Self-Hosted
set f_core to feature_create("core", [], [])
set _ to feature_add_field(f_core, "ver", 1)
set f_auth to feature_create("auth", ["core"], [])
set _ to feature_add_field(f_auth, "scheme", "token")
set f_comp to feature_compose([f_core, f_auth])
set _ to check("Feature compose merges name and fields", f_comp["name"] is "core+auth" and f_comp["fields"]["scheme"] is "token")

set f_mdl to feature_model_create("Product")
set _ to feature_model_add(f_mdl, "core", 1)
set _ to feature_model_add(f_mdl, "auth", 0)
set _ to feature_model_add(f_mdl, "legacy", 0)
set _ to feature_model_require(f_mdl, "auth", "core")
set _ to feature_model_exclude(f_mdl, "auth", "legacy")
set val_ok to feature_model_validate(f_mdl, ["core", "auth"])
set val_bad to feature_model_validate(f_mdl, ["auth", "legacy"])
set _ to check("SPL model valid selection", val_ok["valid"] is 1)
set _ to check("SPL model detects conflict and missing mandatory", val_bad["valid"] is 0)
set reg to feature_registry_create()
set _ to feature_enable_in(reg, "auth")
set _ to check("SPL registry enable/check", feature_is_enabled_in(reg, "auth") is 1)

# 8. Function-Oriented Programming (FP) Stdlib v2
to _mlf_inc with x
  return x + 1
end
to _mlf_dbl with x
  return x * 2
end
to _mlf_even with x
  return x % 2 is 0
end
set mapped to func_map([1, 2, 3], ref _mlf_dbl)
set evens to func_filter([1, 2, 3, 4], ref _mlf_even)
set _ to check("func_map doubles list", mapped[0] is 2 and mapped[2] is 6)
set _ to check("func_filter keeps evens", length(evens) is 2 and evens[1] is 4)
set _ to check("func_pipe2 threads value", func_pipe2(5, ref _mlf_inc, ref _mlf_dbl) is 12)

# Cleanup scratch
set _ to write_file(".tmp_snippet_mlf.sdev", "")

set _ to tk_report("multi-language features suite")
