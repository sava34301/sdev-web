say "\n================================================================"
if total_failed is 0
  say concat("  All ", concat(str(total_passed), " SDEV Self-Hosted Test Suites Passed Successfully!"))
  say "================================================================\n"
  set _ to write_file("sdev:exit:0", "")
else
  say concat("  Test Run FAILED: ", concat(str(total_failed), " suite(s) failed."))
  say "================================================================\n"
  set _ to write_file("sdev:exit:1", "")
end
