# ================================================================
# SDEV Self-Hosted Language Core Test Runner — authored in SDEV
#
# Runs all self-hosted compiler, VM, runtime, stdlib, subsystems,
# native PE generator, and parity test suites sequentially.
#
#   node bin/sdevhost.mjs scripts/test-all.sdev
# ================================================================

use "lang/stdlib/testkit.sdev"

to run_suite with name cmd
  say concat("\n▶ [Running] ", concat(name, "..."))
  set res to shell(cmd)
  set nl to find(res, "\n")
  set status_code to substr(res, 0, nl)
  set output to substr(res, nl + 1, length(res) - (nl + 1))
  if length(output) > 0
    say output
  end
  if status_code is "0"
    say concat("✓ [PASSED] ", name)
    return 1
  else
    say concat("✗ [FAILED] ", concat(name, concat(" (exit code ", concat(status_code, ")"))))
    return 0
  end
end

say "================================================================"
say "  Running SDEV Self-Hosted Language Core Test Suites"
say "================================================================"

set total_passed to 0
set total_failed to 0

# 1. Toolchain
set ok to run_suite("Toolchain (Lexer/Parser/Codegen)", "node bin/sdevhost.mjs scripts/test-self-toolchain.sdev")
if ok is 1
  set total_passed to total_passed + 1
else
  set total_failed to total_failed + 1
end

# 2. Driver Artifact
set ok to run_suite("Driver Artifact", "node bin/sdevhost.mjs scripts/test-driver-artifact.sdev")
if ok is 1
  set total_passed to total_passed + 1
else
  set total_failed to total_failed + 1
end

# 3. Self-Hosted Lexer
set ok to run_suite("Self-Hosted Lexer", "node bin/sdevhost.mjs scripts/test-self-lexer.sdev")
if ok is 1
  set total_passed to total_passed + 1
else
  set total_failed to total_failed + 1
end

# 4. Self-Hosted Parser
