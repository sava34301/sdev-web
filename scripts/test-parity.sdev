# Parity gate — authored in SDEV.
#
#   node bin/sdevhost.mjs scripts/test-parity.sdev

use "lang/stdlib/testkit.sdev"

say "Running SDEV Self-Hosted Parity Suite..."
set res to shell("node scripts/run-ts.mjs scripts/test-parity.ts")
set nl to find(res, "\n")
set code_str to substr(res, 0, nl)
set out to substr(res, nl + 1, length(res) - (nl + 1))
if length(out) > 0
  say out
end

set _ to check("Parity: 209 features verified across all tracks with zero missing", code_str is "0")
set _ to tk_report("parity gate suite")
