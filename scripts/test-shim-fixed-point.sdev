# Milestone 5l / Milestone A+B gate — shim fixed-point verification in SDEV.
#
#   node bin/sdevhost.mjs scripts/test-shim-fixed-point.sdev
#
# Runs the full 88-case fixed-point suite through lang/compiler/codegen.sdev
# in-process and verifies exact bytecode + string-pool lengths and byte
# digests against the bootstrap oracle, plus verifies live execution of
# Milestone A string equality and full-file byte-identity between the shim
# and bootstrap oracle.
#
# host-prefetch: sdev:compile:self:scripts/test-shim-fixed-point.sdev
# host-prefetch: sdev:compile:boot:scripts/test-shim-fixed-point.sdev

use "lang/stdlib/testkit.sdev"
use "lang/compiler/codegen.sdev"

set tk_kind to mklist(4000)
set tk_num  to mklist(4000)
set tk_num2 to mklist(4000)
set tk_txt  to mklist(4000)
set tk_count to 0

set bc to mklist(16384)
set bc[0] to 0
set sym_names to mklist(256)
set sym_names[0] to 0
set sym_types to mklist(256)
