set fe_depth to mklist(2)
set fe_depth[0] to 0
set cls_names to mklist(64)
set cls_names[0] to 0
set mth_cls to mklist(256)
set mth_cls[0] to 0
set mth_key to mklist(256)
set mth_key[0] to 0
set mth_fn to mklist(256)
set mth_fn[0] to 0
set mth_sup to mklist(256)
set mth_sup[0] to 0
set last_id to mklist(2)
set last_id[0] to ""

set fp_srcs to split("say 42\n~\nsay 1 + 2 * 3\n~\nsay (1 + 2) * 3\n~\nsay 1\nsay 2\nsay 3\n~\nsay ((10 + 20) * (30 - 4)) / 5\n~\nsay 100 - 1 - 2 - 3\n~\nset x to 7\nsay x\n~\nset a to 3 + 4\nset b to a * 2\nsay a\nsay b\n~\nset s to 0\nset s to s + 10\nset s to s + 20\nset s to s + 30\nsay s\n~\nset x to 5\nset y to 6\nsay x * y + x\n~\nsay 5 is 5\nsay 5 is 4\n~\nsay 5 is not 5\nsay 5 is not 4\n~\nsay 3 < 5\nsay 3 > 5\n~\nsay 3 <= 3\nsay 3 >= 4\n~\nset x to 10\nif x is 10\nsay 111\nend\nsay 999\n~\nset x to 1\nif x is 1\nsay 100\nelse\nsay 200\nend\n~\nset x to 2\nif x is 1\nsay 100\nelse\nsay 200\nend\n~\nset i to 0\nwhile i < 5\nsay i\nset i to i + 1\nend\nsay 999\n~\nset i to 1\nset s to 0\nwhile i <= 10\nset s to s + i\nset i to i + 1\nend\nsay s\n~\nto answer\nreturn 42\nend\nsay answer()\n~\nto sq with x\nreturn x * x\nend\nsay sq(5)\nsay sq(9)\n~\nto add with a b\nreturn a + b\nend\nsay add(3, 4)\nsay add(10, 20)\n~\nto hyp with a b\nset s to a * a + b * b\nreturn s\nend\nsay hyp(3, 4)\n~\nto sq with x\nreturn x * x\nend\nto sum_sq with a b\nreturn sq(a) + sq(b)\nend\nsay sum_sq(3, 4)\n~\nto fact with n\nif n < 2\nreturn 1\nend\nreturn n * fact(n - 1)\nend\nsay fact(6)\n~\nto fib with n\nif n < 2\nreturn n\nend\nreturn fib(n - 1) + fib(n - 2)\nend\nsay fib(10)\n~\nset base to 100\nto shift with x\nreturn x + base\nend\nsay shift(5)\nsay shift(7)\n~\nset xs to mklist(5)\nsay length(xs)\n~\nsay \"hello\"\n~\nsay \"foo\" + \"bar\"\n~\nset a to \"hi\"\nset b to \" there\"\nsay a + b\n~\nsay str(42) + str(58)\n~\nsay chr(65) + chr(90)\nsay ord(\"Z\", 0)\n~\nset xs to [10, 20, 30, 40]\nsay xs[0]\nsay xs[1]\nsay xs[3]\n~\nset xs to [7, 7, 7, 7, 7]\nsay length(xs)\n~\nset xs to [1, 2, 3, 4, 5]\nsay xs[2] * xs[4] + xs[0]\n~\nset xs to mklist(4)\nset xs[0] to 100\nset xs[1] to 200\nset xs[2] to xs[0] + xs[1]\nsay xs[2]\n~\nset s to \"\"\nsay length(s)\n~\nset i to 0\nwhile i < 3\nsay \"tick\"\nset i to i + 1\nend\n~\nsay greet()\nto greet\nreturn 7\nend\n~\nto double with x\nreturn x * 2\nend\nsay double(3) + double(4)\n~\nto hi\nreturn \"hello\"\nend\nsay hi()\n~\nto hi\nreturn \"hi \"\nend\nto you\nreturn \"you\"\nend\nsay hi() + you()\n~\nfor each x in [10, 20, 30]\nsay x\nend\n~\nset xs to [1, 2, 3, 4, 5]\nfor each x in xs\nif x is 2\ncontinue\nend\nif x is 4\nbreak\nend\nsay x\nend\n~\nfor each a in [1, 2]\nfor each b in [10, 20]\nsay a * b\nend\nend\n~\nset i to 0\nwhile i < 10\nset i to i + 1\nif i is 3\ncontinue\nend\nif i > 5\nbreak\nend\nsay i\nend\n~\nset a to 5\nif a is 1\nsay 100\nelse if a is 5\nsay 55\nelse\nsay 0\nend\nsay 7\n~\nto total with xs\nset t to 0\nfor each v in xs\nset t to t + v\nend\nreturn t\nend\nsay total([1, 2, 3, 4])\n~\nset t to {\"a\": 1, \"b\": 2}\nsay t[\"a\"]\nsay t[\"b\"]\nsay length(t)\n~\nset t to {name: \"sdev\", kind: \"lang\"}\nsay t[\"name\"]\nsay t[\"kind\"]\n~\nset t to {}\nset t[\"x\"] to 9\nsay t[\"x\"]\nsay length(t)\n~\nset t to {\"a\": 1, \"b\": 2}\nfor each k in keys(t)\nsay k\nend\n~\nset t to {\"a\": \"x\", \"b\": \"y\"}\nfor each v in values(t)\nsay v\nend\n~\nset t to {\"a\": 1}\nsay has(t, \"a\")\nsay has(t, \"z\")\n~\nset t to {\"a\": 1, \"b\": 2}\nfor each k in keys(t)\nsay k + \"=\" + str(t[k])\nend\n~\nto lookup with t k\nreturn t[k]\nend\nset t to {\"q\": 42}\nsay lookup(t, \"q\")\n~\nset t to {\"n\": {\"deep\": 7}}\nsay length(t)\n~\nset t to {}\nset i to 0\nwhile i < 12\nset t[str(i)] to i * i\nset i to i + 1\nend\nsay length(t)\nsay t[\"11\"]\n~\nsay upper(\"abC\")\nsay lower(\"AbC\")\nsay trim(\"  hi  \") + \"|\"\n~\nsay substr(\"hello world\", 6, 5)\nsay find(\"hello\", \"ll\")\nsay contains(\"hello\", \"ell\")\n~\nfor each p in split(\"a,b,c\", \",\")\nsay p\nend\n~\nsay join(split(\"a,b,c\", \",\"), \"-\")\nsay replace(\"a-b-a\", \"a\", \"X\")\n~\nsay int(\"42\") + 1\nsay abs(0 - 5)\nsay min(3, 9)\nsay max(3, 9)\n~\nsay sum(range(5))\nfor each i in range(3)\nsay i\nend\n~\nsay fceil(1.2)\nsay ffloor(1.8)\nsay fround(1.5)\n~\nattempt\nsay \"a\"\nthrow \"boom\"\nrescue e\nsay e\nend\nsay \"z\"\n~\nattempt\nsay 1\nrescue\nsay 2\nend\n~\nattempt\nattempt\nthrow \"i\"\nrescue a\nsay a\nthrow \"o\"\nend\nrescue b\nsay b\nend\n~\nto f\nthrow \"deep\"\nreturn 0\nend\nattempt\nsay f()\nrescue e\nsay e\nend\n~\nsay num(\"3.5\") + 0.5\nsay f2i(num(\"42.9\"))\n~\nto twice with n\nreturn n * 2\nend\nset f to ref twice\nsay call f(21)\n~\nto inc with n\nreturn n + 1\nend\nto ap with fn v\nreturn call fn(v)\nend\nsay ap(ref inc, 5)\n~\nto a\nreturn 1\nend\nto b\nreturn 2\nend\nset xs to [ref a, ref b]\nfor each g in xs\nsay call g()\nend\n~\nset f to make with a\nreturn a + 1\nend\nsay call f(41)\n~\nset n to 10\nset add to make with a capture n\nreturn a + n\nend\nsay call add(5)\n~\nset k to 2\nset f to make with x capture k\nset t to x * k\nreturn t + 1\nend\nsay call f(20)\n~\nto ap with g v\nreturn call g(v)\nend\nset b to 3\nsay ap(make with x capture b\nreturn x + b\nend, 4)\n~\nkind Box\nto put with self v\nset self.v to v\nreturn 0\nend\nto get with self\nreturn self.v\nend\nend\nset b to new Box()\nb.put(9)\nsay b.get()\n~\nkind P\nto init with self x y\nset self.x to x\nset self.y to y\nreturn 0\nend\nto sum with self\nreturn self.x + self.y\nend\nend\nset p to new P\np.init(3, 4)\nsay p.sum()\nsay p.x\n~\nkind Greeter\nto hello with self who\nreturn \"hi \" + who\nend\nend\nset g to new Greeter()\nsay g.hello(\"sdev\")\n~\nkind Counter\nto step with self\nset self.n to self.n + 1\nif self.n > 2\nreturn 100\nelse if self.n > 1\nreturn 10\nelse\nreturn 1\nend\nend\nend\nset c to new Counter()\nset c.n to 0\nsay c.step()\nsay c.step()\nsay c.step()\n~\nkind A\nto one with self\nreturn 1\nend\nend\nkind B\nto two with self\nreturn 2\nend\nend\nset a to new A()\nset b to new B()\nsay a.one() + b.two()\n~\nkind Animal\nto legs with self\nreturn 4\nend\nend\nkind Dog extends Animal\nto name with self\nreturn \"dog\"\nend\nend\nset d to new Dog()\nsay d.legs()\nsay d.name()\n~\nkind Animal\nto name with self\nreturn \"animal\"\nend\nend\nkind Dog extends Animal\nto name with self\nreturn \"dog/\" + super.name()\nend\nend\nset d to new Dog()\nsay d.name()\n~\nkind A\nto tag with self\nreturn \"A\"\nend\nend\nkind B extends A\nto tag with self\nreturn \"B\" + super.tag()\nend\nend\nkind C extends B\nto tag with self\nreturn \"C\" + super.tag()\nend\nend\nset c to new C()\nsay c.tag()\n~\nkind Base\nto init with self v\nset self.v to v\nreturn 0\nend\nto show with self\nreturn self.v\nend\nend\nkind Sub extends Base\nto show with self\nreturn super.show() * 2\nend\nend\nset s to new Sub()\ns.init(21)\nsay s.show()\n~\nset a to \"ab\" + \"c\"\nset b to \"a\" + \"bc\"\nsay a is b\nsay a is not b\nsay a is \"xyz\"\nsay a is not \"xyz\"", "
~
")
set fp_sigs to split("10:263985:0:0,22:818617:0:0,22:543427:0:0,22:723254:0:0,34:662544:0:0,28:231572:0:0,14:833787:0:0,33:511701:0:0,44:474778:0:0,27:678215:0:0,28:124569:0:0,28:428094:0:0,28:501857:0:0,28:375364:0:0,34:26598:0:0,37:198998:0:0,37:258421:0:0,44:710921:0:0,52:895917:0:0,21:155982:0:0,36:936693:0:0,46:608579:0:0,43:701291:0:0,51:198425:0:0,53:622966:0:0,60:77290:0:0,43:609007:0:0,16:977375:0:0,8:430016:9:685763,12:156265:14:315859,20:922441:16:549987,18:741580:0:0,28:34516:5:368693,56:548126:0:0,38:92309:0:0,61:66338:0:0,72:535763:0:0,13:906090:4:996153,39:251529:8:879595,21:430842:0:0,39:521529:0:0,19:918300:9:685763,34:733384:14:78282,63:311430:0:0,105:889480:0:0,112:562638:0:0,66:225877:0:0,63:946612:0:0,97:743360:0:0,45:661657:10:477163,37:99684:32:685060,32:80794:5:368723,71:726224:10:477163,67:400453:20:909756,32:212839:10:477187,82:523916:15:457687,40:876578:5:368716,29:395080:13:502581,63:930183:6:649818,23:687685:29:596030,41:256542:37:139406,52:70377:14:169488,27:411974:38:322448,52:999962:6:650212,59:773961:0:0,37:131886:0:0,28:112782:18:969281,24:631476:0:0,36:733718:10:468479,37:413534:8:841870,25:267624:15:817563,36:612581:0:0,47:237182:0:0,88:780460:0:0,38:202528:0:0,44:829617:0:0,56:743648:0:0,55:572035:0:0,88:715876:19:862860,116:855937:25:885272,45:976001:24:113704,142:607927:13:481259,78:581091:14:241885,80:392649:41:697279,69:120963:44:742465,99:29789:52:671921,129:519628:57:269840,50:708349:29:276505", ",")
set fp_total to length(fp_srcs)

set matched to 0
set ci to 0
while ci < fp_total
  set src to fp_srcs[ci]
  set exp_sig to fp_sigs[ci]

  # Full inline lexer from compile-self.mjs (supports floats, escapes, comments)
  set tk_count to 0
  set _srclen to length(src)
  set _i to 0
  while _i < _srclen
    set _c to ord(src, _i)
    if _c is 32
      set _i to _i + 1
    else
      if _c is 9
        set _i to _i + 1
      else
        if _c is 13
          set _i to _i + 1
        else
          if _c is 10
            set tk_kind[tk_count] to 5
            set tk_count to tk_count + 1
            set _i to _i + 1
          else
            if _c is 35
              set _going to 1
              while _going
                if _i >= _srclen
                  set _going to 0
                else
                  if ord(src, _i) is 10
                    set _going to 0
                  else
                    set _i to _i + 1
                  end
                end
              end
            else
              if is_digit(_c)
                set _j to _i
                set _going to 1
                while _going
                  if _j >= _srclen
                    set _going to 0
                  else
                    if is_digit(ord(src, _j))
                      set _j to _j + 1
                    else
                      set _going to 0
                    end
                  end
                end
                set _v to 0
                set _k to _i
                while _k < _j
                  set _v to _v * 10 + ord(src, _k) - 48
                  set _k to _k + 1
                end
                set _scale to 0
                set _isf to 0
                if _j < _srclen
                  if ord(src, _j) is 46
                    if _j + 1 < _srclen
                      if is_digit(ord(src, _j + 1))
                        set _isf to 1
                        set _j to _j + 1
                        set _going to 1
                        while _going
                          if _j >= _srclen
                            set _going to 0
                          else
                            if is_digit(ord(src, _j))
                              set _v to _v * 10 + ord(src, _j) - 48
                              set _scale to _scale + 1
                              set _j to _j + 1
                            else
                              set _going to 0
                            end
                          end
                        end
                      end
                    end
                  end
                end
                if _isf is 1
                  set tk_kind[tk_count] to 6
                else
                  set tk_kind[tk_count] to 1
                end
                set tk_num[tk_count] to _v
                set tk_num2[tk_count] to _scale
                set tk_count to tk_count + 1
                set _i to _j
              else
                if _c is 34
                  set _j to _i + 1
                  set _sbuf to ""
                  set _collecting to 1
                  while _collecting
                    if _j >= _srclen
                      set _collecting to 0
                    else
                      set _q to ord(src, _j)
                      if _q is 34
                        set _collecting to 0
                      else
                        if _q is 92
                          if _j + 1 < _srclen
                            set _e to ord(src, _j + 1)
                            if _e is 110
                              set _sbuf to concat(_sbuf, chr(10))
                            else
                              if _e is 116
                                set _sbuf to concat(_sbuf, chr(9))
                              else
                                set _sbuf to concat(_sbuf, chr(_e))
                              end
                            end
                            set _j to _j + 2
                          else
                            set _sbuf to concat(_sbuf, chr(_q))
                            set _j to _j + 1
                          end
                        else
                          set _sbuf to concat(_sbuf, chr(_q))
                          set _j to _j + 1
                        end
                      end
                    end
                  end
                  set tk_kind[tk_count] to 3
                  set tk_txt[tk_count] to _sbuf
                  set tk_count to tk_count + 1
                  set _i to _j + 1
                else
                  if is_alpha(_c)
                    set _j to _i
                    set _going to 1
                    while _going
                      if _j >= _srclen
                        set _going to 0
                      else
                        if is_alnum(ord(src, _j))
                          set _j to _j + 1
                        else
                          set _going to 0
                        end
                      end
                    end
                    set tk_kind[tk_count] to 2
                    set tk_txt[tk_count] to slice(src, _i, _j)
                    set tk_count to tk_count + 1
                    set _i to _j
                  else
                    set _tok to _c
                    if _c is 60
                      if _i + 1 < _srclen
                        if ord(src, _i + 1) is 61
                          set _tok to 300
                          set _i to _i + 1
                        end
                      end
                    end
                    if _c is 62
                      if _i + 1 < _srclen
                        if ord(src, _i + 1) is 61
                          set _tok to 301
                          set _i to _i + 1
                        end
                      end
                    end
                    set tk_kind[tk_count] to 4
                    set tk_num[tk_count] to _tok
                    set tk_count to tk_count + 1
                    set _i to _i + 1
                  end
                end
              end
            end
          end
        end
      end
    end
  end

  set bc[0] to 0
  set sym_names[0] to 0
  set sym_types[0] to 0
  set loc_names[0] to 0
  set loc_types[0] to 0
  set fn_names[0] to 0
  set fn_offsets[0] to 0
  set fn_arities[0] to 0
  set fn_ret_types[0] to 0
  set fn_extras[0] to 0
  set fn_body_start[0] to 0
  set lam_names[0] to 0
  set lam_caps[0] to 0
  set lsav_names[0] to 0
  set lsav_types[0] to 0
  set cur_fn[0] to 0
  set pend_names[0] to 0
  set pend_pos[0] to 0
  set in_func[0] to 0
  set expr_type[0] to 0
  set scratch[0] to 0
  set emit_enabled[0] to 0
  set skip_fn_defs[0] to 0
  set pool_bytes[0] to 0
  set pool_keys[0] to 0
  set pool_offs[0] to 0
  set brk_pos[0] to 0
  set brk_dep[0] to 0
  set cnt_pos[0] to 0
  set cnt_dep[0] to 0
  set loop_depth[0] to 0
  set fe_depth[0] to 0
  set cls_names[0] to 0
  set mth_cls[0] to 0
  set mth_key[0] to 0
  set mth_fn[0] to 0
  set mth_sup[0] to 0
  set last_id[0] to ""

  desugar_kinds()

  set emit_enabled[0] to 0
  set skip_fn_defs[0] to 0
  set _iter to 0
  while _iter < 2
    set pos to 0
    set sym_names[0] to 0
    set sym_types[0] to 0
    set going to 1
    while going
      set new_pos to parse_stmt(pos)
      if new_pos is pos
        set going to 0
      else
        set pos to new_pos
      end
      if pos >= tk_count
        set going to 0
      end
    end
    set _iter to _iter + 1
  end

  set sym_names[0] to 0
  set sym_types[0] to 0
  set pend_names[0] to 0
  set pend_pos[0] to 0
  set bc[0] to 0
  set emit_enabled[0] to 1

  emit_byte(64)
  set _jmp_main to placeholder16()

  set _i to 1
  set _fstop to fn_names[0] + 1
  while _i < _fstop
    set fn_offsets[_i] to bc[0]
    set loc_names[0] to 0
    set loc_types[0] to 0
    set pos to fn_body_start[_i]
    set pos to parse_params(pos)
    set _extras to fn_extras[_i]
    if _extras > 0
      emit_byte(98)
      emit_byte(_extras)
    end
    set cur_fn[0] to _i
    set _ppos to pos
    set _psyms to sym_names[0]
    set emit_enabled[0] to 0
    set in_func[0] to 1
    set _pend to parse_block(pos)
    set emit_enabled[0] to 1
    set sym_names[0] to _psyms
    set sym_types[0] to _psyms
    set pos to _ppos
    set in_func[0] to 1
    set pos to parse_block(pos)
    emit_byte(1)
    emit_i32(0)
    emit_byte(97)
    set in_func[0] to 0
    set cur_fn[0] to 0
    set _i to _i + 1
  end

  patch_i16(_jmp_main, bc[0])

  set skip_fn_defs[0] to 1
  set pos to 0
  set going to 1
  while going
    set new_pos to parse_stmt(pos)
    if new_pos is pos
      set going to 0
    else
      set pos to new_pos
    end
    if pos >= tk_count
      set going to 0
    end
  end
  emit_byte(255)
  resolve_pending_calls()

  set bch to bc[0]
  set k to 1
  while k <= bc[0]
    set bch to (bch * 131 + bc[k]) % 1000003
    set k to k + 1
  end
  set plh to pool_bytes[0]
  set k to 1
  while k <= pool_bytes[0]
    set plh to (plh * 131 + pool_bytes[k]) % 1000003
    set k to k + 1
  end
  set got_sig to concat(str(bc[0]), concat(":", concat(str(bch), concat(":", concat(str(pool_bytes[0]), concat(":", str(plh)))))))
  if got_sig is exp_sig
    set matched to matched + 1
  else
    set _ to check(concat("case ", str(ci)), 0)
    say concat("   expected sig: ", exp_sig)
    say concat("   got sig     : ", got_sig)
  end

  set ci to ci + 1
end

set _ to check(concat("shim fixed-point: ", concat(str(matched), concat("/", concat(str(fp_total), " cases byte-identical")))), matched is fp_total)

# Direct runtime verification of Milestone A string equality on dynamic strings
set dyn_a to "he" + "llo"
set dyn_b to "hel" + "lo"
set dyn_c to "world"
set _ to check("dynamic string is equality", (dyn_a is dyn_b) is 1)
set _ to check("dynamic string is inequality", (dyn_a is dyn_c) is 0)
set _ to check("dynamic string is not equality", (dyn_a is not dyn_b) is 0)
set _ to check("dynamic string is not inequality", (dyn_a is not dyn_c) is 1)

set self_out to read_file("sdev:compile:self:scripts/test-shim-fixed-point.sdev")
set boot_out to read_file("sdev:compile:boot:scripts/test-shim-fixed-point.sdev")
set _ to check("test-shim-fixed-point.sdev byte-identical through shim and bootstrap", self_out is boot_out)

set _ to tk_report("shim fixed-point")
