# Parser rules for words and strings that must stay as written — authored in SDEV.
#
#   node bin/sdevhost.mjs scripts/test-parser-literals.sdev

use "lang/stdlib/testkit.sdev"

to run_snippet with code
  set p to ".tmp_snippet.sdev"
  set _ to write_file(p, code)
  set res to shell(concat("node bin/sdev.mjs run --no-agent ", p))
  set nl to find(res, "\n")
  set code_str to substr(res, 0, nl)
  set out to substr(res, nl + 1, length(res) - (nl + 1))
  set r to mklist(2)
  set r[0] to code_str
  set r[1] to trim(out)
  return r
end

# 1. val and const stay usable as ordinary names
set r1 to run_snippet("forge val be 3\nspeak(val + 1)")
set ok1 to 0
if r1[0] is "0"
  if r1[1] is "4"
    set ok1 to 1
  end
end
set _ to check("val as a variable name", ok1)

set r2 to run_snippet("forge const be 7\nspeak(const)")
set ok2 to 0
if r2[0] is "0"
  if r2[1] is "7"
    set ok2 to 1
  end
end
set _ to check("const as a variable name", ok2)

set r3 to run_snippet("conjure f(st, name, val) ::\n  yield val * 2\n;;\nspeak(f(1, 2, 5))")
set ok3 to 0
if r3[0] is "0"
  if r3[1] is "10"
    set ok3 to 1
  end
end
set _ to check("val as a parameter name", ok3)

set r4 to run_snippet("forge val be 1\nval be 5\nspeak(val)")
set ok4 to 0
if r4[0] is "0"
  if r4[1] is "5"
    set ok4 to 1
  end
end
set _ to check("val be 5 is an assignment", ok4)

# 2. fixed declares a constant that cannot be reassigned
set r5 to run_snippet("fixed limit be 10\nspeak(limit)")
set _ to check("fixed declares a constant", r5[0] is "0" and r5[1] is "10")

set r6 to run_snippet("fixed limit be 10\nlimit be 11")
set _ to check("fixed constant cannot be reassigned", r6[0] is not "0")

# 3. Plain strings keep their braces literally; only f"..." interpolates
set r7 to run_snippet("speak('{\"a\": 1}')")
set ok7 to 0
if r7[0] is "0"
  if r7[1] is "{\"a\": 1}"
    set ok7 to 1
  end
end
set _ to check("JSON text stays literal", ok7)

set r8 to run_snippet("speak(\"\\\\d{3}\")")
set ok8 to 0
if r8[0] is "0"
  if r8[1] is "\\d{3}"
    set ok8 to 1
  end
end
set _ to check("regex quantifier stays literal", ok8)

set r9 to run_snippet("speak(\"\\\\p{L}\")")
set ok9 to 0
if r9[0] is "0"
  if r9[1] is "\\p{L}"
    set ok9 to 1
  end
end
set _ to check("\\p{L} stays literal", ok9)

set r10 to run_snippet("speak(\"{{x}}\")")
set ok10 to 0
if r10[0] is "0"
  if r10[1] is "{{x}}"
    set ok10 to 1
  end
end
set _ to check("doubled braces stay doubled", ok10)

set q to chr(34)
set snippet11 to concat("forge n be 4\nspeak(f", concat(q, concat("n={n}", concat(q, ")"))))
set r11 to run_snippet(snippet11)
set ok11 to 0
if r11[0] is "0"
  if r11[1] is "n=4"
    set ok11 to 1
  end
end
set _ to check("f-strings still interpolate", ok11)

# Cleanup scratch
set _ to write_file(".tmp_snippet.sdev", "")

set _ to tk_report("parser literals suite")
