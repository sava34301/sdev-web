# ==============================================================================
# SDEV Environment Configuration Template (.env.example)
# ==============================================================================

# --- Supabase Database & Auth (Required for Web App) ---
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key-here"
VITE_SUPABASE_PROJECT_ID="your-project-id-here"

# --- Local Agent AI Brain (Optional: User's Own Machine) ---
# SDEV_AGENT_LOCAL_URL="http://127.0.0.1:1234/v1"
# SDEV_AGENT_LOCAL_MODEL="qwen2.5-coder-1.5b-instruct"
# SDEV_AGENT_ONLINE="0"

# --- Server-Side AI Gateway (Optional: Supabase Edge Functions) ---
# SDEV_AI_API_KEY="sk-..."
# SDEV_AI_BASE_URL="https://api.openai.com/v1"
# SDEV_AI_MODEL="gpt-4o-mini"
# SDEV_AI_REASONING="low"
# SDEV_AI_DISABLE_LEGACY="0"

# --- Cloud Hardware Compilation (Optional) ---
# ARDUINO_BUILD_URL="https://compiler.yourdomain.com"
# ARDUINO_BUILD_KEY="secret-key"
